<?php
/**
 * A library vocabulary's classes and properties, with a filter, for the
 * details sidebar's "Classes and properties" tab, which loads them.
 *
 * Publisher text arrives as plain text: the controller cleans the term labels
 * and comments.
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$terms = [
    ['label' => $translate('Classes'), 'members' => $classes],
    ['label' => $translate('Properties'), 'members' => $properties],
];
?>
<?php if ($classes || $properties): ?>
<?php // Filled in by the script, and from a term search's "All matching terms". ?>
<div class="vocabulary-library-term-filter">
    <input type="text" value="<?php echo $escape($termFilter); ?>"
        placeholder="<?php echo $escape($translate('Filter classes and properties')); ?>"
        aria-label="<?php echo $escape($translate('Filter classes and properties')); ?>">
    <p class="vocabulary-library-term-filter-empty" hidden><?php echo $translate('No classes or properties match.'); ?></p>
    <?php // How many match, read out once the admin pauses; filled in by the script. ?>
    <p class="vocabulary-library-announcement vocabulary-library-term-filter-status" aria-live="polite" aria-atomic="true"></p>
</div>
<?php endif; ?>

<?php foreach ($terms as $group): ?>
<?php $heading = sprintf('<h4 data-label="%s">%s</h4>', $escape($group['label']), $escape(sprintf('%s (%s)', $group['label'], count($group['members'])))); ?>
<?php if (!$group['members']): ?>
<?php // None to list, so a heading alone, with nothing to expand. ?>
<div class="meta-group vocabulary-library-terms"><?php echo $heading; ?></div>
<?php else: ?>
<div class="meta-group vocabulary-library-terms">
    <a href="#" class="expand" aria-expanded="false"><?php echo $heading; ?></a>
    <div class="collapsible">
        <?php foreach ($group['members'] as $localName => $member): ?>
        <div class="value">
            <span class="vocabulary-library-term-label"><?php echo $escape($member['label']); ?></span>
            <span class="field-term"><?php echo $escape($entry['prefix'] . ':' . $localName); ?></span>
            <?php if ($member['comment'] !== null && trim($member['comment']) !== ''): ?>
            <span class="vocabulary-library-term-comment"><?php echo $escape($member['comment']); ?></span>
            <?php endif; ?>
        </div>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>
<?php endforeach; ?>
