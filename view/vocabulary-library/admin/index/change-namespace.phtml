<?php
// The confirmation for changing a namespace, in a sidebar over the details,
// as core confirms a deletion: why and what changing it does, then which
// vocabulary and the namespace from and to, each on its own line since they
// can differ by one character. Closing it cancels and leaves the details as
// they were. The script adds the library's state to the form, as to the links
// that leave the library.
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$vocabulary = $installed['vocabulary'];
$form->setAttribute('class', 'vocabulary-library-keep-place');
$form->setButtonLabel('Confirm change'); // @translate
// As the sidebar's other buttons, such as Change namespace, which opened it.
$form->get('submit')->setAttribute('class', 'button');
?>
<?php // Not core's #sidebar-confirm, which colors its button as for a delete: this deletes nothing. ?>
<div class="vocabulary-library-change-namespace">
    <h3 class="vocabulary-library-confirm-title" tabindex="-1"><?php echo $translate('Change namespace'); ?></h3>
    <?php // Why, in the details' own words, and what it does, under the heading as in core's confirmations; the namespaces below show the difference. It deletes nothing, so it isn't styled as a warning. ?>
    <p><?php echo $escape($translate('Omeka\'s vocabulary has a slightly different namespace, so the library can\'t compare it. Changing the namespace gives the vocabulary\'s classes and properties new addresses everywhere Omeka publishes them. Nothing is deleted, and values stay attached to their properties.')); ?></p>
    <div class="meta-group">
        <h4><?php echo $translate('Omeka\'s vocabulary'); ?></h4>
        <?php // As core writes a vocabulary in its selectors: label (prefix). ?>
        <div class="value"><?php echo $this->hyperlink(sprintf('%s (%s)', $vocabulary->label(), $vocabulary->prefix()), $installed['url']); ?></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('From'); ?></h4>
        <div class="value"><span class="vocabulary-library-namespace"><?php echo $escape($vocabulary->namespaceUri()); ?></span></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('To'); ?></h4>
        <div class="value"><span class="vocabulary-library-namespace"><?php echo $escape($entry['namespace']); ?></span></div>
    </div>
    <?php echo $this->form($form); ?>
</div>
