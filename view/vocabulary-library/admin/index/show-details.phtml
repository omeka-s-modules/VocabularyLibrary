<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
// Publisher text arrives as plain text: the build cleans the description and
// license, and the controller the term labels and comments.
$license = $entry['license'];
$terms = [
    ['label' => $translate('Classes'), 'members' => $classes],
    ['label' => $translate('Properties'), 'members' => $properties],
];
$file = basename($entry['file']);
?>
<h3 class="o-title vocabulary-library-details-title" tabindex="-1"><?php echo $escape($entry['title']); ?></h3>

<div class="meta-group">
    <h4><?php echo $translate('Status'); ?></h4>
    <div class="value"><?php echo $this->partial('common/vocabulary-library-status', ['slug' => $slug, 'installed' => $installed, 'prefixTakenBy' => $prefixTakenBy, 'long' => true]); ?></div>
</div>
<?php if ($installed): ?>
<div class="meta-group">
    <h4><?php echo $translate('Vocabulary in Omeka'); ?></h4>
    <?php // As core writes a vocabulary in its selectors: label (prefix). ?>
    <div class="value"><?php echo $this->hyperlink(sprintf('%s (%s)', $installed['vocabulary']->label(), $installed['vocabulary']->prefix()), $installed['url']); ?></div>
</div>
<?php endif; ?>
<?php if ($excerpt !== null): ?>
<div class="meta-group">
    <h4><?php echo $translate('Description'); ?></h4>
    <div class="value">
        <?php echo $escape($excerpt); ?>
        <?php if ($rest): ?>
        <div class="vocabulary-library-more">
            <a href="#" class="expand" aria-expanded="false"><?php echo $translate('Full description'); ?></a>
            <div class="collapsible">
                <?php foreach ($rest as $paragraph): ?>
                <p><?php echo $escape($paragraph); ?></p>
                <?php endforeach; ?>
            </div>
        </div>
        <?php endif; ?>
    </div>
</div>
<?php endif; ?>
<div class="meta-group">
    <h4><?php echo $translate('Namespace URI'); ?></h4>
    <div class="value"><?php echo $escape($entry['namespace']); ?></div>
</div>
<div class="meta-group">
    <h4><?php echo $translate('Namespace prefix'); ?></h4>
    <div class="value"><?php echo $escape($entry['prefix']); ?></div>
</div>
<div class="meta-group">
    <h4><?php echo $translate('Tags'); ?></h4>
    <?php foreach ($tags as $tag => $label): ?>
    <div class="value"><?php echo $this->hyperlink($translate($label), $this->url('admin/vocabulary-library', [], ['query' => ['tag' => $tag]]), ['class' => 'vocabulary-library-tag', 'data-tag' => $tag]); ?></div>
    <?php endforeach; ?>
</div>
<div class="meta-group">
    <h4><?php echo $translate('License'); ?></h4>
    <div class="value">
        <?php if ($license === null): ?>
        <?php echo $translate('Not stated in the file'); ?>
        <?php elseif (preg_match('#^https?://\S+$#i', $license)): ?>
        <?php echo $this->hyperlink($license, $license, ['target' => '_blank']); ?>
        <?php else: ?>
        <?php echo $escape($license); ?>
        <?php endif; ?>
    </div>
</div>
<div class="meta-group">
    <h4><?php echo $translate('File'); ?></h4>
    <div class="value"><?php echo $this->hyperlink($file, $this->url('admin/vocabulary-library', ['action' => 'file', 'slug' => $slug]), ['title' => $translate('Download file')]); ?></div>
</div>

<?php foreach ($terms as $group): ?>
<?php if ($group['members']): ?>
<div class="meta-group vocabulary-library-terms">
    <a href="#" class="expand" aria-expanded="false"><h4><?php echo $escape(sprintf('%s (%s)', $group['label'], count($group['members']))); ?></h4></a>
    <div class="collapsible">
        <?php foreach ($group['members'] as $localName => $member): ?>
        <div class="value">
            <span class="vocabulary-library-term-label"><?php echo $escape($member['label']); ?></span>
            <span class="field-term"><?php echo $escape($entry['prefix'] . ':' . $localName); ?></span>
            <?php if ($member['comment'] !== null && trim($member['comment']) !== ''): ?>
            <span class="vocabulary-library-term-comment"><?php echo $escape($member['comment']); ?></span>
            <?php endif; ?>
        </div>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>
<?php endforeach; ?>
