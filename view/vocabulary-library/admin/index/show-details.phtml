<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
// Publisher text arrives as plain text: the build cleans the description and
// license.
$license = $entry['license'];
$file = basename($entry['file']);
// Every section shows for every vocabulary, so sidebars keep one structure:
// what the file lacks says so, styled apart from values, as the compare page
// marks "None". Only "Omeka's vocabulary" shows for some vocabularies and
// not others: it reports the site's state rather than the file.
$notProvided = sprintf('<span class="vocabulary-library-none">%s</span>', $escape($translate('Not provided by the publisher')));
?>
<h3 class="o-title vocabulary-library-details-title" tabindex="-1"><?php echo $escape($entry['name']); ?></h3>

<?php
// Core's sidebar tabs, as in its item selector, directly under the name, so
// the details and the long class and property lists take turns rather than
// one burying the other.
?>
<?php echo $this->sidebarSectionNav([
    'vocabulary-library-details' => $translate('Details'),
    'vocabulary-library-term-lists' => $translate('Classes and properties'),
], $escape($entry['name'])); ?>

<div class="sidebar-section active" id="vocabulary-library-details" role="tabpanel" aria-labelledby="vocabulary-library-details-label">
    <div class="meta-group">
        <h4><?php echo $translate('Status'); ?></h4>
        <div class="value"><?php echo $this->partial('common/vocabulary-library-status', ['slug' => $slug, 'installed' => $installed, 'prefixTakenBy' => $prefixTakenBy, 'long' => true, 'namespace' => $entry['namespace']]); ?></div>
    </div>
    <?php if ($installed): ?>
    <div class="meta-group">
        <h4><?php echo $translate('Omeka\'s vocabulary'); ?></h4>
        <?php // As core writes a vocabulary in its selectors: label (prefix). ?>
        <div class="value"><?php echo $this->hyperlink(sprintf('%s (%s)', $installed['vocabulary']->label(), $installed['vocabulary']->prefix()), $installed['url']); ?></div>
    </div>
    <?php endif; ?>
    <div class="meta-group">
        <h4><?php echo $translate('Title'); ?></h4>
        <div class="value"><?php echo $entry['title'] === null ? $notProvided : $escape($entry['title']); ?></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Summary'); ?></h4>
        <?php // Written in English, whatever the admin's language. ?>
        <div class="value" lang="en"><?php echo $escape($entry['summary']); ?></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Description'); ?></h4>
        <div class="value">
            <?php if ($excerpt === null): ?>
            <?php echo $notProvided; ?>
            <?php else: ?>
            <?php echo $escape($excerpt); ?>
            <?php endif; ?>
            <?php if ($rest): ?>
            <div class="vocabulary-library-more">
                <a href="#" class="expand" aria-expanded="false"><?php echo $translate('Full description'); ?></a>
                <div class="collapsible">
                    <?php foreach ($rest as $paragraph): ?>
                    <p><?php echo $escape($paragraph); ?></p>
                    <?php endforeach; ?>
                </div>
            </div>
            <?php endif; ?>
        </div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Namespace URI'); ?></h4>
        <div class="value"><?php echo $escape($entry['namespace']); ?></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Namespace prefix'); ?></h4>
        <div class="value"><?php echo $escape($entry['prefix']); ?></div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Tags'); ?></h4>
        <?php foreach ($tagLabels as $tag => $label): ?>
        <div class="value"><?php echo $this->hyperlink($label, $this->url('admin/vocabulary-library', [], ['query' => ['tag' => $tag]]), ['class' => 'vocabulary-library-tag', 'data-tag' => $tag]); ?></div>
        <?php endforeach; ?>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('Label languages'); ?></h4>
        <?php if (!$languageNames): ?>
        <div class="value"><?php echo $notProvided; ?></div>
        <?php endif; ?>
        <?php foreach ($languageNames as $name): ?>
        <div class="value"><?php echo $escape($name); ?></div>
        <?php endforeach; ?>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('License'); ?></h4>
        <div class="value">
            <?php if ($license === null): ?>
            <?php echo $notProvided; ?>
            <?php elseif (preg_match('#^https?://\S+$#i', $license)): ?>
            <?php // Written out, for the note inside the link, where a screen reader reads it with the link. ?>
            <a href="<?php echo $escape($license); ?>" target="_blank"><?php echo $escape($license); ?> <span class="vocabulary-library-sr-only"><?php echo $translate('(opens in a new tab)'); ?></span></a>
            <?php else: ?>
            <?php echo $escape($license); ?>
            <?php endif; ?>
        </div>
    </div>
    <div class="meta-group">
        <h4><?php echo $translate('File'); ?></h4>
        <div class="value"><?php echo $this->hyperlink($file, $this->url('admin/vocabulary-library', ['action' => 'file', 'slug' => $slug]), ['title' => $translate('Download file')]); ?></div>
    </div>
</div>

<?php
// The class and property lists come from the vocabulary's file, which for a
// large vocabulary takes a moment to read, so the script loads them
// (show-terms) when this tab is first shown, or at once when the sidebar
// opens from a term search's matches. The details need nothing from the file.
?>
<div class="sidebar-section" id="vocabulary-library-term-lists" role="tabpanel" aria-labelledby="vocabulary-library-term-lists-label"
    data-terms-url="<?php echo $escape($this->url('admin/vocabulary-library', ['action' => 'show-terms', 'slug' => $slug], $termFilter === '' ? [] : ['query' => ['filter' => $termFilter]])); ?>"
    data-filter="<?php echo $escape($termFilter); ?>">
    <p class="vocabulary-library-terms-loading"><?php echo $translate('Loading classes and properties…'); ?></p>
    <div class="vocabulary-library-terms-failed" hidden>
        <p class="error"><?php echo $translate('Could not load classes and properties.'); ?></p>
        <button type="button" class="vocabulary-library-terms-retry"><?php echo $translate('Try again'); ?></button>
    </div>
</div>
