<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/vocabulary-library.css', 'VocabularyLibrary'));
$this->htmlElement('body')->appendAttribute('class', 'vocabulary-library compare');
$browseUrl = $this->url('admin/vocabulary-library');
$prefix = $vocabulary->prefix();

// A term as the site writes it.
$term = function ($localName) use ($prefix, $escape) {
    return $escape($prefix . ':' . $localName);
};
// A value as it would be stored: escaped, with its whitespace, and marked
// when empty.
$none = sprintf('<span class="vocabulary-library-none">%s</span>', $translate('None'));
$value = function ($value) use ($none, $escape) {
    if ($value === null || $value === '') {
        return $none;
    }
    return sprintf('<span class="vocabulary-library-value">%s</span>', $escape($value));
};
// A kind's changed terms, as core's update page lists them: each term, with
// whether its label or comment changed, from what, to what. In alphabetical
// order of term, so a term's changes are together.
$changed = function (array $diff) use ($term, $value, $translate, $escape, $collation) {
    $types = ['label' => $escape($translate('Label')), 'comment' => $escape($translate('Comment'))];
    $localNames = array_keys($diff['label'] + $diff['comment']);
    usort($localNames, [$collation, 'compare']);
    $rows = [];
    foreach ($localNames as $localName) {
        foreach ($types as $type => $name) {
            if (isset($diff[$type][$localName])) {
                [$from, $to] = $diff[$type][$localName];
                $rows[] = [$term($localName), $name, $value($from), $value($to)];
            }
        }
    }
    return $rows;
};
// Terms with their values, in alphabetical order of term.
$listed = function (array $members) use ($term, $value, $collation) {
    uksort($members, [$collation, 'compare']);
    $rows = [];
    foreach ($members as $localName => $values) {
        $rows[] = array_merge([$term($localName)], array_map($value, (array) $values));
    }
    return $rows;
};
// Each section: its id, its heading, its columns, its rows of rendered
// cells, and any note and table class. Properties come before classes, as on core's
// update page. A changed term's label and comment are rows of their own.
$changeColumns = [$translate('Term'), $translate('Type'), $translate('From'), $translate('To')];
$newColumns = [$translate('Term'), $translate('Label'), $translate('Comment')];
$sections = [
    ['id' => 'vocabulary-library-changed-properties', 'heading' => $translate('Changed properties'), 'columns' => $changeColumns, 'rows' => $changed($diff['properties']), 'class' => 'vocabulary-library-change-table'],
    ['id' => 'vocabulary-library-changed-classes', 'heading' => $translate('Changed classes'), 'columns' => $changeColumns, 'rows' => $changed($diff['classes']), 'class' => 'vocabulary-library-change-table'],
    ['id' => 'vocabulary-library-new-properties', 'heading' => $translate('New properties'), 'columns' => $newColumns, 'rows' => $listed($diff['properties']['new'])],
    ['id' => 'vocabulary-library-new-classes', 'heading' => $translate('New classes'), 'columns' => $newColumns, 'rows' => $listed($diff['classes']['new'])],
];
$changes = array_sum(array_map('count', array_column($sections, 'rows')));
// Terms Omeka's vocabulary has and the library's doesn't come last, with a
// note.
// They aren't changes: updating keeps them.
$onlyInOmeka = $translate('Omeka\'s vocabulary has these and the library\'s doesn\'t. Updating doesn\'t remove them.');
$sections[] = ['id' => 'vocabulary-library-properties-only-in-omeka', 'heading' => $translate('Properties only in Omeka'), 'columns' => [$translate('Term'), $translate('Label')], 'rows' => $listed($missing['properties']), 'note' => $onlyInOmeka];
$sections[] = ['id' => 'vocabulary-library-classes-only-in-omeka', 'heading' => $translate('Classes only in Omeka'), 'columns' => [$translate('Term'), $translate('Label')], 'rows' => $listed($missing['classes']), 'note' => $onlyInOmeka];
?>

<?php echo $this->pageTitle($entry['name'], 1, $translate('Vocabulary Library'), $translate('Compare and update')); ?>

<?php // Only the actions and hidden inputs, so the form of reading options can't nest in it. ?>
<?php $form->prepare(); ?>
<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <?php if ($changes): ?>
    <?php echo $this->hyperlink($translate('Cancel'), $browseUrl, ['class' => 'button']); ?>
    <button type="submit"><?php echo $translate('Update'); ?></button>
    <?php else: ?>
    <?php echo $this->hyperlink($translate('Back to the library'), $browseUrl, ['class' => 'button']); ?>
    <?php endif; ?>
</div>
<?php echo $this->formHidden($form->get($form->getName() . '_csrf')); ?>
<input type="hidden" name="lang" value="<?php echo $escape((string) $lang); ?>">
<?php if ($commentReading !== null): ?>
<input type="hidden" name="comments" value="<?php echo $escape($commentReading); ?>">
<?php endif; ?>
<?php echo $this->form()->closeTag(); ?>

<?php
// How to read the file, where there's a choice: its language, and where
// terms' comments come from (null when both ways read the same).
?>
<?php if (count($entry['languages']) > 1 || $commentReading !== null): ?>
<form method="get" class="vocabulary-library-reading">
    <?php if (count($entry['languages']) > 1): ?>
    <div class="field">
        <div class="field-meta">
            <label for="vocabulary-library-lang"><?php echo $translate('Preferred language'); ?></label>
            <div class="field-description"><?php echo $translate('Selected to match Omeka\'s vocabulary. Choose another to see what switching to it would change.'); ?></div>
        </div>
        <div class="inputs">
            <select name="lang" id="vocabulary-library-lang">
                <option value=""<?php echo $lang === null ? ' selected' : ''; ?>><?php echo $translate('First available'); ?></option>
                <?php foreach ($languageOptions as $code => $label): ?>
                <option value="<?php echo $escape($code); ?>"<?php echo $lang === $code ? ' selected' : ''; ?>><?php echo $escape($label); ?></option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <?php if ($commentReading !== null): ?>
    <div class="field">
        <div class="field-meta">
            <label for="vocabulary-library-comments"><?php echo $translate('Comment source'); ?></label>
            <div class="field-description"><?php echo $translate('Selected to match Omeka\'s vocabulary. Choose the other to see what switching to it would change.'); ?></div>
        </div>
        <div class="inputs">
            <select name="comments" id="vocabulary-library-comments">
                <option value="definitions"<?php echo $commentReading === 'definitions' ? ' selected' : ''; ?>><?php echo $translate('Definitions, or comments where there are none (as the library imports)'); ?></option>
                <option value="comments"<?php echo $commentReading === 'comments' ? ' selected' : ''; ?>><?php echo $translate('Comments only (as Omeka\'s own import does)'); ?></option>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <div class="vocabulary-library-reading-actions">
        <button type="submit"><?php echo $translate('Compare'); ?></button>
    </div>
</form>
<?php endif; ?>

<?php if ($changes): ?>
<p><?php echo $translate('Updating changes the labels and comments below to match the library\'s vocabulary, and adds any new classes and properties. It removes nothing.'); ?></p>
<?php else: ?>
<p><?php echo $translate('Omeka\'s vocabulary already matches the library\'s.'); ?></p>
<?php endif; ?>

<?php
// The sections that have rows, each headed with how many terms it has, which
// in the changed sections can have two rows each.
$sections = array_filter($sections, function ($section) {
    return (bool) $section['rows'];
});
foreach ($sections as &$section) {
    $section['heading'] = sprintf('%s (%s)', $section['heading'], count(array_unique(array_column($section['rows'], 0))));
}
unset($section);
?>
<?php // What is below, where there is more than one section: a long one hides those after it. ?>
<?php if (count($sections) > 1): ?>
<nav class="vocabulary-library-compare-summary" aria-label="<?php echo $escape($translate('Sections')); ?>">
    <ul>
        <?php foreach ($sections as $section): ?>
        <li><a href="#<?php echo $section['id']; ?>"><?php echo $escape($section['heading']); ?></a></li>
        <?php endforeach; ?>
    </ul>
</nav>
<?php endif; ?>

<?php foreach ($sections as $section): ?>
<h2 id="<?php echo $section['id']; ?>" tabindex="-1"><?php echo $escape($section['heading']); ?></h2>
<?php if (isset($section['note'])): ?>
<p><?php echo $section['note']; ?></p>
<?php endif; ?>
<table class="tablesaw vocabulary-library-compare-table <?php echo $section['class'] ?? ''; ?>" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <?php foreach ($section['columns'] as $column): ?>
            <th><?php echo $escape($column); ?></th>
            <?php endforeach; ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($section['rows'] as $row): ?>
        <tr>
            <?php foreach ($row as $cell): ?>
            <td><?php echo $cell; ?></td>
            <?php endforeach; ?>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endforeach; ?>
