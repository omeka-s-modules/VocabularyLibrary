    <button type="submit"><?php echo $translate('Update'); ?></button>
    <?php else: ?>
    <?php echo $this->hyperlink($translate('Back to the library'), $browseUrl, ['class' => 'button']); ?>
    <?php endif; ?>
</div>
<?php echo $this->formHidden($form->get($form->getName() . '_csrf')); ?>
<input type="hidden" name="lang" value="<?php echo $escape((string) $lang); ?>">
<?php if ($commentReading !== null): ?>
<input type="hidden" name="comments" value="<?php echo $escape($commentReading); ?>">
<?php endif; ?>
