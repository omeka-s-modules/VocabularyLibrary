    <?php endif; ?>
    <?php if ($commentReading !== null): ?>
    <div class="field">
        <div class="field-meta">
            <label for="vocabulary-library-comments"><?php echo $translate('Comment source'); ?></label>
            <div class="field-description"><?php echo $translate('Selected to match Omeka\'s vocabulary. Choose the other to see what switching to it would change.'); ?></div>
        </div>
        <div class="inputs">
            <select name="comments" id="vocabulary-library-comments">
                <option value="definitions"<?php echo $commentReading === 'definitions' ? ' selected' : ''; ?>><?php echo $translate('Definitions, or comments where there are none (as the library imports)'); ?></option>
                <option value="comments"<?php echo $commentReading === 'comments' ? ' selected' : ''; ?>><?php echo $translate('Comments only (as Omeka\'s own import does)'); ?></option>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <div class="vocabulary-library-reading-actions">
        <button type="submit"><?php echo $translate('Show changes'); ?></button>
    </div>
</form>
<?php endif; ?>

<?php if ($changes): ?>
<p><?php echo $translate('Updating changes the labels and comments below to match the library\'s vocabulary, and adds any new classes and properties. It removes nothing.'); ?></p>
<?php else: ?>
<p><?php echo $translate('Omeka\'s vocabulary already matches the library\'s.'); ?></p>
<?php endif; ?>

<?php
// The sections that have rows, each headed with how many terms it has.
$sections = array_filter($sections, function ($section) {
    return (bool) $section['rows'];
});
foreach ($sections as &$section) {
    $section['heading'] = sprintf('%s (%s)', $section['heading'], count($section['rows']));
}
unset($section);
?>
<?php // What is below, where there is more than one section: a long one hides those after it. ?>
<?php if (count($sections) > 1): ?>
<nav class="vocabulary-library-compare-summary" aria-label="<?php echo $escape($translate('Sections')); ?>">
    <ul>
        <?php foreach ($sections as $section): ?>
        <li><a href="#<?php echo $section['id']; ?>"><?php echo $escape($section['heading']); ?></a></li>
        <?php endforeach; ?>
    </ul>
</nav>
<?php endif; ?>

<?php foreach ($sections as $section): ?>
<h2 id="<?php echo $section['id']; ?>" tabindex="-1"><?php echo $escape($section['heading']); ?></h2>
<?php // Each section's note, though two share one: the section links lead to either. ?>
<?php if (isset($section['note'])): ?>
<p><?php echo $section['note']; ?></p>
<?php endif; ?>
<table class="tablesaw vocabulary-library-compare-table <?php echo $section['class'] ?? ''; ?>" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <?php foreach ($section['columns'] as $column): ?>
            <th><?php echo $escape($column); ?></th>
            <?php endforeach; ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($section['rows'] as $row): ?>
        <tr>
            <?php
            // The term heads its row, so a screen reader names it with each
            // value. As a role on an ordinary cell: core's tables, and the
            // stacked layout they take on a narrow screen, count on every
            // cell of a row being one, the first its row's name.
            ?>
            <?php foreach ($row as $i => $cell): ?>
            <td<?php echo $i === 0 ? ' role="rowheader"' : ''; ?>><?php echo $cell; ?></td>
            <?php endforeach; ?>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endforeach; ?>
