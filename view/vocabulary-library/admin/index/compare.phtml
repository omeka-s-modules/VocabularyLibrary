<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/vocabulary-library.css', 'VocabularyLibrary'));
$this->htmlElement('body')->appendAttribute('class', 'vocabulary-library compare');
$prefix = $vocabulary->prefix();

// A term as Omeka shows one: its label in Omeka where it has one, which is
// how most admins know it, and beneath, its term as the site writes it, in
// core's style for terms. A term with codes for local names, as in RDA's,
// is otherwise hard to tell.
$term = function ($localName, $label = null) use ($prefix, $escape) {
    $term = sprintf('<span class="field-term">%s</span>', $escape($prefix . ':' . $localName));
    return $label === null || $label === '' ? $term : sprintf('<span class="vocabulary-library-term-label">%s</span> %s', $escape($label), $term);
};
// A value as it would be stored: escaped, with its whitespace, and marked
// when empty.
$none = sprintf('<span class="vocabulary-library-none">%s</span>', $translate('None'));
$value = function ($value) use ($none, $escape) {
    if ($value === null || $value === '') {
        return $none;
    }
    return sprintf('<span class="vocabulary-library-value">%s</span>', $escape($value));
};
// A value that changed, with what differs from the other marked: struck out
// where it is removed, underlined where it is added, so the difference
// doesn't rest on colour. A line break, which would otherwise not show, is
// given a sign.
$marked = function (array $parts, $tag) use ($escape) {
    $html = '';
    foreach ($parts as [$text, $differs]) {
        $text = $escape($text);
        $html .= $differs ? sprintf('<%1$s>%2$s</%1$s>', $tag, str_replace("\n", '<span class="vocabulary-library-line-break" aria-hidden="true">↵</span>' . "\n", $text)) : $text;
    }
    return sprintf('<span class="vocabulary-library-value">%s</span>', $html);
};
// The terms whose label, or whose comment, changed, in alphabetical order of
// term, each with its value from what, to what, side by side: each reads as
// ordinary text, with what differs marked.
$changed = function (array $changes, array $labels) use ($term, $value, $marked, $collation) {
    uksort($changes, [$collation, 'compare']);
    $rows = [];
    foreach ($changes as $localName => [$from, $to]) {
        [$from, $to] = [(string) $from, (string) $to];
        if ($from === '' || $to === '') {
            // Where there was nothing, or is to be nothing, the whole value
            // is the change.
            $cells = [$value($from), $value($to)];
        } else {
            [$fromParts, $toParts] = \VocabularyLibrary\Stdlib\TextDiff::words($from, $to);
            $cells = [$marked($fromParts, 'del'), $marked($toParts, 'ins')];
        }
        $rows[] = array_merge([$term($localName, $labels[$localName] ?? null)], $cells);
    }
    return $rows;
};
// Terms with their values, in alphabetical order of term.
$listed = function (array $members) use ($term, $value, $collation) {
    uksort($members, [$collation, 'compare']);
    $rows = [];
    foreach ($members as $localName => $values) {
        $rows[] = array_merge([$term($localName)], array_map($value, (array) $values));
    }
    return $rows;
};
// Each section: its id, its heading, its columns, its rows of rendered
// cells, the term first, and any note and table class. Changed labels and changed comments
// are sections of their own: labels are short and what everyone sees,
// comments long and mostly documentation. So labels come first, then new
// terms, then comments, then terms only in Omeka, which aren't changes;
// within each, properties before classes, as on core's update page.
// The first column is named for the kind of term its section lists.
$kinds = ['properties' => $translate('Property'), 'classes' => $translate('Class')];
$changeColumns = function ($kind) use ($kinds, $translate) {
    return [$kinds[$kind], $translate('From'), $translate('To')];
};
$newColumns = function ($kind) use ($kinds, $translate) {
    return [$kinds[$kind], $translate('Label'), $translate('Comment')];
};
$onlyInOmekaColumns = function ($kind) use ($kinds, $translate) {
    return [$kinds[$kind], $translate('Label')];
};
$sections = [
    ['id' => 'vocabulary-library-changed-property-labels', 'heading' => $translate('Changed property labels'), 'columns' => $changeColumns('properties'), 'rows' => $changed($diff['properties']['label'], $labels['properties']), 'class' => 'vocabulary-library-change-table'],
    ['id' => 'vocabulary-library-changed-class-labels', 'heading' => $translate('Changed class labels'), 'columns' => $changeColumns('classes'), 'rows' => $changed($diff['classes']['label'], $labels['classes']), 'class' => 'vocabulary-library-change-table'],
    ['id' => 'vocabulary-library-new-properties', 'heading' => $translate('New properties'), 'columns' => $newColumns('properties'), 'rows' => $listed($diff['properties']['new'])],
    ['id' => 'vocabulary-library-new-classes', 'heading' => $translate('New classes'), 'columns' => $newColumns('classes'), 'rows' => $listed($diff['classes']['new'])],
    ['id' => 'vocabulary-library-changed-property-comments', 'heading' => $translate('Changed property comments'), 'columns' => $changeColumns('properties'), 'rows' => $changed($diff['properties']['comment'], $labels['properties']), 'class' => 'vocabulary-library-change-table'],
    ['id' => 'vocabulary-library-changed-class-comments', 'heading' => $translate('Changed class comments'), 'columns' => $changeColumns('classes'), 'rows' => $changed($diff['classes']['comment'], $labels['classes']), 'class' => 'vocabulary-library-change-table'],
];
$changes = array_sum(array_map('count', array_column($sections, 'rows')));
// Terms Omeka's vocabulary has and the library's doesn't come last, with a
// note.
// They aren't changes: updating keeps them.
$onlyInOmeka = $translate('Omeka\'s vocabulary has these and the library\'s doesn\'t. Updating doesn\'t remove them.');
$sections[] = ['id' => 'vocabulary-library-properties-only-in-omeka', 'heading' => $translate('Properties only in Omeka'), 'columns' => $onlyInOmekaColumns('properties'), 'rows' => $listed($missing['properties']), 'note' => $onlyInOmeka];
$sections[] = ['id' => 'vocabulary-library-classes-only-in-omeka', 'heading' => $translate('Classes only in Omeka'), 'columns' => $onlyInOmekaColumns('classes'), 'rows' => $listed($missing['classes']), 'note' => $onlyInOmeka];
?>

<?php echo $this->pageTitle($entry['name'], 1, $translate('Vocabulary Library'), $translate('Compare and update')); ?>

<?php // Only the actions and hidden inputs, so the form of reading options can't nest in it. ?>
