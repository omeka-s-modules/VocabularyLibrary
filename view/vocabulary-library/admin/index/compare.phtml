<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/vocabulary-library.css', 'VocabularyLibrary'));
$this->htmlElement('body')->appendAttribute('class', 'vocabulary-library compare');
$browseUrl = $this->url('admin/vocabulary-library');
$prefix = $vocabulary->prefix();

// Terms as the site writes them, in alphabetical order.
$rows = function (array $kinds) use ($prefix) {
    $rows = [];
    foreach ($kinds as $members) {
        uksort($members, 'strnatcasecmp');
        foreach ($members as $localName => $values) {
            $rows[] = array_merge([$prefix . ':' . $localName], (array) $values);
        }
    }
    return $rows;
};
// A value as it would be stored: escaped, with its whitespace, and marked
// when empty.
$none = sprintf('<span class="vocabulary-library-none">%s</span>', $translate('None'));
$value = function ($value) use ($none, $escape) {
    if ($value === null || $value === '') {
        return $none;
    }
    return sprintf('<span class="vocabulary-library-value">%s</span>', $escape($value));
};
$sections = [
    [$translate('Changed labels'), [$translate('Term'), $translate('From'), $translate('To')], $rows([$diff['classes']['label'], $diff['properties']['label']])],
    [$translate('Changed comments'), [$translate('Term'), $translate('From'), $translate('To')], $rows([$diff['classes']['comment'], $diff['properties']['comment']])],
    [$translate('New classes'), [$translate('Term'), $translate('Label'), $translate('Comment')], $rows([$diff['classes']['new']])],
    [$translate('New properties'), [$translate('Term'), $translate('Label'), $translate('Comment')], $rows([$diff['properties']['new']])],
];
$changes = array_sum(array_map('count', array_column($sections, 2)));
// Terms Omeka has and the library's file doesn't come first, with a note.
// They aren't changes: updating keeps them.
array_unshift($sections, [
    $translate('Not in the library\'s file'),
    [$translate('Term'), $translate('Label')],
    $rows([$missing['classes'], $missing['properties']]),
    $translate('Omeka has these and the library\'s file doesn\'t. Updating doesn\'t remove them.'),
]);
?>

<?php echo $this->pageTitle($entry['name'], 1, $translate('Vocabulary Library'), $translate('Compare and update')); ?>

<?php // Only the actions and hidden inputs, so the form of reading options can't nest in it. ?>
<?php $form->prepare(); ?>
<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <?php if ($changes): ?>
    <?php echo $this->hyperlink($translate('Cancel'), $browseUrl, ['class' => 'button']); ?>
    <button type="submit"><?php echo $translate('Update'); ?></button>
    <?php else: ?>
    <?php echo $this->hyperlink($translate('Back to the library'), $browseUrl, ['class' => 'button']); ?>
    <?php endif; ?>
</div>
<?php echo $this->formHidden($form->get($form->getName() . '_csrf')); ?>
<input type="hidden" name="lang" value="<?php echo $escape((string) $lang); ?>">
<?php if ($commentReading !== null): ?>
<input type="hidden" name="comments" value="<?php echo $escape($commentReading); ?>">
<?php endif; ?>
<?php echo $this->form()->closeTag(); ?>

<?php // How to read the file, where there's a choice: its language, and where terms' comments come from (null when both ways read the same). ?>
<?php if (count($entry['languages']) > 1 || $commentReading !== null): ?>
<form method="get" class="vocabulary-library-reading">
    <?php if (count($entry['languages']) > 1): ?>
    <div class="field">
        <div class="field-meta">
            <label for="vocabulary-library-lang"><?php echo $translate('Preferred language'); ?></label>
            <div class="field-description"><?php echo $translate('Choose the language the vocabulary was imported in to see what changed, or another language to switch its labels and comments to that language. First available matches an import with no preferred language.'); ?></div>
        </div>
        <div class="inputs">
            <select name="lang" id="vocabulary-library-lang">
                <option value=""<?php echo $lang === null ? ' selected' : ''; ?>><?php echo $translate('First available'); ?></option>
                <?php foreach ($languageOptions as $code => $label): ?>
                <option value="<?php echo $escape($code); ?>"<?php echo $lang === $code ? ' selected' : ''; ?>><?php echo $escape($label); ?></option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <?php if ($commentReading !== null): ?>
    <div class="field">
        <div class="field-meta">
            <?php // Core's label for the same setting on its import form. ?>
            <label for="vocabulary-library-comments"><?php echo $translate('Comment property'); ?></label>
            <div class="field-description"><?php echo $translate('The library imports each term\'s skos:definition, and its rdfs:comment where it has none. Omeka\'s own import reads rdfs:comment. Choose the one the vocabulary was imported with to see what changed, or the other to see what switching would change. The page starts with the one that matches.'); ?></div>
        </div>
        <div class="inputs">
            <select name="comments" id="vocabulary-library-comments">
                <option value="definitions"<?php echo $commentReading === 'definitions' ? ' selected' : ''; ?>><?php echo $translate('skos:definition, else rdfs:comment'); ?></option>
                <option value="comments"<?php echo $commentReading === 'comments' ? ' selected' : ''; ?>>rdfs:comment</option>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <div class="vocabulary-library-reading-actions">
        <button type="submit"><?php echo $translate('Compare'); ?></button>
    </div>
</form>
<?php endif; ?>

<?php if ($changes): ?>
<p><?php echo $translate('Updating changes the labels and comments below to the library file\'s, and adds any new classes and properties. It removes nothing.'); ?></p>
<?php else: ?>
<p><?php echo $translate('Updating would change nothing in Omeka.'); ?></p>
<?php endif; ?>

<?php foreach ($sections as $section): ?>
<?php [$heading, $columns, $sectionRows] = $section; ?>
<?php if ($sectionRows): ?>
<h3><?php echo $escape(sprintf('%s (%s)', $heading, count($sectionRows))); ?></h3>
<?php if (isset($section[3])): ?>
<p><?php echo $section[3]; ?></p>
<?php endif; ?>
<table class="tablesaw vocabulary-library-compare-table" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <?php foreach ($columns as $column): ?>
            <th><?php echo $escape($column); ?></th>
            <?php endforeach; ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($sectionRows as $row): ?>
        <tr>
            <td><?php echo $escape(array_shift($row)); ?></td>
            <?php foreach ($row as $cell): ?>
            <td><?php echo $value($cell); ?></td>
            <?php endforeach; ?>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endif; ?>
<?php endforeach; ?>
