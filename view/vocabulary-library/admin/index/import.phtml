<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/vocabulary-library.css', 'VocabularyLibrary'));
$this->htmlElement('body')->appendAttribute('class', 'vocabulary-library import');
?>

<?php echo $this->pageTitle($entry['name'], 1, $translate('Vocabulary Library'), $translate('Import')); ?>

<?php // Only for a vocabulary Omeka already has: the import itself is core's import details. ?>

<div id="page-actions">
    <?php echo $this->hyperlink($translate('Back to the library'), $libraryUrl, ['class' => 'button']); ?>
</div>
<?php
// Reached from a stale tab or the Back button. Said as core's import details
// say it, and the next step as the details give it.
$inOmeka = $this->hyperlink($installed['vocabulary']->label(), $installed['url']);
?>
<?php if ($installed['exact']): ?>
<p><?php echo sprintf($escape($translate('%s already uses this vocabulary\'s namespace URI.')), $inOmeka); ?></p>
<?php else: ?>
<p><?php echo sprintf($escape($translate('%1$s uses another form of this vocabulary\'s namespace URI, %2$s.')), $inOmeka, $escape($installed['vocabulary']->namespaceUri())); ?></p>
<?php endif; ?>
<?php echo $this->partial('common/vocabulary-library-status', ['slug' => $slug, 'installed' => $installed, 'long' => true, 'return' => $libraryState]); ?>
