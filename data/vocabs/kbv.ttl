<https://id.kb.se/ns/librissearch/QueryCode> a rdfs:Datatype ;
  :category :pending .

<https://id.kb.se/ns/librissearch/additionalItemInformation> a owl:DatatypeProperty ;
  rdfs:domain :Item ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ;
  ls:merges :custodialHistory ,
    [ owl:propertyChainAxiom ( <https://id.kb.se/marc/hasCopyAndVersionIdentificationNote> <https://id.kb.se/marc/itemCondition> ) ] ,
    [ owl:propertyChainAxiom ( <https://id.kb.se/marc/hasBindingInformation> :label ) ] ,
    [ owl:propertyChainAxiom ( :immediateAcquisition <https://id.kb.se/marc/sourceOfAcquisition> ) ] ,
    [ owl:propertyChainAxiom ( :immediateAcquisition :identifiedBy :value ) ] ,
    [ owl:propertyChainAxiom ( :classification :code ) ] ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending .

<https://id.kb.se/ns/librissearch/author> a owl:ObjectProperty ;
  rdfs:domain :Work ;
  :category <https://id.kb.se/ns/librissearch/preferLike> ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "author"@en , "författare"@sv ;
  sdo:rangeIncludes :BibliographicAgent ;
  owl:propertyChainAxiom ( <https://id.kb.se/ns/librissearch/authorContribution> :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :hasPart ] <https://id.kb.se/ns/librissearch/authorContribution> :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :relationship ] :entity <https://id.kb.se/ns/librissearch/authorContribution> :agent ) ;
  :category <https://id.kb.se/ns/librissearch/preferLike> ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/authorContribution> a owl:ObjectProperty ;
  rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
          owl:hasValue <https://id.kb.se/relator/author> ;
          owl:onProperty :role ] ] ;
  rdfs:domain :Work ;
  :category :pending ;
  rdfs:subPropertyOf :contribution .

<https://id.kb.se/ns/librissearch/bibliography> a owl:ObjectProperty ;
  rdfs:range :Bibliography ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :impliedByObject ,
    :pending ;
  :label "in bibliography"@en , "ingår i bibliografi"@sv ;
  :code "DB"^^ls:QueryCode ,
    "z3950.5001"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:domain :Instance ;
        rdfs:subPropertyOf :meta ] :bibliography ) ;
  ls:descriptionRemarkByLang "Can also be searched using library code"@en , "Kan även sökas med sigel"@sv ;
  ls:filterDescriptionByLang "Special collection that the resource is part of, such as subject-specific or local/regional bibliographies"@en , "Särskild samling som resursen ingår i, till exempel ämnesspecialiserade och lokala/regionala bibliografier"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :impliedByObject ,
    :pending .

<https://id.kb.se/ns/librissearch/coercing> a :ConceptCollection ;
  :category :pending .

<https://id.kb.se/ns/librissearch/composite> a :ConceptCollection ;
  :category :pending ;
  :label "composite"@en , "sammansatt"@sv ;
  <https://id.kb.se/vocab/code> "composite" .

<https://id.kb.se/ns/librissearch/contributor> a owl:ObjectProperty ;
  :category :searchfilter ,
    :shorthand ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :impliedByObject ,
    <https://id.kb.se/ns/librissearch/preferLike> ,
    :pending ;
  :label "Author/Contributor"@en , "Författare/upphov"@sv ;
  sdo:rangeIncludes :BibliographicAgent ;
  sdo:domainIncludes :Creation ;
  :code "dc.author"^^ls:QueryCode ,
    "dc.contributor"^^ls:QueryCode ,
    "dc.creator"^^ls:QueryCode ,
    "FÖRF"^^ls:QueryCode ,
    "FORF"^^ls:QueryCode ,
    "PERS"^^ls:QueryCode ,
    "WFRF"^^ls:QueryCode ,
    "WINS"^^ls:QueryCode ,
    "z3950.1"^^ls:QueryCode ,
    "z3950.2"^^ls:QueryCode ,
    "z3950.3"^^ls:QueryCode ,
    "z3950.1002"^^ls:QueryCode ,
    "z3950.1003"^^ls:QueryCode ,
    "z3950.1004"^^ls:QueryCode ,
    "z3950.1005"^^ls:QueryCode ,
    "z3950.1006"^^ls:QueryCode ,
    "z3950.1098"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :contribution :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :hasPart ] :contribution :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :relationship ] :entity :contribution :agent ) ;
  ls:filterDescriptionByLang "Authors and other creators, such as illustrators, translators, editors, and others. Includes individuals, institutions, organizations, and groups."@en , "Författare och andra upphovspersoner som till exempel illustratörer, översättare, redaktörer med flera. Inkluderar personer, institutioner, organisationer och grupper."@sv ;
  :category :searchfilter ,
    :shorthand ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :impliedByObject ,
    <https://id.kb.se/ns/librissearch/preferLike> ,
    :pending .

<https://id.kb.se/ns/librissearch/controlNumber> a owl:DatatypeProperty ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "control number"@en , "kontrollnummer"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/identifier> ;
  :code "ONR"^^ls:QueryCode ,
    "rec.recordIdentifier"^^ls:QueryCode ,
    "BIBID"^^ls:QueryCode ,
    "z3950.1032"^^ls:QueryCode ,
    "z3950.5000"^^ls:QueryCode ,
    "z3950.7000"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :meta <https://id.kb.se/ns/librissearch/controlNumbers> ) ;
  ls:filterDescriptionByLang "Libris ID of the record, in the MARC21 format"@en , "Postens Libris-ID i MARC21-formatet"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/controlNumbers> a owl:DatatypeProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/descriptionRemark> a owl:DatatypeProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/dewey> a owl:DatatypeProperty ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ,
    :searchfilter ;
  ls:merges [ owl:propertyChainAxiom ( :additionalClassificationDdc :code ) ] ,
    [ owl:propertyChainAxiom ( [ rdfs:range :ClassificationDdc ;
            rdfs:subPropertyOf :classification ] :code ) ] ;
  :label "Dewey classification"@en , "Dewey-klassifikation"@sv ;
  sdo:domainIncludes :Work ;
  :code "DDC"^^ls:QueryCode ,
    "DDC2"^^ls:QueryCode ,
    "DDK"^^ls:QueryCode ,
    "z3950.13"^^ls:QueryCode ;
  ls:filterDescriptionByLang "Classification code according to the Dewey Decimal Classification (DDC)"@en , "Klassifikationskod enligt Dewey decimalklassifikation (DDK)"@sv ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ,
    :searchfilter .

<https://id.kb.se/ns/librissearch/encodingLevel> a owl:ObjectProperty ;
  rdfs:range <https://id.kb.se/marc/EncLevelType> ;
  rdfs:domain :Instance ;
  :category :shorthand ,
    :pending ;
  :label "Encoding level"@en , "Beskrivningsnivå"@sv ;
  owl:propertyChainAxiom ( [ rdfs:domain :Instance ;
        rdfs:subPropertyOf :meta ] :encodingLevel ) ;
  :category :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/filterDescription> a owl:DatatypeProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/filterGroupDescription> a owl:DatatypeProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/filters> a :PartialCollectionView ;
  :items ( [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/contributor> <https://id.kb.se/ns/librissearch/title> :language <https://id.kb.se/ns/librissearch/originalLanguage> <https://id.kb.se/ns/librissearch/yearPublished> <https://id.kb.se/ns/librissearch/workCategory> :subject <https://id.kb.se/ns/librissearch/instanceCategory> <https://id.kb.se/ns/librissearch/library> :seriesMembership <https://id.kb.se/ns/librissearch/identifier> ) ;
        :label "" ] [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/contributor> <https://id.kb.se/ns/librissearch/author> <https://id.kb.se/ns/librissearch/translator> :tableOfContents :responsibilityStatement ) ;
        :label "Origin"@en , "Upphov"@sv ] [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/yearPublished> <https://id.kb.se/ns/librissearch/publisher> <https://id.kb.se/ns/librissearch/publicationPlace> <https://id.kb.se/ns/librissearch/publicationCountry> :manufacturer :manufacturePlace <https://id.kb.se/ns/librissearch/publicationStartYear> <https://id.kb.se/ns/librissearch/publicationEndYear> ) ;
        :label "Publication"@en , "Utgivning"@sv ] [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/identifier> <https://id.kb.se/ns/librissearch/isbn> <https://id.kb.se/ns/librissearch/issn> <https://id.kb.se/ns/librissearch/ismn> <https://id.kb.se/ns/librissearch/isxn> <https://id.kb.se/ns/librissearch/lccn> <https://id.kb.se/ns/librissearch/controlNumber> ) ;
        :label "Identifiers"@en , "Identifikatorer"@sv ] [ a :PartialCollectionView ;
        :items ( :classification <https://id.kb.se/ns/librissearch/sab> <https://id.kb.se/ns/librissearch/dewey> <https://id.kb.se/ns/librissearch/udc> <https://id.kb.se/ns/librissearch/lcc> <https://id.kb.se/ns/librissearch/nlm> ) ;
        :label "Classification"@en , "Klassifikation"@sv ] [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/library> <https://id.kb.se/ns/librissearch/itemInformation> <https://id.kb.se/ns/librissearch/itemShelf> <https://id.kb.se/ns/librissearch/hasItemStatement> <https://id.kb.se/ns/librissearch/itemSubject> <https://id.kb.se/ns/librissearch/hasInternalItemNote> <https://id.kb.se/ns/librissearch/hasAdditionalItemInformation> ) ;
        :label "Library-specific filters"@en , "Biblioteksspecifika filter"@sv ;
        ls:filterGroupDescriptionByLang "Information relating to the copies’ location, placement, condition, origin, and more"@en , "Uppgifter som rör exemplarens plats, placering, skick, ursprung med mera"@sv ] [ a :PartialCollectionView ;
        :items ( <https://id.kb.se/ns/librissearch/itemRecordCreated> <https://id.kb.se/ns/librissearch/instanceRecordCreated> <https://id.kb.se/ns/librissearch/instanceRecordModified> ) ;
        :label "Timestamps for catalog records"@en , "Tidsstämplar för katalogposter"@sv ;
        ls:filterGroupDescriptionByLang """Specify in one of the following formats:
                                            yyyy
                                            yyyy-MM
                                            yyyy-MM-dd
                                            yyyyMM
                                            yyyyMMdd"""@en , """Anges på någon av formerna:
                                            åååå
                                            åååå-mm
                                            åååå-mm-dd
                                            ååååmm
                                            ååååmmdd"""@sv ] [ a :PartialCollectionView ;
        :items ( :intendedAudience <https://id.kb.se/ns/librissearch/bibliography> :note ) ;
        :label "Other"@en , "Övrigt"@sv ] ) .

<https://id.kb.se/ns/librissearch/findCategory> a owl:ObjectProperty ;
  rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
          owl:hasValue <https://id.kb.se/term/div/find> ;
          owl:onProperty :inCollection ] ] ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> ;
  ls:indexKey "_categoryByCollection.find" ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/workCategory> ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> .

<https://id.kb.se/ns/librissearch/hasAdditionalItemInformation> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :shorthand ,
    :searchfilter ,
    :pending ;
  :label "additional item information"@en , "övrig beståndsinformation"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/itemInformation> ;
  owl:propertyChainAxiom ( :hasItem <https://id.kb.se/ns/librissearch/additionalItemInformation> ) ;
  :category :shorthand ,
    :searchfilter ,
    :pending .

<https://id.kb.se/ns/librissearch/hasInternalItemNote> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "internal item note"@en , "intern beståndsanmärkning"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/itemInformation> ;
  :code "H8XX"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :hasItem <https://id.kb.se/ns/librissearch/internalItemNote> ) ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/hasItemStatement> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "item statement"@en , "beståndsuppgift"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/itemInformation> ;
  :code "H8XZ"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :hasItem <https://id.kb.se/ns/librissearch/itemStatement> ) ;
  ls:filterDescriptionByLang "Additional information about shelf mark and holding"@en , "Kompletterande uppgift om hyllsignum och bestånd"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/identifier> a owl:DatatypeProperty ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "identifier"@en , "identifikator"@sv ;
  :code "dc.identifier"^^ls:QueryCode ,
    "z3950.1104"^^ls:QueryCode ,
    "LINKISXN"^^ls:QueryCode ,
    "NUMM"^^ls:QueryCode ;
  ls:filterDescriptionByLang "Used for searching in all types of identifiers, such as ISBN or ISSN"@en , "Används för att söka i alla typer av identifikatorer, till exempel ISBN eller ISSN"@sv ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/identifyCategory> a owl:ObjectProperty ;
  rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
          owl:hasValue <https://id.kb.se/term/div/identify> ;
          owl:onProperty :inCollection ] ] ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> ;
  ls:indexKey "_categoryByCollection.identify" ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/workCategory> ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> .

<https://id.kb.se/ns/librissearch/indexKey> a owl:DatatypeProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/instanceCategory> a owl:ObjectProperty ;
  rdfs:range :InstanceCategory ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :impliedByObject ,
    :pending ;
  :label "format"@en , "format"@sv ;
  ls:indexKey "_categoryByCollection.@none" ;
  ls:filterDescriptionByLang "Format of the resource, for example book, online resource, e-book, audio disc or braille"@en , "Resursens format, till exempel bok, onlineresurs, e-bok, ljudskiva, video eller punktskrift"@sv ;
  :category :searchfilter ,
    :impliedByObject ,
    :pending .

<https://id.kb.se/ns/librissearch/instanceIdentifier> a owl:DatatypeProperty ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ;
  ls:merges [ owl:propertyChainAxiom ( :identifiedBy :value ) ] ,
    [ owl:propertyChainAxiom ( :indirectlyIdentifiedBy :value ) ] ,
    [ owl:propertyChainAxiom ( :identifiedBy <https://id.kb.se/marc/incorrectIssn> ) ] ,
    [ owl:propertyChainAxiom ( :identifiedBy <https://id.kb.se/marc/canceledIssn> ) ] ,
    [ owl:propertyChainAxiom ( :meta [ rdfs:range :LibrisIIINumber ;
            rdfs:subPropertyOf :identifiedBy ] :value ) ] ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/identifier> ;
  sdo:domainIncludes :Instance ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending .

<https://id.kb.se/ns/librissearch/instanceRecordCreated> a owl:DatatypeProperty ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#dateTime> ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "created date (instance)"@en , "registreringsdatum (instans)"@sv ;
  :comment "Date when bibliographic record was created."@en , "Datum när bibliografisk post skapades."@sv ;
  :code "DAT"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:domain :Instance ;
        rdfs:subPropertyOf :meta ] :created ) ;
  ls:filterDescriptionByLang "The date when a bibliographic record was created"@en , "Det datum då en bibliografisk post skapats"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/instanceRecordModified> a owl:DatatypeProperty ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#dateTime> ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "modified date (instance)"@en , "uppdateringsdatum (instans)"@sv ;
  :comment "Date when bibliographic record was updated."@en , "Datum när bibliografisk post uppdaterades."@sv ;
  :code "BDAT"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:domain :Instance ;
        rdfs:subPropertyOf :meta ] :modified ) ;
  ls:filterDescriptionByLang "The date when a bibliographic record was updated"@en , "Det datum då en bibliografisk post uppdaterats"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/instanceType> a owl:ObjectProperty ;
  rdfs:domain :Instance ;
  :category :impliedByObject ,
    :pending ;
  ls:indexKey "@type" ;
  :category :impliedByObject ,
    :pending .

<https://id.kb.se/ns/librissearch/internalItemNote> a owl:DatatypeProperty ;
  rdfs:domain :Item ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ;
  ls:merges :cataloguersNote ,
    [ owl:propertyChainAxiom ( <https://id.kb.se/marc/hasTextualHoldingsBasicBibliographicUnit> <https://id.kb.se/marc/cataloguersNote> ) ] ,
    [ owl:propertyChainAxiom ( :meta :cataloguersNote ) ] ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending .

<https://id.kb.se/ns/librissearch/isbn> a owl:DatatypeProperty ;
  :label "ISBN" ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/isxn> ;
  :code "bath.isbn"^^ls:QueryCode ,
    "z3950.7"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:range :ISBN ;
        rdfs:domain :Instance ;
        rdfs:subPropertyOf :identifiedBy ] :value ) ;
  ls:descriptionRemarkByLang "Can be searched with or without hyphen"@en , "Can be searched using either 10 or 13 digits"@en , "Kan sökas med eller utan bindestreck"@sv , "Kan sökas med 10 eller 13 siffror"@sv ;
  ls:filterDescriptionByLang "Identifier for monographic publications such as books and maps"@en , "Identifikator för monografiska publikationer som till exempel böcker och kartor"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/ismn> a owl:DatatypeProperty ;
  :label "ISMN" ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/isxn> ;
  owl:propertyChainAxiom ( [ rdfs:range :ISMN ;
        rdfs:domain :Instance ;
        rdfs:subPropertyOf :identifiedBy ] :value ) ;
  ls:descriptionRemarkByLang "Can be searched with or without hyphen"@en , "Kan sökas med eller utan bindestreck"@sv ;
  ls:filterDescriptionByLang "Identifier for printed music publications such as sheet music and scores"@en , "Identifikator för tryckta musikaliska publikationer som till exempel noter och partitur"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/issn> a owl:DatatypeProperty ;
  :label "ISSN" ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/isxn> ;
  :code "bath.issn"^^ls:QueryCode ,
    "z3950.8"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:range :ISSN ;
        rdfs:domain :Instance ;
        rdfs:subPropertyOf :identifiedBy ] :value ) ;
  ls:descriptionRemarkByLang "Can be searched with or without hyphen"@en , "Kan sökas med eller utan bindestreck"@sv ;
  ls:filterDescriptionByLang "Identifier for serial resources such as journals and newspapers"@en , "Identifikator för seriella resurser som till exempel tidskrifter och dagstidningar"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/isxn> a owl:DatatypeProperty ;
  :category <https://id.kb.se/ns/librissearch/composite> ,
    :pending ,
    :searchfilter ;
  :label "ISXN"@en , "ISXN"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/linkisxn> ;
  :code "z3950.1007"^^ls:QueryCode ,
    "z3950.5002"^^ls:QueryCode ;
  ls:descriptionRemarkByLang "Can be searched with or without hyphen"@en , "Kan sökas med eller utan bindestreck"@sv ;
  ls:filterDescriptionByLang """Combination of the search filters:
                            ISBN
                            ISSN
                            ISMN"""@en , """Sammansättning av sökfiltren:
                            ISBN
                            ISSN
                            ISMN"""@sv ;
  :category <https://id.kb.se/ns/librissearch/composite> ,
    :pending ,
    :searchfilter .

<https://id.kb.se/ns/librissearch/itemHeldBy> a owl:ObjectProperty ;
  rdfs:range :Library ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> ;
  :label "library (sigel)"@en , "bibliotek (sigel)"@sv ;
  ls:indexKey "@reverse.itemOf.heldBy" ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/library> ;
  owl:propertyChainAxiom ( :hasItem :heldBy ) ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> .

<https://id.kb.se/ns/librissearch/itemHeldByOrg> a owl:ObjectProperty ;
  rdfs:range <https://id.kb.se/ns/bibdb/Organization> ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> ;
  :label "library organization"@en , "biblioteksorganisation"@sv ;
  ls:indexKey "@reverse.itemOf.heldBy.isPartOf" ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/library> ;
  owl:propertyChainAxiom ( :hasItem :heldBy :isPartOf ) ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> .

<https://id.kb.se/ns/librissearch/itemInformation> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "item"@en , "bestånd"@sv ;
  ls:descriptionRemarkByLang "To narrow down the search to a specific library, combine with the filter Library"@en , "För att avgränsa sökningen till ett specifikt bibliotek, kombinera med filtret Bibliotek"@sv ;
  ls:filterDescriptionByLang """Combination of the search filters:
                              Item statement
                              Shelf
                              Additional item information
                              Internal item note
                              Item subject"""@en , """Sammansättning av sökfiltren:
                              Beståndsuppgift
                              Placering
                              Övrig beståndsinformation
                              Intern beståndsanmärkning
                              Lokalt ämnesord"""@sv ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/itemRecordCreated> a owl:DatatypeProperty ;
  rdfs:range <http://www.w3.org/2001/XMLSchema#dateTime> ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "item created"@en , "registreringsdatum"@sv ;
  :comment "Date when item/holding/copy was registered."@en , "Datum när exemplar/bestånd registrerades."@sv ;
  :code "HDAT"^^ls:QueryCode ,
    "FORVDAT"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :hasItem :meta :created ) ;
  ls:filterDescriptionByLang "The date a holdings record was registered"@en , "Det datum då en beståndspost registrerats"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/itemShelf> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "shelf"@en , "placering"@sv ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/itemInformation> ;
  :code "WHYL"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :hasItem <https://id.kb.se/ns/librissearch/shelf> ) ;
  ls:filterDescriptionByLang "Used to find where a copy is shelved"@en , "Används för att hitta var ett exemplar finns uppställt"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/itemStatement> a owl:DatatypeProperty ;
  rdfs:domain :Item ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ;
  ls:merges [ owl:propertyChainAxiom ( :hasNote :label ) ] ,
    [ owl:propertyChainAxiom ( :summary :label ) ] ,
    [ owl:propertyChainAxiom ( :appliesTo :label ) ] ,
    [ owl:propertyChainAxiom ( <https://id.kb.se/marc/hasTextualHoldingsBasicBibliographicUnit> <https://id.kb.se/marc/publicNote> ) ] ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending .

<https://id.kb.se/ns/librissearch/itemSubject> a owl:ObjectProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "item subject"@en , "lokalt ämnesord"@sv ;
  sdo:rangeIncludes :BibliographicAgent ,
    :Subject ,
    :Work ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/itemInformation> ;
  owl:propertyChainAxiom ( :hasItem :subject ) ;
  ls:filterDescriptionByLang "Subject headings assigned for specific copies"@en , "Ämnesord angivna för specifika exemplar"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/lcc> a owl:DatatypeProperty ;
  :category :shorthand ,
    :pending ,
    :searchfilter ;
  :label "LCC classification"@en , "LC-klassifikation"@sv ;
  ls:indexKey "classification._lcc" ;
  sdo:domainIncludes :Work ;
  owl:propertyChainAxiom ( [ rdfs:range :ClassificationLcc ;
        rdfs:subPropertyOf :classification ] :code ) ;
  ls:filterDescriptionByLang "Classification code according to the Library of Congress classification system (LCC)"@en , "Klassifikationskod enligt Library of Congress klassifikationssystem (LCC)"@sv ;
  :category :shorthand ,
    :pending ,
    :searchfilter .

<https://id.kb.se/ns/librissearch/lccn> a owl:DatatypeProperty ;
  :label "LCCN" ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :code "bath.lccn"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:range :LCCN ;
        rdfs:domain :Instance ;
        rdfs:subPropertyOf :identifiedBy ] :value ) ;
  ls:filterDescriptionByLang "Library of Congress Control Number"@en , "Identifikator i Library of Congress nummersystem"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/library> a owl:ObjectProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :impliedByObject ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "library"@en , "bibliotek"@sv ;
  sdo:rangeIncludes :Library ,
    <https://id.kb.se/ns/bibdb/Organization> ;
  :code "bath.possessingInstitution"^^ls:QueryCode ,
    "BIBL"^^ls:QueryCode ,
    "LIB"^^ls:QueryCode ,
    "BIB"^^ls:QueryCode ,
    "OCODE"^^ls:QueryCode ,
    "z3950.1044"^^ls:QueryCode ;
  ls:descriptionRemarkByLang "Can also be searched using organisation code or library code"@en , "Kan även sökas med organisationskod eller sigel"@sv ;
  ls:filterDescriptionByLang "The library that holds the resource"@en , "Det bibliotek som innehar resursen"@sv ;
  :category :searchfilter ,
    :impliedByObject ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/merged> a :ConceptCollection ;
  :category :pending ;
  :label "merged"@en , "sammanslagen"@sv .

<https://id.kb.se/ns/librissearch/merges> a owl:ObjectProperty ;
  :category :pending .

<https://id.kb.se/ns/librissearch/nlm> a owl:DatatypeProperty ;
  :category :shorthand ,
    :pending ,
    :searchfilter ;
  :label "NLM classification"@en , "NLM-klassifikation"@sv ;
  ls:indexKey "classification._nlm" ;
  sdo:domainIncludes :Work ;
  owl:propertyChainAxiom ( [ rdfs:range :ClassificationNlm ;
        rdfs:subPropertyOf :classification ] :code ) ;
  ls:filterDescriptionByLang "Classification code according to the National Library of Medicine (NLM) classification system"@en , "Klassifikationskod enligt National Library of Medicines (NLM) klassifikationssystem"@sv ;
  :category :shorthand ,
    :pending ,
    :searchfilter .

<https://id.kb.se/ns/librissearch/noneCategory> a owl:ObjectProperty ;
  rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
          owl:onProperty :inCollection ;
          owl:allValuesFrom [ owl:complementOf [ owl:oneOf ( <https://id.kb.se/term/div/find> <https://id.kb.se/term/div/identify> ) ] ] ] ] ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> ;
  ls:indexKey "_categoryByCollection.@none" ;
  rdfs:subPropertyOf <https://id.kb.se/ns/librissearch/workCategory> ;
  :category :pending ,
    <https://id.kb.se/ns/librissearch/coercing> .

<https://id.kb.se/ns/librissearch/originalLanguage> a owl:ObjectProperty ;
  rdfs:range :Language ;
  rdfs:domain :Work ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "original language"@en , "originalspråk"@sv ;
  :comment "Language that resource was translated from."@en , "Språk som resursen översatts från."@sv ;
  :code "ÖVERS"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :translationOf :language ) ;
  ls:filterDescriptionByLang "The language from which a resource has been translated. Used, for example, to find books translated from a particular language. Combine with the Language filter to narrow the results further."@en , "Det språk som en resurs översatts från. Används för att exempelvis hitta böcker översatta från ett visst språk. Kombinera med filtret Språk för att avgränsa ytterligare."@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/preferLike> a :ConceptCollection ;
  :category :pending ;
  <https://id.kb.se/vocab/code> "preferLike" .

<https://id.kb.se/ns/librissearch/publicationCountry> a owl:ObjectProperty ;
  rdfs:range :Country ;
  :category :shorthand ,
    :searchfilter ,
    :impliedByObject ,
    :pending ;
  :label "country of publication"@en , "utgivningsland"@sv ;
  sdo:domainIncludes :Instance ;
  :code "LAND"^^ls:QueryCode ,
    "z3950.59"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :publication :country ) ;
  :category :shorthand ,
    :searchfilter ,
    :impliedByObject ,
    :pending .

<https://id.kb.se/ns/librissearch/publicationEndYear> a owl:DatatypeProperty ;
  rdfs:domain :Instance ;
  :category :searchfilter ,
    :shorthand ,
    :pending ;
  :label "end year"@en , "slutår"@sv ;
  owl:propertyChainAxiom ( :publication :endYear ) ;
  ls:filterDescriptionByLang "End year for serial resources"@en , "Slutår för seriella (fortlöpande) resurser"@sv ;
  :category :searchfilter ,
    :shorthand ,
    :pending .

<https://id.kb.se/ns/librissearch/publicationPlace> a owl:ObjectProperty ;
