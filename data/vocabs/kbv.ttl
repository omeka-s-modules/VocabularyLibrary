<https://id.kb.se/ns/librissearch/shelf> a owl:DatatypeProperty ;
  rdfs:domain :Item ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending ;
  ls:merges :shelfControlNumber ,
    :shelfLabel ,
    :physicalLocation ,
    :copyNumber ,
    [ owl:propertyChainAxiom ( :availability :label ) ] ,
    [ owl:propertyChainAxiom ( :shelfMark :label ) ] ;
  :category <https://id.kb.se/ns/librissearch/merged> ,
    :pending .

<https://id.kb.se/ns/librissearch/title> a owl:ObjectProperty ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "title"@en , "titel"@sv ;
  sdo:domainIncludes :Creation ;
  :code "TIT"^^ls:QueryCode ,
    "bath.title"^^ls:QueryCode ,
    "dc.title"^^ls:QueryCode ,
    "HTIT"^^ls:QueryCode ,
    "WUTI"^^ls:QueryCode ,
    "z3950.4"^^ls:QueryCode ,
    "z3950.6"^^ls:QueryCode ,
    "z3950.33"^^ls:QueryCode ,
    "z3950.1097"^^ls:QueryCode ;
  owl:propertyChainAxiom ( :translationOf :hasTitle ) ,
    ( :seriesMembership :inSeries :instanceOf :hasTitle ) ,
    ( :relationship :entity :hasTitle ) ,
    ( :hasPart :hasTitle ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :hasPart ] :translationOf :hasTitle ) ;
  :category :searchfilter ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/translator> a owl:ObjectProperty ;
  :category <https://id.kb.se/ns/librissearch/preferLike> ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending ;
  :label "translator"@en , "översättare"@sv ;
  sdo:rangeIncludes :BibliographicAgent ;
  sdo:domainIncludes :Work ;
  owl:propertyChainAxiom ( <https://id.kb.se/ns/librissearch/translatorContribution> :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :hasPart ] <https://id.kb.se/ns/librissearch/translatorContribution> :agent ) ,
    ( [ rdfs:domain :Work ;
        rdfs:subPropertyOf :relationship ] :entity <https://id.kb.se/ns/librissearch/translatorContribution> :agent ) ;
  :category <https://id.kb.se/ns/librissearch/preferLike> ,
    <https://id.kb.se/ns/librissearch/composite> ,
    :pending .

<https://id.kb.se/ns/librissearch/translatorContribution> a owl:ObjectProperty ;
  rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
          owl:hasValue <https://id.kb.se/relator/translator> ;
          owl:onProperty :role ] ] ;
  rdfs:domain :Work ;
  :category :pending ;
  rdfs:subPropertyOf :contribution .

