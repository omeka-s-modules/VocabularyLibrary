<https://id.kb.se/ns/librissearch/sab> a owl:DatatypeProperty ;
  :category :shorthand ,
    :pending ,
    :searchfilter ;
  :label "SAB classification"@en , "SAB-klassifikation"@sv ;
  ls:indexKey "classification._sab" ;
  sdo:domainIncludes :Work ;
  :code "z3950.20"^^ls:QueryCode ;
  owl:propertyChainAxiom ( [ rdfs:range [ rdfs:subClassOf [ a owl:Restriction ;
                owl:hasValue "kssb" ;
                owl:onProperty <https://id.kb.se/ns/librissearch/schemeCode> ] ] ;
        rdfs:subPropertyOf :classification ] :code ) ;
  ls:filterDescriptionByLang "Classification code according to the Swedish library classification system (SAB)."@en , "Klassifikationskod enligt klassifikationssystemet för svenska bibliotek (SAB)"@sv ;
