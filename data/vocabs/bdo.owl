<rdf:RDF
    xmlns:iiif2="http://iiif.io/api/presentation/2#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:iiif3="http://iiif.io/api/presentation/3#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:bdr="http://purl.bdrc.io/resource/"
    xmlns:bdg="http://purl.bdrc.io/graph/"
    xmlns:dct="http://purl.org/dc/terms/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:adm="http://purl.bdrc.io/ontology/admin/"
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:bdo="http://purl.bdrc.io/ontology/core/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:bda="http://purl.bdrc.io/admindata/">
  <owl:Ontology rdf:about="http://purl.bdrc.io/ontology/core/">
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Language/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/DateIndication/"/>
    <rdfs:label xml:lang="en">Buda core ontology</rdfs:label>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/PlaceType/"/>
    <dct:license rdf:resource="http://purl.bdrc.io/admindata/LicenseCC0"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/schemes/core/ContentMethodScheme/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/schemes/taxonomy/FEMCScheme/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Tradition/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Transliteration/"/>
    <rdfs:comment xml:lang="en">This is the core buda ontology comprising classes, and properties with domains and ranges</rdfs:comment>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/PaginationType/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/translations/CoreZhHans/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Script/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/schemes/core/IdentifierScheme/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Material/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/LangScript/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Format/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Binding/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/translations/CoreBo/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/LineageType/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Taxonomy/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/schemes/taxonomy/TraditionsScheme/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/PrintMethod/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/Gender/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/roles/Creator/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/roles/ChineseMonastic/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/WorkType/"/>
    <owl:imports rdf:resource="http://purl.bdrc.io/ontology/types/PartType/"/>
  </owl:Ontology>
  <rdfs:Datatype rdf:about="http://purl.bdrc.io/ontology/core/IntegerOrString">
    <owl:equivalentClass>
      <rdfs:Datatype>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </owl:equivalentClass>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://purl.bdrc.io/ontology/core/ISBN">
    <rdfs:isDefinedBy rdf:resource="https://www.isbn-international.org/sites/default/files/ISBN%20Manual%202012%20-corr.pdf"/>
    <bdo:dataTypeExpression>^(97(8|9))?\d{9}(\d|X)$</bdo:dataTypeExpression>
    <adm:userTooltip xml:lang="en">International Standard Book Number</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">The regex is does not take into account opitional blank, ' ', or dash, '-', chars separating the various groups. Also there is no spec for calculating the check digit</adm:technicalComment>
    <rdfs:label xml:lang="en">ISBN</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://purl.bdrc.io/ontology/core/LCCallNumber">
    <rdfs:seeAlso rdf:resource="https://www.loc.gov/catdir/cpso/lcco/"/>
    <rdfs:isDefinedBy rdf:resource="https://www.loc.gov/aba/publications/FreeCSM/freecsm.html"/>
    <bdo:dataTypeExpression rdf:resource="https://gist.github.com/kurtraschke/560162"/>
    <adm:userTooltip xml:lang="en">Library of Congress Call Number</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">LCCallNum</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://purl.bdrc.io/ontology/core/NoColophon">
    <adm:userTooltip xml:lang="en">Indicates that a Work has no colophon</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">Used to indicated that a Work has no colophon vs a Work for which the colophon has not been recorded in the metadata.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">no colophon</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://purl.bdrc.io/ontology/core/LCCN">
    <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="http://www.loc.gov/marc/lccn-namespace.html"/>
    <bdo:dataTypeExpression>[[a-z]|[[a-z][a-z]|dd]|[a-z][[a-z][a-z]|dd]|[a-z][a-z]dd]dddddddd</bdo:dataTypeExpression>
    <adm:userTooltip xml:lang="en">Library of Congress Control Number</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label>LCCN</rdfs:label>
  </rdfs:Datatype>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IncipitTitle">
    <adm:userTooltip xml:lang="en">the title as given, inline, at the beginning of the text</adm:userTooltip>
    <rdfs:label xml:lang="en">Incipit Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ContentLocation">
    <adm:userTooltip xml:lang="en">The ContentLocation describes the Instance, Volume, Page and so on at which something of interest occurs, e.g., the beginning or end of a Work that is contained in another Work; or a reference to the source of a Lineage</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :WorkLocation</adm:technicalComment>
    <adm:technicalComment xml:lang="en">The following explains the intent of splitting an Outline into chunks when outlining very large works. This is why there is a &lt;o:location/&gt; element spec'd in the outline.xsd; however, this feature has not been used in this manner but rather as a redundant marker of which work is being outlined. In the case that the Outline is the detail of a particular Text then the location typically will specify the Work and Volume (relative to 1) that contains the Outlined Text. Thus Locations on the sub-structure need only mention page, line and phrase</adm:technicalComment>
    <adm:technicalComment xml:lang="en">Parent facet of Work locations by page and folio. The XSD defn is located in common.xsd but is move to Work in the new ontology since that is a more appropriate location</adm:technicalComment>
    <rdfs:label xml:lang="en">Content Location</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOrPlace">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Person"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Place"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">domain of :DDBCAId which is used to record ids of Dharma Drum authority resources</rdfs:comment>
    <rdfs:label xml:lang="en">person or place</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonPrimaryTitle">
    <adm:userTooltip xml:lang="en">The primary or common title by which a Person is known.</adm:userTooltip>
    <rdfs:label xml:lang="en">Primary Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AgentInRole">
    <adm:userTooltip xml:lang="en">property linking an entity or event to the agents and roles they play</adm:userTooltip>
    <adm:technicalComment xml:lang="en">:AgentInRole represents some :Agent performing an action in a particular :Role in a context represented by the subject and property that refer to the :AgenInRole</adm:technicalComment>
    <rdfs:label xml:lang="en">agent</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ChineseDate">
    <adm:userTooltip xml:lang="en">The class of DILA Chinese date individuals</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Chinese date type</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Date"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CopyEvent">
    <adm:userTooltip xml:lang="en">An event of copying a work by some means such as manual enscribing, photocopying, etc.</adm:userTooltip>
    <rdfs:label xml:lang="en">copied</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CarvedEvent">
    <adm:userTooltip xml:lang="en">The event of carving a work (in woodblocks, stone, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">Carved</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonFinalOrdinationName">
    <adm:userTooltip xml:lang="en">The name given to a Person upon their receiving final ordination</adm:userTooltip>
    <rdfs:label xml:lang="en">Final Ordination Name</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Place">
    <adm:userTooltip xml:lang="en">Places are geographic entities such as: monasteries, villages, counties, rivers, caves and so on</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Names are represented by rdfs:label.</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">Places are geographic entities such as: monasteries, villages, counties, provinces, rivers, caves and so on. Places are modeled in terms of subclasses that indicate the type of "real world" place that is referred to</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Entity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonPenName">
    <adm:userTooltip xml:lang="en">name used by the author in the colophons of his works</adm:userTooltip>
    <rdfs:label xml:lang="en">Pen Name</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOfficeTitle">
    <adm:userTooltip xml:lang="en">The Title of a Person occupying a given office</adm:userTooltip>
    <rdfs:label xml:lang="en">Office Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOrTopic">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Person"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Topic"/>
    </owl:unionOf>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:comment xml:lang="en">deprecated in favor of :SingleAgent. The domains of the affected properties will be adjusted to :SingleAgent</rdfs:comment>
    <rdfs:comment xml:lang="en">Used as the domain for several properties that may refer to either a :Person or an ahistorical agent represented as a :Topic</rdfs:comment>
    <rdfs:label xml:lang="en">person or topic</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOccupiesSeat">
    <adm:userTooltip xml:lang="en">The Event of a Person occupying a Seat</adm:userTooltip>
    <rdfs:label xml:lang="en">Occupies Seat</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SpineTitle">
    <adm:userTooltip xml:lang="en">title indicated on the spine of a book</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">use for titles indicated on the spine of a book when it differs from the bibliographical title.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Spine Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonGterStonTitle">
    <adm:userTooltip xml:lang="en">The title bestowed upon a Person who has discovered a terma</adm:userTooltip>
    <rdfs:label xml:lang="en">Terton Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Lineage">
    <rdfs:seeAlso rdf:resource="https://link.springer.com/article/10.1023%2FA%3A1004844115222?LI=true"/>
    <adm:userTooltip xml:lang="en">A (transmission) lineage is a collectiomn of sequences of lineage holders passing a lineage through time</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Names are represented by rdfs:label</adm:technicalComment>
    <adm:technicalComment xml:lang="en">Example:

bdr:L8LS15684 a :Lineage ; :status bdr:StatusReleased ;
      rdfs:label "mngon rtogs rgyan gyi 'grel pa don gsal gyi brgyud pa/"@bo-x-ewts ;
      :lineageType bdr:LineageLung ;
      :lineageObject bdr:W21662 ;
      :lineageObject bdr:T36 ;
      :lineageLocation [ a :ContentLocation ;
            :contentLocationPage "131" ;
            :contentLocationVolume "1" ;
            :contentLocationWork bdr:W1KG16278 ]
      :lineageHolder [ a :LineageHolder ;
            :lineageWho bdr:T10MS11142 ]
      :lineageHolder [ a :LineageHolder ;
            :lineageWho bdr:T681 ;
            :lineageReceived [ a :LineageReceived ;
                  :lineageFrom bdr:T10MS11142 ]
            ]
      :lineageHolder [ a :LineageHolder ;
            :lineageWho bdr:P6117 ;
            :lineageReceived [ a :LineageReceived ;
                  :lineageFrom bdr:T681 ]
            ]</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">Lineages represent information about how a particular text or group of texts or perhaps purely oral transmission has been passed from one individual to another. The Tibetan genres, gsan yig and thob yig.

Lineage transmissions capture the relationship between lineage holders, sets of texts and the places and dates where/when the lineage was transferred from one holder to another.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Lineage</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Entity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonMarriage">
    <adm:userTooltip xml:lang="en">The Event of a Person becoming married to another Person</adm:userTooltip>
    <rdfs:label xml:lang="en">Marriage</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ThirdRevisedEvent">
    <adm:userTooltip xml:lang="en">An event describing the third revision of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Third revision</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName">
    <adm:userTooltip xml:lang="en">A Person Name is one of the names a Person is historically known by</adm:userTooltip>
    <adm:technicalComment xml:lang="en">:PersonName is one or many authority names of :Person. :PersonName is represented by an rdfs:label and a subclass of :PersonName (which signifies the type of person name). For example: 

    bdr:P1583 a :Person ; 
        :personName 
            [ a bdr:PersonPrimaryName ; 
              rdfs:label "dri med 'od zer"@bo-x-ewts ] .</adm:technicalComment>
    <rdfs:label xml:lang="en">person name</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Label"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ThirdTranslatedEvent">
    <adm:userTooltip xml:lang="en">An event describing the third translation of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Third translation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Topic">
    <adm:userTooltip xml:lang="en">Subjects and genres of works, just as in a traditional library catalog</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Names are represented by rdfs:label</adm:technicalComment>
    <rdfs:label xml:lang="en">Topic</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Entity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/RevealedEvent">
    <adm:userTooltip xml:lang="en">An event describing the discovery of a work (for terma revelations)</adm:userTooltip>
    <rdfs:label xml:lang="en">revealed</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SpecialCollection">
    <adm:userTooltip xml:lang="en">A collection maintained by a Library</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Special Collection</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstitutionalCollection"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SerialInstance">
    <adm:userTooltip xml:lang="en">An instance of a SeriesMember.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was SerialWork, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">Series Member instance</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOtherName">
    <adm:userTooltip xml:lang="en">an otherwise unspecified type of person name</adm:userTooltip>
    <rdfs:label xml:lang="en">Other Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TranslatedEvent">
    <adm:userTooltip xml:lang="en">An event of work translation.</adm:userTooltip>
    <rdfs:label xml:lang="en">Translation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Type">
    <adm:userTooltip xml:lang="en">Types are used to indicate features names, titles, events and so on.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">Types are used to indicate features names, titles, events and so on.

An owl:subClassOf :Type, e.g., :KinType, will have some set of individuals that represent the various types, e.g., bdr:KinUncle, bdr:KinYoungerSister, etc.

The set of such individuals may be further organized via :Taxonomy but need not be.</adm:technicalComment>
    <rdfs:label xml:lang="en">Type</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ObjectType">
    <adm:userTooltip xml:lang="en">Print type indicates the form of the Work such as blockprint, palm-leaf, manuscript, and so on</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">ObjectType describes how the witness came to be. For example, it could have been written by the author, an Autograph; it could have been printed from wood blocks, a BlockPrint; it could have been OCR'd from some other witness; and so on.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">print type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ToCTitle">
    <adm:userTooltip xml:lang="en">A title for a work as it occurs in the table of contents for a Work.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Use this type for titles in table of contents when they differ from the bibliographical title.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Table of Contents Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/OtherTitle">
    <adm:userTooltip xml:lang="en">Title that a work is known by other than one of the defined title types</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">when a work is known by different titles, the main one is recorded by :WorkBibliographicalTitle and the others with :WorkOtherTitle. This should mainly be used with abstract works.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Other Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/DigitalInstance">
    <rdfs:label xml:lang="en">Digital instance</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CoverTitle">
    <adm:userTooltip xml:lang="en">Title printed on the cover of a Work or text as issued</adm:userTooltip>
    <rdfs:label xml:lang="en">Cover Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonAffiliation">
    <adm:userTooltip xml:lang="en">Event indicating the Person becoming affiliated with a lineage or organization</adm:userTooltip>
    <rdfs:label xml:lang="en">Affiliation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Entity">
    <adm:userTooltip xml:lang="en">Entities are the principle types or concepts in the BDRC ontology. Individuals of type subclass of :Entity will correspond to distinct individuals in the domain of discourse of BDRC, such as Persons, Places, and Works.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonLeavesOffice">
    <adm:userTooltip xml:lang="en">The Event of a Person leaving an Office</adm:userTooltip>
    <rdfs:label xml:lang="en">Leaves Office</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIFManifest">
    <adm:userTooltip xml:lang="en">can be v2.1.* or v3.0.*</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">IIIF Manifest</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIFEntity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CopyrightPageTitle">
    <rdfs:seeAlso rdf:resource="https://www.loc.gov/publish/cip/news/lccn_art.html"/>
    <adm:userTooltip xml:lang="en">Title appearing on the copyright page of a Work, if present.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">use for the title on the copyright page when it differs from the bibliographical title.</adm:catalogingConvention>
    <adm:catalogingConvention xml:lang="en">The Copyright Page Title is found on the Cataloging in Publication (CIP) when present. The CIP is typically on the verso of the Title Page in Western publications and often at the end for Chinese pubications. The title should be entered in the language and script as it appears in the original publication - which for Chinese publications is typically zh-hans. The Library of COngress standard for the Title in the CIP is that it includes the title and any subtitle from the title page so for Western materials this data element is redundant with the full :WorkTitlePageTitle and can be ignored for cataloging. For Chinese materials, especially Tibetan publications, the CIP title is typically distinct from that which appears on the Title Page and hence this data can be helpful in distinguishing the Work from others. 

In general include the use Copyright Page Title when it differs from the bibliographical title.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Copyright page Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PublishedEvent">
    <adm:userTooltip xml:lang="en">An event describing the publication of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Published</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BundleInstance">
    <adm:userTooltip xml:lang="en">An instance that is a bundle of unrelated instances that were not designed to be in the same package. It typically has no associated work.</adm:userTooltip>
    <rdfs:label xml:lang="en">bundle instance</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SecondTranslatedEvent">
    <rdfs:label xml:lang="en">Second translation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/OriginatedEvent">
    <adm:userTooltip xml:lang="en">The event of origin of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">originated</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Etext">
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:technicalComment xml:lang="en">The :Etext :Entity represents a searchable Unicode text file ("eText"). In BUDA, eTexts are comprised of a base layer + at least one archival annotation layer, plus other annotation layers for different uses.  The base layer is a raw Unicode text file. The base layer contains Unicode text and line breaks that form a coordinate system.  The coordinate system includes a sequence number, position of start character and end character. The coordinate system is defined in the archival annotation layer.

The RDF representation of :Etext is derived from the base layer, a graph definining the coordinate system :EtextNonPaginated or :EtextPaginate, and a graph for the :ItemEtext that references the volume of the :ItemEtext. 

There will also be information such as a URI to the original source file, if applicable. For Tibetan, these typically are Sambhota Word or Tibet Doc files.

The reference to the containing :ItemEtext is a URI formed by appending the volume index to the :ItemEtext URI, like:

     :eTextInVolume bdr:I1KG443_003/volume/3

This URI refers to a volume blank node contained in the referenced Item.

Search chunks in the :Etext are derived from the original Unicode eText stream by breaking the stream at such locations to minimize the likelihood that the likely search terms will be broken across chunk boundaries. In Tibetan this is achieved by breaking the stream after the nearest shad codepoint following something like 300 tsegs. This assumes that most searches will not extend beyond a phrase boundary delimited by a shad (note there are actually a family of codepoints that count as shad in the Tibetan Unicode plane).

Each chunk is a blank node containing the chunk id - which is a virtual id serving only to order the sequence of contents to reassemble the original eText content, like:

    [ a EtextChunk ;
      :eTextChunk 3 ;
      :chunkContents ". . . the text contained in chunk 3 . . ." ]

If the chunk is from an OCR'd text, then there is additional information indicating the starting chunk and character, and ending chunk and character for each page in the :ItemImageAsset from which the OCR'd material was derived. For example,

     [ a EtextPage ; :slice 46 ; 
       :sliceStartChunk 43 ; 
       :sliceStartChar 17 ;
       :sliceEndChunk 44 ;
       :sliceEndChar 138 ]

The character counts are in terms of Unicode codepoints in whatever representation is used, typically, UTF-8.</adm:technicalComment>
    <rdfs:label xml:lang="en">eText</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceDestroyed">
    <adm:userTooltip xml:lang="en">event type describing when a place was destroyed</adm:userTooltip>
    <rdfs:label xml:lang="en">destroyed</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/LineageEvent">
    <rdfs:seeAlso>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    </rdfs:seeAlso>
    <adm:userTooltip xml:lang="en">An event associated with the transmission of a lineage, such as giving/receiving an empowerment or oral transmission, and so on</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Each :LineageReceived describes another :LineageHolder from whom the current :LineageHolder received the :Lineage transmission. Typically there is a unique :LineageHolder from whom the :Lineage is received but two or more are possible.

For example,

bdr:Lwwww a :Lineage ;
                   :lineageHolder
                       [ a :LineageHolder ;
                         :lineageWho bdr:Paaaa ;
                         :lineageReceived
                              [ a :LineageReceived ;
                                :lineageFrom bdr:Pbbbb ;
                                :lineageSite bdr:Gdddd ;
                                :onOrAbout "134u" ] ;
                          :lineageWork bdr:Wcccc ]</adm:technicalComment>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AhistoricalAgent">
    <adm:userTooltip xml:lang="en">An ahistorical agent may be a deity or other non-human agent that is said to exist outside of human history</adm:userTooltip>
    <rdfs:label xml:lang="en">Ahistorical agent</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SingleAgent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/MonasticCollection">
    <adm:userTooltip xml:lang="en">A collection maintained by a monastery</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Monastic Collection</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstitutionalCollection"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonAssumesOffice">
    <adm:userTooltip xml:lang="en">Event indicating a Person assuming an office such as Professor, Postmaster or General</adm:userTooltip>
    <rdfs:label xml:lang="en">Assumes office</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Item">
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">An Item captures structural and administrative metadata associated with a digital or physical asset</adm:userTooltip>
    <adm:technicalComment xml:lang="en">:Item captures the structural and administrative metadata associated with a digital or physical asset. While this ontology is primarily concerned with digital assets of texts, :Item could easily be extended to other types of digital assets such as audio and video; as well as physical assets, such as the physical holdings of libraries.</adm:technicalComment>
    <rdfs:label xml:lang="en">Item</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonTulkuTitle">
    <adm:userTooltip xml:lang="en">A title bestowed on a Person who is recognized as a reincarnation of a distinguished Person</adm:userTooltip>
    <rdfs:label xml:lang="en">Tulku Title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Organization">
    <adm:userTooltip xml:lang="en">An organization is a collection of agents organized as a single entity such as a monastery, governing body, and so on</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">An :Organization is a collection of agents that may be considered act in concert as a single agent, e.g., the kashag or the dzogchen protectors taken together: Ekazati, Rahulla, and Dorje Drollo

An administrative organization is one that is not a subject of the domain of discourse. For example, the British Library's Endangered Archives Programme (EAP) is an administrative organization and the sde dge par khang can be considered an :Organization since it is an entity within the domain of Asian Buddhism.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Agent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/GeneralNote">
    <adm:userTooltip xml:lang="en">A general note contains non-specific information about some resource</adm:userTooltip>
    <rdfs:label xml:lang="en">General note</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Note"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Subtitle">
    <adm:userTooltip xml:lang="en">Title that is explanatory. Typically following the main Title Page Title or Cover Title</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Title that is explanatory. Typically following the main Title Page Title or Cover Title</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Subtitle</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Label">
    <rdfs:label xml:lang="en">Label</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonFirstOrdinationName">
    <adm:userTooltip xml:lang="en">The name given to a Person upon their receiving first ordination</adm:userTooltip>
    <rdfs:label xml:lang="en">First Ordination Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/RequestedEvent">
    <adm:userTooltip xml:lang="en">An event describing the request for a work</adm:userTooltip>
    <rdfs:label xml:lang="en">requested</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TitlePageTitle">
    <adm:userTooltip xml:lang="en">Title that appears on the title page of a Work</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">(1) Title that appears on the title page of a Work; (2) Title of an Individual Work or text that is part of a larger containing Work. Should be included when available. May also be used as the Bibliographic title when no other title is available.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Title page title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonDivorce">
    <adm:userTooltip xml:lang="en">Event occurring upon a divorce of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">Divorce</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Collection">
    <adm:userTooltip xml:lang="en">Designates a collection of Bibliographic entities</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Person">
    <adm:userTooltip xml:lang="en">A Person resource tracks biographical metadata such as names/titles, kinship relations, birth and death events, and so on</adm:userTooltip>
    <adm:technicalComment xml:lang="en">names are represented via bdo:PersonName</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">A Person resource tracks biographical metadata such as kinship relations, birth and death dates, administrative offices  and seats held, important events and known name variants.  Instances of Person resources are not created for a-historical or quasi-historical personages, including legendary and mythical figures. Deities are defined as Topics.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SingleAgent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/LineageHolder">
    <adm:userTooltip xml:lang="en">A lineage holder is a Person that is considered to be an authoritative conveyer of a transmission lineage</adm:userTooltip>
    <adm:technicalComment xml:lang="en">A :LineageHolder describes a :Person or other :Entity (i.e., a deity or mythical being) that was/is considered to be the authoritative transmitter of a :Lineage.

Usually the holder received the :Lineage from some other entity but there is a "first" holder who counts as the original holder of the :Lineage.

A holder may create/author one or more Works concerning the Lineage and these are included with the holder as well as the, usually unique, prior holder of the lineage who transmitted it on to the current holder.

The :LineageReceived records the entity from whom the :Lineage was received, as well as the :Place where the :Lineage was transmitted to the current holder and the circa of the transmission if known.

For example,

bdr:Lwwww a :Lineage ;
                   :lineageHolder
                       [ a :LineageHolder ;
                         :lineageWho bdr:Paaaa ;
                         :lineageReceived
                              [ a :LineageReceived ;
                                :lineageFrom bdr:Pbbbb ;
                                :lineageSite bdr:Gdddd ;
                                :onOrAbout 134u ] ;
                          :lineageWork bdr:Wcccc ]</adm:technicalComment>
    <rdfs:label xml:lang="en">lineage holder</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMemberMonastic">
    <adm:userTooltip xml:lang="en">An member of a monastic organization</adm:userTooltip>
    <rdfs:label xml:lang="en">Monastic member</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMember"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SecondRevisedEvent">
    <adm:userTooltip xml:lang="en">An event describing the second revision of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Second revision</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonFinalOrdination">
    <adm:userTooltip xml:lang="en">The Event of a Person receiving their final ordination</adm:userTooltip>
    <rdfs:label xml:lang="en">Final Ordination</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TranslationRevisedEvent">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">Event describing a revision of a Work</adm:userTooltip>
    <adm:replaceWithClass>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/RevisedEvent"/>
    </adm:replaceWithClass>
    <rdfs:label xml:lang="en">Revision of a translation</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonFamilyName">
    <adm:userTooltip xml:lang="en">The name of a Person's family. Surname</adm:userTooltip>
    <rdfs:label xml:lang="en">Family Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceFounded">
    <adm:userTooltip xml:lang="en">event type describing when a place was founded</adm:userTooltip>
    <rdfs:label xml:lang="en">founded</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonLeavesSeat">
    <adm:userTooltip xml:lang="en">The Event of a Person leaving a Seat</adm:userTooltip>
    <rdfs:label xml:lang="en">Leaves Seat</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ImageInstance">
    <adm:userTooltip xml:lang="en">An item comprised of digitized images of the pages of a Work</adm:userTooltip>
    <adm:technicalComment xml:lang="en">A digitized set of pages, one per page (folio side), produced by document scanning, digital photography.  The resulting set of assets in :ItemImageAsset are images in a wide variety of archival and derivative formats.</adm:technicalComment>
    <rdfs:label xml:lang="en">Image Instance (Scans)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/DigitalInstance"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonSecretInitiatoryName">
    <adm:userTooltip xml:lang="en">A name bestowed on Person upon receiving certain empowerments</adm:userTooltip>
    <rdfs:label xml:lang="en">Secret Initiatory Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceAbandoned">
    <adm:userTooltip xml:lang="en">event type describing when a place was abandonded</adm:userTooltip>
    <rdfs:label xml:lang="en">abandonded</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEvent">
    <adm:userTooltip xml:lang="en">An Event associated with the Person such as birth, death, ordination, and so on</adm:userTooltip>
    <adm:technicalComment xml:lang="en">A Person Event describes place, date and other relevant information related to some significant event such as ordination, marriage, birth, death and so on.

The type of event is represented as a subclass of :PersonEvent</adm:technicalComment>
    <rdfs:label xml:lang="en">Person Event</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ItemMicrofilmAsset">
    <adm:userTooltip xml:lang="en">An :ItemMicrofilmAsset describes the physical microfilm from which the associated Instance was digitized.</adm:userTooltip>
    <rdfs:label xml:lang="en">Item microfilm asset</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BiblioEntity">
    <adm:userTooltip xml:lang="en">The :BiblioEntity Class models the descriptive metadata about a "book" in the BUDAverse.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was Work, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">BiblioEntity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AgentsOrAgentInRole">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Agents"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AgentInRole"/>
    </owl:unionOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextChunk">
    <adm:userTooltip xml:lang="en">A unit of searchable etext</adm:userTooltip>
    <rdfs:label xml:lang="en">eText chunk</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOriginName">
    <adm:userTooltip xml:lang="en">Name associated with the person's place of origin. This is specific to a few socio linguistic contexts, such as the Burmese one.</adm:userTooltip>
    <rdfs:label xml:lang="en">Origin name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Volume">
    <adm:userTooltip xml:lang="en">A volume is a self-contained set of pages/folia.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">There are subclasses of Volume corresponding to the different types of holding: physical, digitized images, and unicode etexts.

Each :Volume corresponds to a volume an associated :Work. A :Volume may have a :onDisk property present when the Volume has been digitized and deposited in the online archive.</adm:technicalComment>
    <rdfs:label xml:lang="en">Volume</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextSlice">
    <adm:userTooltip xml:lang="en">A slice of text is a character range, used to identify portions of an Etext for any purpose: correspondence with original pages, lines, etc.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">slice</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Corporation">
    <adm:userTooltip xml:lang="en">Corporation defines important social institutions. For instance in Tibet those that (1) owned land and (2) had members. Examples include families and monastic institutions</adm:userTooltip>
    <adm:technicalComment xml:lang="en">The Names of individual Corporations are represented by rdfs:label</adm:technicalComment>
    <rdfs:label xml:lang="en">Corporation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Organization"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/RunningTitle">
    <skos:altlabel xml:lang="en">Marginal title</skos:altlabel>
    <adm:userTooltip xml:lang="en">Title indicated in the margins or page headers of a Work.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Title as it appears in the margins or page headers of a Work</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Running Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ColophonTitle">
    <adm:userTooltip xml:lang="en">Title given in the colophon of a Work or text</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Title given in the colophon of a Work or text. Include when the title differs from the th full title or title page title</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Colophon Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextPaginated">
    <adm:userTooltip xml:lang="en">An etext with associated pagination information corresponding to digitized images of a Work</adm:userTooltip>
    <rdfs:label xml:lang="en">Paginated Etext</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SerialWork">
    <rdfs:seeAlso rdf:resource="https://www.abc-clio.com/ODLIS/odlis_S.aspx?#serial"/>
    <adm:userTooltip xml:lang="en">An Work representing a series of volumes/numbers published over time</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was SerialWork now split into an (abstract) Work Class and an Instance Class, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">Series</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Work"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TulkuLine">
    <skos:prefLabel xml:lang="bo-x-ewts">skye brgyud</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Tulku line</skos:prefLabel>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Role"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonMonasteryName">
    <adm:userTooltip xml:lang="en">Monastic name associated with the person's monastery of residence. This is specific to a few socio linguistic contexts, such as the Burmese one.</adm:userTooltip>
    <rdfs:label xml:lang="en">Residence Monastery name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonMonasticPositionName">
    <adm:userTooltip xml:lang="en">Monastic name of the person that is associated with the person's position in monastic hierarchy or sectarian groups. This is specific to a few socio linguistic contexts, such as the Burmese one.</adm:userTooltip>
    <rdfs:label xml:lang="en">Residence Monastery name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEventNotSpecified">
    <adm:userTooltip xml:lang="en">indicates a Place Event of unknown type!?</adm:userTooltip>
    <rdfs:label xml:lang="en">not specified</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextPage">
    <adm:userTooltip xml:lang="en">An indication of correspondence with a page of a physical/image page.</adm:userTooltip>
    <rdfs:label xml:lang="en">page</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/EtextSlice"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AgentAsCreator">
    <adm:userTooltip xml:lang="en">An agent as creator establishes a given Agent performing some cretation rolw w.r.t. a Work</adm:userTooltip>
    <adm:technicalComment xml:lang="en">:AgentAsCreator has :role that is restricted to instances of :Creator (rdfs:subClassOf :Role)</adm:technicalComment>
    <rdfs:label xml:lang="en">creator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/AgentInRole"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TextualEntity">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Etext"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Item"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">:TextualEntity is a subclass of :Work, or :Item or :Etext that is constructed so that the adm:license range can be applied across</rdfs:comment>
    <rdfs:label xml:lang="en">textual entity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CompiledEvent">
    <adm:userTooltip xml:lang="en">The event of compiling / editing a work (mostly collections)</adm:userTooltip>
    <rdfs:label xml:lang="en">compiled</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonNameOrBiblioTitle">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonName"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">domain of :restored and :restoredAlt that are used for name and title variants restored from corrupt textual content</rdfs:comment>
    <rdfs:label xml:lang="en">person name or title of a bibliographic entity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextVolume">
    <rdfs:label xml:lang="en">Etext Volume</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonVariantOrthography">
    <adm:userTooltip xml:lang="en">An accepted variant writing of a name</adm:userTooltip>
    <rdfs:label xml:lang="en">variant orthography</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonTitle">
    <adm:userTooltip xml:lang="en">an otherwise unspecified type of person title</adm:userTooltip>
    <rdfs:label xml:lang="en">other title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIFCollection">
    <adm:userTooltip xml:lang="en">can be v2.1.* or v3.0.*</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">IIIF Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/IIIFEntity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/FullTitle">
    <adm:userTooltip xml:lang="en">Title on the first page of the text of the Tibetan traditional Pecha format.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Title on the first page of the text of the Tibetan traditional Pecha format. 

Often the Title Page Title for a publication of a reproduction that includes prefatory material distinct from the main Tibetan content is different from the Tibetan title that appears on the first page of the content. See for instance, bdr:W22505</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Full Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ReconstructedTitle">
    <adm:userTooltip xml:lang="en">a title that does not appear in the original artefact</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Reconstructed Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstitutionalCollection">
    <adm:userTooltip xml:lang="en">A collection maintained by an institution</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Institutional Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextNonPaginated">
    <adm:userTooltip xml:lang="en">An etext without any associated pagination information corresponding to digitized images of a Work</adm:userTooltip>
    <rdfs:label xml:lang="en">Non Paginated Etext</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ArchivesCollection">
    <adm:userTooltip xml:lang="en">A collection maintained by a national archive</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Archives Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/InstitutionalCollection"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/VirtualInstance">
    <adm:userTooltip xml:lang="en">Virtual works are works made by assembling different other works.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Virtual works are works made by assembling different other works. Examples: collections, manuscripts reconstituted from fragments in different collections, etc. The hierarchy of works displayed in an embedded reader is also a virtual work.</adm:technicalComment>
    <rdfs:label xml:lang="en">Virtual work</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/BundleInstance"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ImageGroup">
    <adm:userTooltip xml:lang="en">Represents a scanned or otherwise digitized set of page images.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Each :ImageGroup represents a group of images. Most of the time these would correspond to volumes / bundles.

Alternatively, a :ImageGroup may have an :hasManifest property that identifies an :IIIFManifest resource. This will typically occur when the images associated with the :ImageGroup are served from a third-party IIIF server.</adm:technicalComment>
    <rdfs:label xml:lang="en">Image Group</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/OriginalCopyEvent">
    <adm:userTooltip xml:lang="en">An event of originally copying the text. Happens in some contexts (ex: Burmese), where manuscripts can have an attributed original scribe (acring somewhat as an editor) even though the physical copy we have is a copy of the 'original' copy.</adm:userTooltip>
    <rdfs:label xml:lang="en">Originally copied</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceRebuilt">
    <adm:userTooltip xml:lang="en">event type describing when a place was rebuilt</adm:userTooltip>
    <rdfs:label xml:lang="en">rebuilt</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EntitiesOrFacets">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Entity"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIFEntity"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">class of various resources that may have :Note attached</rdfs:comment>
    <rdfs:label xml:lang="en">entity or facet</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkCollection">
    <adm:userTooltip xml:lang="en">A work that is made of a collection of other works (ex: gsung bum, canonical collection, etc.).</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was AbstarctWork, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">collection</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Work"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PrivateCollection">
    <adm:userTooltip xml:lang="en">A collection maintained by a private individual or organization</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</adm:translationPriority>
    <rdfs:label xml:lang="en">Private Collection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Agent">
    <adm:userTooltip xml:lang="en">an entity that performs actions, e.g., creating works, teaching other agents, founding artificial places and so on</adm:userTooltip>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Note">
    <adm:userTooltip xml:lang="en">A comment about the subject resource, possibly with a source Work and a location in the Work</adm:userTooltip>
    <rdfs:label xml:lang="en">Note</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonFlourished">
    <adm:userTooltip xml:lang="en">When a person's activity occured (less specific than birth or date)</adm:userTooltip>
    <rdfs:label xml:lang="en">Flourished</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextRef">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">links an etext volume to its various etexts (often 1)</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Used as a reference from a :VolumeEtextAsset to a particular :Etext, via :eTextResource, and indicating the position, :seqNum, of the :Etext in the volume.</adm:technicalComment>
    <rdfs:label xml:lang="en">etext</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIF2Or3Manifest">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="http://iiif.io/api/presentation/2#Manifest"/>
      <rdf:Description rdf:about="http://iiif.io/api/presentation/3#Manifest"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">iiif v2 or v3 manifest</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/VolumeEtextAsset">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">A searchable etext volume versus a physical or digitized pzges images.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">This serves as a blank node that represents an actual volume corresponding to a volume of a printed/pubished Work OR a virtual volume of all of the eTexts contained in a printed/published Work.

The ambiguity arises because in some cases we do not have know the actual volume or volume order of a collection of input eTexts that have been provided for preservation. 

An example is the Guru Lama collection of Sakyapa eTexts. These were all input and used to prepare printed pechas that were distributed but when the files were supplied the correspondence of files to volumes and the order of the files in volumes was not provided. Therefor we have simply represented each Work as a single virtual volume with a collection of files in some order. Later it should be possible to analyze these particular Works to establish the volume and order within volume of the various eTexts by examining the titles and so on.

There is no distinction between OCR'd and input volumes.</adm:technicalComment>
    <rdfs:label xml:lang="en">Etext Volume</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/RevisedEvent">
    <adm:userTooltip xml:lang="en">An event describing the revision of a work</adm:userTooltip>
    <rdfs:label xml:lang="en">revision</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ProvenanceNote">
    <adm:userTooltip xml:lang="en">note indicating the provenance of an information</adm:userTooltip>
    <rdfs:label xml:lang="en">Provenance note</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Note"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonInResidence">
    <adm:userTooltip xml:lang="en">The Event of a Person establishing residence in a Place such as a Monastery, Cave, and so on</adm:userTooltip>
    <rdfs:label xml:lang="en">In Residence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/TitlePortion">
    <adm:userTooltip xml:lang="en">Title that is abbreviated, condensed, divided from the main title</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">A Title that is abbreviated, condensed, divided from the main title</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Title portion</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CompletedEvent">
    <adm:userTooltip xml:lang="en">The event of completing a work</adm:userTooltip>
    <rdfs:label xml:lang="en">completion</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonDeath">
    <adm:userTooltip xml:lang="en">Death Event for a Person</adm:userTooltip>
    <rdfs:label xml:lang="en">Death</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonCorporateName">
    <adm:userTooltip xml:lang="en">Name by which a Person is known by virtue of their position within an Organization</adm:userTooltip>
    <rdfs:label xml:lang="en">Organization Position Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonRabByungOrdination">
    <adm:userTooltip xml:lang="en">A preliminary to monastic ordination, when someone takes the five root vows</adm:userTooltip>
    <rdfs:label xml:lang="bo-x-ewts">rab byung</rdfs:label>
    <rdfs:label xml:lang="en">Preliminary Ordination</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonGterMaDiscovery">
    <adm:userTooltip xml:lang="en">The Event of a Person discovering a terma</adm:userTooltip>
    <rdfs:label xml:lang="en">Discovers Terma</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonBirth">
    <adm:userTooltip xml:lang="en">Birth Event for a Person</adm:userTooltip>
    <rdfs:label xml:lang="en">Birth</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Work">
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">An abstract or conceptual work is the idea of a work, as opposed to an expression or manifestation which is a specific edition or witness.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was AbstarctWork, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">work</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/AuthoredEvent">
    <adm:userTooltip xml:lang="en">The event of authoring a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Authored</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance">
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">An expression of a work, for instance a particular published form.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was Work, changed to align with Bibframe 2.0</adm:technicalComment>
    <adm:technicalComment xml:lang="en">Was PublishedWork, changed to align with Bibframe 2.0</adm:technicalComment>
    <rdfs:label xml:lang="en">Instance (Version)</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SerialMember">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">The Work metadata about a member of a :SerialWork</adm:userTooltip>
    <adm:technicalComment xml:lang="en">The (abstract) :SeriesNumber resource contains the Work metadata associated with a number of a :SerialWork  </adm:technicalComment>
    <adm:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/SerialInstance"/>
    <rdfs:label xml:lang="en">Series Member</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/HalfTitle">
    <adm:userTooltip xml:lang="en">Title of a publication appearing on a page or folio preceding the title page.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Title of a publication appearing on a page or folio preceding the title page. Include when present as a distinguishing item of information. The half title page may be missing from later reproductions of a work, Typically the half title is the main title w/o additional subtitling.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Half Title</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Agents">
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Agent"/>
      <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
    </owl:unionOf>
    <adm:userTooltip xml:lang="en">The various sorts of agents represented in the ontology, such as Persons, Organizations and so on</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Agents</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceEvent">
    <adm:userTooltip xml:lang="en">An event of some type that occurred at the subject Place around some date, involving some Persons and other entities: founding, destruction etc.</adm:userTooltip>
    <rdfs:label xml:lang="en">Place Event</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Title">
    <adm:userTooltip xml:lang="en">A title by which is known or referenced.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">A title for the Work including the title text and title type: full, sub, etc:


bdr:W22083 a :Work ;
      :workHasTitle [ a :WorkBibliographicalTitle ;
            rdfs:label "bka' 'gyur (stog pho brang bris ma/)"@bo-x-ewts ] ,
          [ a :WorkOtherTitle ;
            rdfs:label "la dwags tog mu mkhar bzhugs pa'i bod yig bka' 'gyur bris ma/"@bo-x-ewts ] ,
          [ a :WorkTitlePageTitle ;
            rdfs:label "the tog palace manuscript of the tibetan kanjur"@en ] .</adm:technicalComment>
    <rdfs:label xml:lang="en">Title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Label"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Role">
    <adm:userTooltip xml:lang="en">Roles include offices held as well as other positions.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Names are represented by rdfs:label</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">Roles include offices held as well as other positions. Roles was formerly called Office in the tbrc.org XML schema. Roles is prefered as a more commonly used concept in libraries.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Role</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SingletonInstance">
    <adm:userTooltip xml:lang="en">An instance that has only one copy (ex: a manuscript, an art work, etc.). A singleton instance may have reproductions</adm:userTooltip>
    <rdfs:label xml:lang="en">singleton instance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMemberByMarriage">
    <adm:userTooltip xml:lang="en">A member of an organization by marriage</adm:userTooltip>
    <rdfs:label xml:lang="en">Member by marriage</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMember"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Date">
    <adm:userTooltip xml:lang="en">The type of various sorts of date individuals such as DILA's Chinese date individuals - see subclass bdo:ChineseDateType</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Date type</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/InstanceEvent">
    <adm:userTooltip xml:lang="en">An event associated with the production of an Instance.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">An event associated with the production of an :Instance. Event information is gathered from colophons and publication data presented in the publishede form of texts</adm:technicalComment>
    <rdfs:label xml:lang="en">Instance Event</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/WorkEvent">
    <adm:userTooltip xml:lang="en">An event associated with the creation of a Work.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">An event associated with the creation of a :Work. Event information is gathered from colophons and publication data presented in the publishede form of texts</adm:technicalComment>
    <rdfs:label xml:lang="en">Work Event</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EnscribedEvent">
    <adm:userTooltip xml:lang="en">An event of preparing a written manuscript of a Work</adm:userTooltip>
    <rdfs:label xml:lang="en">enscribed</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonPersonalName">
    <adm:userTooltip xml:lang="en">The name a Person is known by, typically at birth, independent of offices, seats, and so on</adm:userTooltip>
    <rdfs:label xml:lang="en">Personal Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset">
    <adm:userTooltip xml:lang="en">A item comprised of a physical volume or volumes.</adm:userTooltip>
    <rdfs:label xml:lang="en">Physical item</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PlaceConverted">
    <adm:userTooltip xml:lang="en">event type describing when a place was converted from one tradition to another, e.g., from Nyingma to Gelugpa</adm:userTooltip>
    <rdfs:label xml:lang="en">converted</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMember">
    <adm:userTooltip xml:lang="en">A member of an organization based on some attributes of the </adm:userTooltip>
    <adm:technicalComment xml:lang="en">Describes a member of the subject Corporation by indicating the :Person that is a member and the :CorporationMemberType of the :Person:

bdr:Czzzz a :Corporation ;
                 :corporationHasMember
                       [ a :CorporationMemberByBlood ;
                         :corporationMember bdr:Pyyyyy ] ,
                        [ a CorporationMemberByMarriage ;
                         :corporationMember bdr:Pxxxxx ] .</adm:technicalComment>
    <rdfs:label xml:lang="en">member</rdfs:label>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/CorporationMemberByBlood">
    <adm:userTooltip xml:lang="en">A member of an organization by kinship</adm:userTooltip>
    <rdfs:label xml:lang="en">Member by blood</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/CorporationMember"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonOfficialTitle">
    <adm:userTooltip xml:lang="en">The official title given to a person. In the Burmese context these would be given by the King, or in other rare contexts by the colonial administration.</adm:userTooltip>
    <rdfs:label xml:lang="en">Official Title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/IIIF2Or3Collection">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="http://iiif.io/api/presentation/2#Collection"/>
      <rdf:Description rdf:about="http://iiif.io/api/presentation/3#Collection"/>
    </owl:unionOf>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">iiif v2 or v3 collection</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/ReferenceTitle">
    <adm:userTooltip xml:lang="en">for use with abstract works such as from the SEA project that have many different expressions with the same putative title</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Reference Title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Title"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/BibliographicalTitle">
    <adm:userTooltip xml:lang="en">The main title of a work, the title by which it is the most often known.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">This is the main title of a work, the title by which it is the most often known. If a work has only one title, it must be of type Bibliographic Title. There must be only one bibliographical title per work. 

Title by which a Work is identified for cataloging purposes. There are three usages: (1) Title that is the main title of a Work based on Cover Title, Title Page Title. Spine Title, Colophon Title; (2) Title that is a known or popular abbreviation of the main title of a Work; (3) Title that is a collective convention used to collocate publications of an author that contains several Works (ex: gsung ‘bum)</adm:catalogingConvention>
    <rdfs:label xml:lang="en">Bibliographic Title</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Title"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonCommonName">
    <adm:userTooltip xml:lang="en">The name by which a Person is commonly known</adm:userTooltip>
    <rdfs:label xml:lang="en">Common Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonResidenceName">
    <adm:userTooltip xml:lang="en">Name associated with the person's place of residence. This is specific to a few socio linguistic contexts, such as the Burmese one.</adm:userTooltip>
    <rdfs:label xml:lang="en">Residence name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonPrimaryName">
    <adm:userTooltip xml:lang="en">The primary name by which a Person is known</adm:userTooltip>
    <adm:technicalComment xml:lang="en">what is the difference with :PersonCommonName</adm:technicalComment>
    <rdfs:label xml:lang="en">Primary Name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonReversal">
    <adm:userTooltip xml:lang="en">Reverses 'firstname lastname' to 'lastname, firstname'</adm:userTooltip>
    <rdfs:label xml:lang="en">reversed name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Event">
    <adm:userTooltip xml:lang="en">The class of the various sorts of events: Persons, Places, Works, and Lineages</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Class of all the various event classes in the ontology: PersonEvent, PlaceEvent, LineageReceived, etc</adm:technicalComment>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/SingleAgent">
    <adm:userTooltip xml:lang="en">single agents include ahistorical and historical (human) agents</adm:userTooltip>
    <rdfs:label xml:lang="en">single agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Agent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/VolumePhysicalAsset">
    <adm:userTooltip xml:lang="en">Physical assets are indicated for libraries that are representing their assets as physical items.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Physical Volume</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonAssumesSeat">
    <adm:userTooltip xml:lang="en">Event indicating a Person assuming a seat such as Secretary to the Kashag</adm:userTooltip>
    <rdfs:label xml:lang="en">Assumes seat</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PrintedEvent">
    <adm:userTooltip xml:lang="en">An event of printing a work</adm:userTooltip>
    <rdfs:label xml:lang="en">Printed</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Facet">
    <adm:userTooltip xml:lang="en">:Facets are essentially n-ary relations that apply to one or more Resources. Facets are compound features or properties of Resources.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Facet</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextLine">
    <adm:userTooltip xml:lang="en">indicates a line of text in a corresponding digitized image of a Work</adm:userTooltip>
    <rdfs:comment xml:lang="en">An indication of correpondance with a line of text of a physical/image asset. Lines are counted from 1.</rdfs:comment>
    <rdfs:label xml:lang="en">line</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/EtextSlice"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PhysicalInstance">
    <adm:userTooltip xml:lang="en">A physical instance of an (abstract) Work</adm:userTooltip>
    <adm:technicalComment xml:lang="en">A published or one-off (manuscript, etc.) instance of an (abstract) Work</adm:technicalComment>
    <rdfs:label xml:lang="en">Physical instance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonEventNotSpecified">
    <adm:userTooltip xml:lang="en">An otherwise unspecified type of Person Event</adm:userTooltip>
    <rdfs:label xml:lang="en">Unspecified Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonBodhisattvaVowName">
    <adm:userTooltip xml:lang="en">The name received by the Person upon taking their Bodhisattva vows</adm:userTooltip>
    <rdfs:label xml:lang="en">Bodhisattva vow name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/PersonDonorName">
    <adm:userTooltip xml:lang="en">Monastic name associated with the name of the donor who sponsored a monastery of residence. This is specific to a few socio linguistic contexts, such as the Burmese one.</adm:userTooltip>
    <rdfs:label xml:lang="en">Residence Monastery name</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/EtextInstance">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">An Instance consisting of some form of searchable text</adm:userTooltip>
    <adm:technicalComment xml:lang="en">Was ItemEtext, changed to align with Bibframe 2.0</adm:technicalComment>
    <adm:technicalComment xml:lang="en">:ItemEtext represent the :Etext items in the archive (i.e the actual digital files). 

There are two subclasses of :ItemEtext. (1) :ItemEtextNonPaginated and (2) :ItemEtextPaginated. These are characterized by the presence or lack of pagination information maintained in the :ItemEtext. OCR is considered ItemEtextPaginated and manual input saved in RTF format  considered :ItemEtextNonPaginated. These are distinguished because there are different stuctural characteristics in the :ItemEtext.

An :ItemEtext typically will represent an entire published Work. There won't be an Etext item for each :Volume within the Work. This is because we generally want to track the entire published Work as a single entity and will use the Work :partOf Work statements along with additional statements to link an individual Etext back to a Work part.</adm:technicalComment>
    <rdfs:label xml:lang="en">eText instance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/DigitalInstance"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Outline">
    <rdfs:label xml:lang="en">Outline</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/contentMethod">
    <skos:editorialNote xml:lang="en">was :workObjectType</skos:editorialNote>
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/ContentMethod">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">the method for creating the content</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">content method</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationGeneral">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationGeneral"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates an incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has general incarnation</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workIsAbout">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">The referenced Entity (topic, person, work, etc.) is a subject of the Work - something the Work is about.</adm:userTooltip>
    <rdfs:label xml:lang="en">is about</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageRef">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <adm:userTooltip xml:lang="en">The :lineageRef identifies an alternative version of the current Lineage</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">The :lineageRef identifies another :Lineage that is an alternative version of the current :Lineage. In gsan yig and thob yig there can be references to different versions of how a given object has been transmitted up to the time of the writing of the gsan/thob yig.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">alternative lineage</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/femcConversionOf">
    <adm:userTooltip xml:lang="en">This label is a (spelling) correction and conversion from the FEMC catalogs</adm:userTooltip>
    <rdfs:label xml:lang="en">femc conversion of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/correctionOf"/>
    </rdfs:subPropertyOf>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/conversionOf"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/itemForInstance">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasItem"/>
    </owl:inverseOf>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">This Item represents an occurrence of the referenced PhysicalInstance</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :itemForWork.</adm:technicalComment>
    <rdfs:label xml:lang="en">for instance</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasOutline">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/outlineOf"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Outline"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">outline</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/format">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Format"/>
    <adm:userTooltip xml:lang="en">the physical format or layout of the entity</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">format</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/microfilmItem">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/ObjectTypeMicrofilm"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemMicrofilmAsset"/>
    <adm:userTooltip xml:lang="en">The microfilm item from which the instance was digitized.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workMicrofilm</adm:technicalComment>
    <rdfs:label xml:lang="en">item from microfilm</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialHasMember">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialMemberOf"/>
    </owl:inverseOf>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/SerialMember"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/SerialWork"/>
    <adm:userTooltip xml:lang="en">used to reference the number associated with the work in the series</adm:userTooltip>
    <rdfs:label xml:lang="en">has serial member</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeLocatedIn">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeContains"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">Identifies a Place that this Place is located in.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Identifies a Place that this Place is located in - usually a single Place but to account for changes over time in the definitions of regions and such it may be necessary to have multiple associations.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">located in</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/corporationMemberType">
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/CorporationMember"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">type</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/eventWho">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/AgentsOrAgentInRole"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:userTooltip xml:lang="en">associates an event with one or more agent</adm:userTooltip>
    <rdfs:label xml:lang="en">who</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageDownTo">
    <rdfs:seeAlso>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageDownFrom"/>
    </rdfs:seeAlso>
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <adm:userTooltip xml:lang="en">Similar to down from this property refers to a sequence of holders from another Lineage.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">This models the "down to ..." references to other Lineages. The other Lineage from the beginning to the holder with the same who as this holder is implicitly included with this lineage. The known use case is for the initial holder to include the prior holders from another lineage as the initial without having members of this lineage without having to repeat them. It may be meaningful to use this feature deeper in a lineage but that is not defined at this time. It is meaningful to include multiple from references which is interpreted as implicitly creating an alternative lineage for each from element.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">down to</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personOfSect">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Topic"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">Indicates a school, tradition, or sect that the Person is associated with.</adm:userTooltip>
    <rdfs:label xml:lang="en">person of school</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationQualities">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationQualities"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates a Qualities incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has qualities incarnation</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasInstance"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Links an (abstract) :Work and one of its instances</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workExpressionOf</adm:technicalComment>
    <adm:technicalComment xml:lang="en">The subject Instance is an instance of the referenced :Work. This may mean that the subject instance is an edition or version or the only extant occurrence of the referenced :Work.

This modeling is relevant when there are more than one occurrence of a work that needs to be accounted for in the library. If there is a single edition of a unique work then this elaborate modeling is not needed; however, for many works in the domain of Buddhist Universal Digital Archive there are many expressions of a single identified "conceptual" work such as the Kanjur, Tengyur, Nyingma Gyu Bum, Rinchen Terdzod, Nyingma Kama, Songs of Milarepa, and on and on.

Consider the Kanjur:

bdr:T2423 a Topic, Work ;
      rdfs:label "bka' 'gyur"@bo-x-ewts ;
      :workHasTitle [ a :WorkTitle ;
            rdfs:label "Kanjur"@en ;
            :workHasTitleType bdr:TitleTypeBibliographicalTitle ]

bdr:W9NEW01 a Work ;
      :workHasTitle [ a :WorkTitle ;
            rdfs:label "Dege Kanjur"@en ;
            :workHasTitleType bdr:TitleTypeBibliographicalTitle ]
      :instanceOf bdr:T2423 .

bdr:W22703 a Work ;
      :workHasTitle [ a :WorkTitle ;
            rdfs:label "Narthang Kanjur"@en ;
            :workHasTitleType bdr:TitleTypeBibliographicalTitle ]
      :instanceOf bdr:T2423 .

bdr:W26071 a Work ;
      :workHasTitle [ a :WorkTitle ;
            rdfs:label "Lhasa Kanjur"@en ;
            :workHasTitleType bdr:TitleTypeBibliographicalTitle ]
      :instanceOf bdr:T2423 .</adm:technicalComment>
    <rdfs:label xml:lang="en">instance of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasChild">
    <skos:definition xml:lang="en">Indicates a child of the person</skos:definition>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates a child of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has child</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasAunt">
    <skos:scopeNote xml:lang="en">An aunt is the sister of one's parent or the wife of one's uncle.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates an aunt of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates an aunt of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has aunt</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialInstanceOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialHasInstance"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/SerialWork"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/SerialInstance"/>
    <rdfs:label xml:lang="en">serial instance of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/partOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasPart"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Indicates the direct parent in the hierarchy of the work content</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">The subject work is a part of the referenced work. The subject work in this case is an &lt;outline:node/&gt; in the legacy metadata. The referenced work may be the root work or another part of the root work such as a section.

For example, The Kanjur conventionally has a section of Vinaya texts and each of these will be a :Work modeled like:

bdr:SomeKanjurVinayaTextX a :Work ;
      :workPartOf bdr:SomeKanjurVinayaSection ;
      :workBeginsAt bdr:ContentLocationY001 ;
      :workEndsAt bdr:ContentLocationY002 .

bdr:SomeKanjurVinayaSection a :Work ;
      :workPartOf bdr:W26071 ;
      :workBeginsAt bdr:ContentLocationZ001 ;
      :workEndsAt bdr:ContentLocationZ002 .</adm:catalogingConvention>
    <rdfs:label xml:lang="en">part of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/transliterationOf">
    <adm:userTooltip xml:lang="en">This label is a transliteration of the object label in a form indicated in the language tag</adm:userTooltip>
    <rdfs:label xml:lang="en">transliteration of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent">
    <skos:definition xml:lang="en">Indicates a parent of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a parent of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has parent</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationSpeech">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationSpeech"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates a Speech incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has speech incarnation</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/noteSource">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Note"/>
    <adm:userTooltip xml:lang="en">The source for the noteContent</adm:userTooltip>
    <rdfs:label xml:lang="en">source</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGrandParent">
    <skos:definition xml:lang="en">Indicates a grandparent of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
    </owl:propertyChainAxiom>
    <adm:userTooltip xml:lang="en">Indicates a grandparent of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has grandparent</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeContains">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/placeLocatedIn"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">Identifies a Place that this Place contains.</adm:userTooltip>
    <rdfs:label xml:lang="en">contains</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextResource">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EtextRef"/>
    <adm:userTooltip xml:lang="en">Refers to an :Etext that is contained in a particular :VolumeEtextAsset</adm:userTooltip>
    <rdfs:label xml:lang="en">eText resource</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageReceived">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/LineageReceived"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/LineageEvent"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <adm:userTooltip xml:lang="en">Essentially who did the holder receive this Lineage from</adm:userTooltip>
    <rdfs:label xml:lang="en">lineage received</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasInstance">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/instanceOf"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">The referenced Instance is an expression of this Work.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workHasExpression</adm:technicalComment>
    <rdfs:label xml:lang="en">has instance</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationMind">
    <adm:userTooltip xml:lang="en">This Person is a Mind incarnation of the target Person</adm:userTooltip>
    <rdfs:label xml:lang="en">mind incarnation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceEvent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/InstanceEvent"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A description of the what, when and where of an event in the life of a instance</adm:userTooltip>
    <rdfs:label xml:lang="en">event</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/binding">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Binding">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">Describes the type of binding of a work (loose leaves, bound by glue, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">binding</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasYoungerSister">
    <skos:definition xml:lang="en">Indicates a younger sister of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a younger sister of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has younger sister</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSister"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/agent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Agents"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/AgentInRole"/>
    <adm:userTooltip xml:lang="en">identifies the agent participating in an :AgentInRole</adm:userTooltip>
    <rdfs:label xml:lang="en">agent</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnation">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PersonOrTopic"/>
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">Indicates a Person considered to be an Incarnation of this Person</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">This property is applicable to Persons and Topics (that represent deities or other ahistorical figures).</adm:catalogingConvention>
    <rdfs:label xml:lang="en">has incarnation</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/corporationRegion">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Corporation"/>
    <adm:userTooltip xml:lang="en">This property records a Place characterizing the region in which the Corporation occured/occurs.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">
The original corporation.xsd includes several attributes on &lt;region/&gt;: @start, @startCirca, @end, @endCirca that are not used except in one case 
for @start, C71, and a different instance, C13, for @endCirca. The uses are not correct and these attributes have not been included in the current model.

Thus crp:region maps crp:Corporation directly to plc:Place without any additional chaff</rdfs:comment>
    <rdfs:label xml:lang="en">region</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasUncle">
    <skos:scopeNote xml:lang="en">An uncle is the brother of one's parent or the husband of one's aunt.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates an uncle of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates an uncle of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has uncle</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasPaternalUncle">
    <skos:scopeNote xml:lang="en">A paternal uncle is an uncle related through one's father.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a paternal uncle of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a paternal uncle of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has paternal uncle</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasUncle"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/abbreviationOf">
    <adm:userTooltip xml:lang="en">indicates that this label is a shortened. abbreviated form of the object label</adm:userTooltip>
    <rdfs:label xml:lang="en">abbreviation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/copyrightStatus">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/CopyrightStatus"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <rdfs:label xml:lang="en">copyright status</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personTeacherOf">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">Indicates a Person this Person was a teacher of.</adm:userTooltip>
    <rdfs:label xml:lang="en">teacher of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationSpeech">
    <adm:userTooltip xml:lang="en">This Person is a Speech incarnation of the target Person</adm:userTooltip>
    <rdfs:label xml:lang="en">speech incarnation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/conversionOf">
    <adm:userTooltip xml:lang="en">This label is a conversion of the object label from one orthographic form to another in the same language, e.g., Khmer</adm:userTooltip>
    <rdfs:label xml:lang="en">conversion of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceCreator">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/AgentAsCreator"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Associates an Instance with an Agent and a Creator Role that participated in the creation of the Instance. For example, scribe, carver and so on</adm:userTooltip>
    <rdfs:label xml:lang="en">has creator</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageFrom">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/LineageReceived"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PersonOrTopic"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LineageEvent"/>
    <adm:userTooltip xml:lang="en">Who did this "LineageHolder receive the :Lineage from?</adm:userTooltip>
    <rdfs:label xml:lang="en">received from</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/pageHasLine">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/EtextLine"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EtextPage"/>
    <adm:userTooltip xml:lang="en">Refers to a line of an Etext page</adm:userTooltip>
    <rdfs:label xml:lang="en">line</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasPart">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/partOf"/>
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/partOf"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">links a work and one of its part (a collection and a text in the collection, a text and one of its chapters, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">has part</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSourcePrintery">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">used to indicate the place of production of a traditional artefact (manuscript or woodblock)</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workHasSourcePrintery</adm:technicalComment>
    <rdfs:label xml:lang="en">place of production</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSteward">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Agents"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/TextualEntity"/>
    <adm:userTooltip xml:lang="en">An organization that preserves and makes metadata and images/etexts available digitally</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">A steward of (a Collection of) Textual Item(s) is an organization that preserves and makes metadata and images/etexts available digitally.  A steward may be an :Organization or an adm:Organization.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">has steward</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageWork">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <adm:userTooltip xml:lang="en">Refers to a Work authored by the LineageHolder about the Lineage.</adm:userTooltip>
    <rdfs:label xml:lang="en">work</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/eventWhere">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:userTooltip xml:lang="en">associates an event with at most one place</adm:userTooltip>
    <rdfs:label xml:lang="en">place</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/transliteration">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Transliteration">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/LangScript">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:domain>
    <adm:userTooltip xml:lang="en">A transliteration for a LangScript.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">A transliteration for a :LangScript. Mostly this will apply for Pali situations since texts are always written in a transliteration of Pali in a Romanization or script of a language such as Thai.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">transliteration</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationYangtse">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationYangtse"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates a young incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has yangtse</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/collectionPlace">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
    <adm:userTooltip xml:lang="en">Indicates the place where the collection resides.</adm:userTooltip>
    <rdfs:label xml:lang="en">at place</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/correctionOf">
    <adm:userTooltip xml:lang="en">This label is a (spelling) correction of the object label</adm:userTooltip>
    <rdfs:label xml:lang="en">correction of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/dateIndication">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/DateIndication">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">Not Used: associates a :Date with at most one :ChineseDateIndication such as a :ChineseDynasty or reign of an Emperor. Not currently used pending import of :DateIndication metadata</adm:technicalComment>
    <rdfs:label xml:lang="en">date indication</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/reproductionPrintMethod">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/PrintMethod">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:label xml:lang="en">print method of the reproduction</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasDerivative">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workDerivativeOf"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">The referenced Work is a derivative of this Work.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">The referenced work is a derivative of this Work. This means that the referenced work may be a later edition or a version with some "corrections"/changes to the content of the referenced work.</adm:technicalComment>
    <rdfs:label xml:lang="en">has derivative</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/inCollection">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/collectionMember"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <adm:userTooltip xml:lang="en">The subject is contained in a collection</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">in collection</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextHasChunk">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/EtextChunk"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">has chunk</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasHusband">
    <skos:definition xml:lang="en">Indicates a husband of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a husband of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has husband</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSpouse"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasNephew">
    <skos:scopeNote xml:lang="en">A nephew is the son of one's sibling or sibling-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a nephew of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a nephew of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has nephew</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasNibling"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationMind">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/incarnationMind"/>
    <adm:userTooltip xml:lang="en">Indicates a Minds incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has mind incarnation</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIIIFManifest">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IIIFManifest"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ImageGroup"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:comment xml:lang="en">this property refers to a named IIIF Manifest resource. The resource may be local or at another location such as the British Library EAP</rdfs:comment>
    <rdfs:label xml:lang="en">has IIIF Manifest</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationActivities">
    <adm:userTooltip xml:lang="en">This Person is an Activities incarnation of the target Person</adm:userTooltip>
    <rdfs:label xml:lang="en">activities incarnation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasDaughter">
    <skos:definition xml:lang="en">Indicates a daughter of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a daughter of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has daughter</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasChild"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personEvent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">An event related to a person such as birth, death, ordination, founding monastery and so on.</adm:userTooltip>
    <rdfs:label xml:lang="en">event</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/outlineOf">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/hasOutline"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Outline"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">outline of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasItem">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">This physical instance has an associated Item.</adm:userTooltip>
    <adm:technicalComment xml:lang="n">was workHasItem</adm:technicalComment>
    <rdfs:label xml:lang="en">has item</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/interpretationOf">
    <adm:userTooltip xml:lang="en">indicates that this label is an interpretation of the object label, e.g., this sa-iast label is an interpretation of a phonetic label</adm:userTooltip>
    <rdfs:label xml:lang="en">interpretation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/corporation">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Corporation"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    <adm:userTooltip xml:lang="en">Indicates a Corporation that is associated with the subject.</adm:userTooltip>
    <rdfs:label xml:lang="en">associated corporation</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeEvent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PlaceEvent"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">Identifies an event that occurred at this Place, e.g., founded, rebuilt, deserted, etc.</adm:userTooltip>
    <rdfs:label xml:lang="en">event</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/labelConnection">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Label"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Label"/>
    <adm:userTooltip xml:lang="en">indicates a connection between two bdo:Labels</adm:userTooltip>
    <rdfs:label xml:lang="en">label connection</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personHasConsort">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">The target Person is a consort of the subject Person</adm:userTooltip>
    <rdfs:label xml:lang="en">has consort</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageWho">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PersonOrTopic"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LineageHolder"/>
    <adm:userTooltip xml:lang="en">identifies who this LineageHolder is, Person or a being represented via a Topic.</adm:userTooltip>
    <rdfs:label xml:lang="en">is holder</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasFather">
    <skos:definition xml:lang="en">Indicates the father of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates the father of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has father</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasParent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasTitle">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Title"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Title"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <adm:userTooltip xml:lang="en">Asserts that the subject instance has a particular title.</adm:userTooltip>
    <rdfs:label xml:lang="en">title</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasNibling">
    <skos:scopeNote xml:lang="en">A nibling is one's niece or nephew; i.e., the child of one's sibling or sibling-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a nibling of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a nibling of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has nibling</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextInInstance">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/EtextInstance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">The reference to the instance the etext is in</adm:userTooltip>
    <rdfs:label xml:lang="en">in instance</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIIIFCollection">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IIIFCollection"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ImageInstance"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">has IIIF Collection</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageType">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/TibetanLineageType"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <adm:userTooltip xml:lang="en">Identifies the type of :Lineage such as empowerment, reading transmission, various sorts of instructions and so on</adm:userTooltip>
    <rdfs:label xml:lang="en">lineage type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasOlderBrother">
    <skos:definition xml:lang="en">Indicates an older brother of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates an older brother of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has older brother</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasBrother"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceDerivativeOf">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasDerivative"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">References an Instance that this Instance is a derivative of.</adm:userTooltip>
    <rdfs:label xml:lang="en">instance derivative of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/corporationHasMember">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/CorporationMember"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Corporation"/>
    <adm:userTooltip xml:lang="en">Indicates an Entity that is a member of the corporation</adm:userTooltip>
    <rdfs:label xml:lang="en">has member</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationGeneral">
    <adm:userTooltip xml:lang="en">This Person is a general incarnation of the target Person</adm:userTooltip>
    <rdfs:label xml:lang="en">general incarnation of</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSon">
    <skos:definition xml:lang="en">Indicates a son of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a son of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has son</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasChild"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasTranslation">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workTranslationOf"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">The referenced Work is identified as a translation of this Work.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">The referenced work is identified as a translation of the subject work. This will be used, for example, when the referenced work is a Tibetan translation of a subject Sanskrit work.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">has translation</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasDerivative"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasVolume">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/volumeOf"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">refers to a volume description of a digital asset, scanned or etext; or a physical volume.</adm:userTooltip>
    <rdfs:label xml:lang="en">has volume</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasPaternalAunt">
    <skos:scopeNote xml:lang="en">A paternal aunt is an aunt related through one's father.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a paternal aunt of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a paternal aunt of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has paternal aunt</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasAunt"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasBrother">
    <skos:definition xml:lang="en">Indicates a brother of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSon"/>
    </owl:propertyChainAxiom>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a brother of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has brother</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSibling"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/appliedMaterial">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/AppliedMaterial"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">Indicates the material applied on a work (ink, golden leaf, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">applied material</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/script">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Script">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/LangScript"/>
    <adm:userTooltip xml:lang="en">The script (Tibetan, Devanagari, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">script</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/volumeHasEtext">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EtextVolume"/>
    <adm:userTooltip xml:lang="en">refers to an :EtextRef that identifies an :Etext and the position of that :Etext in a containing :EtextVolume</adm:userTooltip>
    <rdfs:label xml:lang="en">eText</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workEvent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/WorkEvent"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">A description of the what, when and where of an event in the life of a instance</adm:userTooltip>
    <rdfs:label xml:lang="en">event</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasMaternalUncle">
    <skos:scopeNote xml:lang="en">A maternal uncle is an uncle related through one's mother.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a maternal uncle of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a maternal uncle of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has maternal uncle</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasUncle"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/volumeOf">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">The subject is a volume of the referenced item.</adm:userTooltip>
    <rdfs:label xml:lang="en">volume of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasMaternalAunt">
    <skos:scopeNote xml:lang="en">A maternal aunt is an aunt related through one's mother.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a maternal aunt of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a maternal aunt of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has maternal aunt</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasAunt"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasMotherInLaw">
    <skos:definition xml:lang="en">Indicates a mother-in-law of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSpouse"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasMother"/>
    </owl:propertyChainAxiom>
    <adm:userTooltip xml:lang="en">Indicates a mother-in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has mother in-law</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParentInLaw"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasWife">
    <skos:definition xml:lang="en">Indicates a wife of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a wife of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has wife</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSpouse"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasMother">
    <skos:definition xml:lang="en">Indicates the mother of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates the mother of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has mother</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasParent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personName">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PersonName"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">describe a name for a Person</adm:userTooltip>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personStudentOf">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/personTeacherOf"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">Indicates a Person this Person was a student of.</adm:userTooltip>
    <rdfs:label xml:lang="en">student of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationBody">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationBody"/>
    </owl:inverseOf>
    <adm:userTooltip xml:lang="en">Indicates a Body incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has body incarnation</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasFatherInLaw">
    <skos:definition xml:lang="en">Indicates the father-in-law of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSpouse"/>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/hasfather"/>
    </owl:propertyChainAxiom>
    <adm:userTooltip xml:lang="en">Indicates the father-in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has father in-law</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParentInLaw"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasInLaw">
    <skos:definition xml:lang="en">Indicates an in-law of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates an in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has in-law</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialMemberOf">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/SerialWork"/>
    <adm:userTooltip xml:lang="en">Indicates that this Work is a member of a series.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Indicates that this Work is a member of a series. This property is used rather than :partOf to distinguish between the situation in which a series is typically not published all at once versus a collection of Works such as a Kanjur or gSungbum that is conventionally published and distributed all at once.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">serial member of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGrandfather">
    <skos:definition xml:lang="en">Indicates a grandfather of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasFather"/>
    </owl:propertyChainAxiom>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a grandfather of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has grandfather</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasGrandParent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/serialHasInstance">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/serialInstanceOf"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/SerialInstance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/SerialWork"/>
    <rdfs:label xml:lang="en">serial has instance</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGrandson">
    <skos:definition xml:lang="en">Indicates a grandson of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasChild"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSon"/>
    </owl:propertyChainAxiom>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a grandson of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has grandson</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGrandChild"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/isIncarnation">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/PersonOrTopic"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">This Person is an incarnation of the target Person</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">isIncarnation records which being (Person or Topic) this individual is an incarnation of and optionally what sort of incarnation (body speech, mind, etc). There are 1,456 individuals out of 18,320, that are marked as being incarnations of some being. Of these, 18 are marked with per:incarnationOf_relation and 5 are marked with per:incarnationOf_secondary.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">is incarnation of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSiblingInLaw">
    <skos:scopeNote xml:lang="en">A sibling-in-law is the sibling of one's spouse or the spouse of one's sibling or sibling-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a sibling-in-law of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a sibling-in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has sibling in-law</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasInLaw"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasReproduction">
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceReproductionOf"/>
    </owl:inverseOf>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">References an Instance that is a reproduction of this Instance.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workHasReproduction</adm:technicalComment>
    <rdfs:label xml:lang="en">has reproduction</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasDerivative"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceReproductionOf">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">The subject instance is a reproduction of the referenced instance such as a photocopy or an offset print of an original or photocopy and so on.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workReproductionOf</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">This is relevant to record versus :workExpressionOf when there may be features peculariar to the fact of reproduction versus a direct production such as from master woodblocks or, in a more modern setting, the original offset plates from an input text.

For example,

bdr:W22084 :workReproductionOf bdr:W9NEW01

indicates that bdr:W22084 is considered to be scanned images from a reproduction of the conceptual sdg dge Kanjur identified here as bdr:W9NEW01. The bdr:W9NEW01 denotes the constellation of versions/reproductions and derivatives of the (mythical) sde dge Kanjur.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">instance reproduction of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/instanceDerivativeOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSisterInLaw">
    <skos:scopeNote xml:lang="en">A sister-in-law is the sister of one's spouse or the wife of one's brother or brother-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a sister-in-law of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a sister-in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has sister in-law</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasSiblingInLaw"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/collectionAgent">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Agents"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
    <adm:userTooltip xml:lang="en">Indicates the agent that holds the collection</adm:userTooltip>
    <rdfs:label xml:lang="en">has agent</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/typeOfCopy">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/TypeOfCopy"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">The type of copy</adm:userTooltip>
    <rdfs:label xml:lang="en">type of copy</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/role">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Role"/>
    <adm:userTooltip xml:lang="en">Associates a Role with eiher an Agents or an AgentInRole.</adm:userTooltip>
    <rdfs:label xml:lang="en">role</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workDerivativeOf">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasDerivative"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">This work is a derivative of the referenced work.</adm:userTooltip>
    <rdfs:comment xml:lang="en">This work is a derivative of the referenced work. This means that it may be a later edition or a version with some "corrections"/changes to the content of the referenced work.

For example,

bdr:W30532 :workDerivativeOf bdr:W22084

bdr:W30532 is a printing based on woodblocks that have a variety of "corrections" made via plugs in the original woodblocks and W22084 is a printing from the original sde dge Kanjur woodblocks so it makes sense to indicate that bdr:W30532 is a derivative of bdr:W22084.</rdfs:comment>
    <rdfs:label xml:lang="en">derivative of</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/itemLibrary">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <adm:userTooltip xml:lang="en">The Library (Place) that contains the physical holding</adm:userTooltip>
    <rdfs:label xml:lang="en">library</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceHasDerivative">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/instanceDerivativeOf"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">References an Instance that is a derivative of this Instance.</adm:userTooltip>
    <rdfs:label xml:lang="en">has derivative</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasIncarnationActivities">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/incarnationActivities"/>
    <adm:userTooltip xml:lang="en">Indicates an Activities incarnation of this Person.</adm:userTooltip>
    <rdfs:label xml:lang="en">has activities incarnation</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasIncarnation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/corporationMember">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/CorporationMember"/>
    <adm:userTooltip xml:lang="en">Indicates a Person that is a member of the corporation</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">person</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasNiece">
    <skos:scopeNote xml:lang="en">A niece is the daughter of one's sibling or sibling-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a niece of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a niece of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has niece</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasNibling"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workTranslationOf">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasTranslation"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">This work is a translation of the reference work.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">The subject work is identified as a translation of the referenced work. This will be used, for example, when the subject work is a Tibetan translation of a referenced Sanskrit work.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">translation of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workDerivativeOf"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGranddaughter">
    <skos:definition xml:lang="en">Indicates a granddaughter of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasChild"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasDaughter"/>
    </owl:propertyChainAxiom>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderFemale"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a granddaughter of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has granddaughter</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasGrandChild"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/incarnationQualities">
    <adm:userTooltip xml:lang="en">This Person is a Qualities incarnation of the target Person</adm:userTooltip>
    <rdfs:label xml:lang="en">qualities incarnation of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/isIncarnation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeAddress">
    <rdfs:range rdf:resource="http://www.w3.org/2006/vcard/ns#Address"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">Associates modern address information with a Place</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">address</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/collectionMember">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/inCollection"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/BiblioEntity"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Collection"/>
    <adm:userTooltip xml:lang="en">Indicates a BiblioEntity that is a member of the Collection</adm:userTooltip>
    <rdfs:label xml:lang="en">has member</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personGender">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Gender">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <adm:userTooltip xml:lang="en">The gender of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">gender</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/baseMaterial">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/BaseMaterial"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">Indicates the base material of a work (paper, palm leaf, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">base material</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationInstance">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">Indicates the Instance that the ContentLocation refers to.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationWork</adm:technicalComment>
    <rdfs:label xml:lang="en">in instance</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/placeType">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/PlaceType">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The type of Place: monastery, river, mountain pass, etc.</adm:userTooltip>
    <rdfs:label xml:lang="en">type</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocation">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Lineage"/>
          <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Note"/>
          <owl:Class rdf:about="http://purl.bdrc.io/ontology/core/Instance"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <adm:userTooltip xml:lang="en">This is the location of the source information</adm:userTooltip>
    <rdfs:label xml:lang="en">location</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/workGenre">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Topic"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">The referenced Topic is interpreted as a "genre".</adm:userTooltip>
    <adm:technicalComment xml:lang="en">The referenced Topic is expected to be a "genre" topic and eventually the genre topics will be moved to a class of Genre and/or a Taxonomy of Genre may be supplied.

A genre is intended to capture a form or structural type of the work versus the content of the work.</adm:technicalComment>
    <rdfs:label xml:lang="en">genre</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/lineageObject">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Entity"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Lineage"/>
    <adm:userTooltip xml:lang="en">This is a reference to what is being transmitted in the Lineage.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">This is a reference to what is being transmitted in the :Lineage. Typically this is a deity, ritual, or teaching or some sort. The :lineageType will indicate the nature of the :Lineage transmission, empowerment, reading transmission, instructions on practice and so on.

The object should be restricted to Persons or to Topics that represent a Deity or other suitable objects of a Lineage (what might those be?). This requires a union of some sort.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">transmits</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/personEventCorporation">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Corporation"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PersonEvent"/>
    <adm:userTooltip xml:lang="en">Indicates a Corporation that is associated with the subject Event.</adm:userTooltip>
    <rdfs:label xml:lang="en">associated corporation</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/associatedTradition">
    <rdfs:range>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Tradition">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a Tradition that the subject is associated with</adm:userTooltip>
    <rdfs:label xml:lang="en">associated tradition</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasBrotherInLaw">
    <skos:scopeNote xml:lang="en">A brother-in-law is the brother of one's spouse or the husband of one's sister or sister-in-law.</skos:scopeNote>
    <skos:definition xml:lang="en">Indicates a brother-in-law of the person</skos:definition>
    <rdfs:range>
      <owl:Restriction>
        <owl:hasValue rdf:resource="http://purl.bdrc.io/resource/GenderMale"/>
        <owl:onProperty rdf:resource="http://purl.bdrc.io/ontology/core/personGender"/>
      </owl:Restriction>
    </rdfs:range>
    <adm:userTooltip xml:lang="en">Indicates a brother-in-law of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has brother in-law</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/hasSiblingInLaw"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/creator">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/AgentAsCreator"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">Associates a Work with an Agent and a Creator Role that participated in the creation of the Work</adm:userTooltip>
    <rdfs:label xml:lang="en">has creator</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasOlderSister">
    <skos:definition xml:lang="en">Indicates an older sister of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates an older sister of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has older sister</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSister"/>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/inRootInstance">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">For a sub(sub, etc) Work the target Work is the top-level containing Work.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">:workHasRoot is typically "inferred" via a path expression such as:

    ?hEx bdo:partOf+ ?hExW .
    optional { ?hExW bdo:partOf ?hExWP }
    FILTER (!bound(?hExWP))
    ?hExW skos:prefLabel ?hExO .

which can then be constructed to:

    ?hEx :workHasRoot ?hExW .

rather than storing the triple explicitly for every part of a large composite :Work such as a Kanjur or Tengyur.

Adding this "virtual" property to the ontology provides a place to add the labels needed for localization of applications</adm:technicalComment>
    <rdfs:label xml:lang="en">has root</rdfs:label>
  </owl:ObjectProperty>
