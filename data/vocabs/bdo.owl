    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationSide</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">If :contentLocationByFolio true then side should be either "recto" or "verso" but will likely need to be normalized since there has not been validation in the editor of this field. Most locations are specified in terms of pages.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">side</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/missingVolumes">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <adm:catalogingConvention xml:lang="en">A comma separated list of volume numbers and ranges of missing volumes for the Item. For example: "3-4,11,17,81-88,101"</adm:catalogingConvention>
    <rdfs:label xml:lang="en">missing volumes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeChgisId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The China Historical GIS identifier for the Place</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">Note that in the BDRC dataset, these are in fact invalid identifiers that conflict with other ones. The way to get the correct ID is to prefix the local name with "TBRC_", for instance "TBRC_G162".</adm:technicalComment>
    <rdfs:label xml:lang="en">chgis id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/qualityGrade">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <adm:userTooltip xml:lang="en">The quality of the digital reproduction, using a grade from 0 (barely legible) to 5 (perfect).</adm:userTooltip>
    <rdfs:label xml:lang="en">quality of digital reproduction</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/yearOffset">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain>
      <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Era">
        <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
      </rdf:Description>
    </rdfs:domain>
    <adm:userTooltip xml:lang="en">This is the year offset for an Era in terms of the Common Era.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">This is the year offset for an Era in terms of the Common Era and is established based on the definition of the Era for which this is the offset</adm:catalogingConvention>
    <rdfs:label xml:lang="en">year offset</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeGonpaPerEcumen">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The number of monasteries per ecumen in this Place (presumably a region) from data provided by Karl Ryavec</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">Karl Ryavec supplies the following information regarding this property:

Gonpa per ecumen would be how many temples are there per one sq km of land area minus water, bare rock, ice and so forth.  Thus I totaled the ecumen areas of each township primarily in terms of the sq km of grassland and forests and farmland.  Then because these areas per temple are so tiny I represented the final amounts on my map legend per 1000 sq km so that the numbers would be closer to 1.0 at times.  For example there might only be .0000001 temples per sq km of ecumen.  But if we convert to per 1000 sq km of ecumen we get .0001 temples  which is a more understandable amount.  Though I think most scholars are baffled by technology and so just understand the idea of core areas like the Lhasa valley compared the peripheral areas like the Changthang.  So that's mainly what I focused on showing.</adm:technicalComment>
    <rdfs:label xml:lang="en">monasteries per ecumen</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/biblioNote">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A note regarding a bibliographic feature of the Instance</adm:userTooltip>
    <rdfs:label xml:lang="en">bibliographic note</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndVolumeName">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">Indicates the ending volume name of a Work location.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationEndVolumeName</adm:technicalComment>
    <rdfs:label xml:lang="en">location ending volume name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRSource">
    <rdfs:label xml:lang="en">Source for the OCR</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceErrata">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Indicates a statement of error in the content</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workErrata</adm:technicalComment>
    <rdfs:label xml:lang="en">errata</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentWidth">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">width of the content (printed area) in cm</adm:userTooltip>
    <rdfs:label xml:lang="en">content width</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/numberOfVolumes">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">number of volumes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/publisherName">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <rdfs:label xml:lang="en">publisher name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/catalogInfo">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">Short description of the work</adm:userTooltip>
    <rdfs:label xml:lang="en">summary</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/onDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:userTooltip xml:lang="en">The event is known to have occurred during the year or date given, unless otherwise specified the date is reckoned in the Common Era</adm:userTooltip>
    <rdfs:label xml:lang="en">on date</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eventWhen"/>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndPage">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">The ending image number in the image group of the Work indicated by the other statements for this :ContentLocation</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationEndPage</adm:technicalComment>
    <rdfs:label xml:lang="en">end image number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndLine">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">The ending line on the ending page that is referenced</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationEndLine</adm:technicalComment>
    <rdfs:label xml:lang="en">end line</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/paginationExtentStatement">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <adm:userTooltip xml:lang="en">Indicates the range of paginations actually present in the instance</adm:userTooltip>
    <rdfs:label xml:lang="en">pagination extent</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/editionStatement">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">An Edition statement expresses information about this Instance as an edition.</adm:userTooltip>
    <rdfs:label xml:lang="en">edition statement</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationSeqNum">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">sequence number of the work location in a list of locations</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationSeqNum</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">in the typical case when an instance is completely contained in a single volume then the only location will have seqnum 1; otherwise, there may be 2 or more additional locations specifying where the parts of a work occur</adm:catalogingConvention>
    <rdfs:label xml:lang="en">location sequence number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationLine">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">The line on the page that is referenced</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationLine</adm:technicalComment>
    <rdfs:label xml:lang="en">line</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/etextInfo">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EtextInstance"/>
    <adm:userTooltip xml:lang="en">Where and by whom the etext was produced (or requested)</adm:userTooltip>
    <rdfs:label xml:lang="en">etext info</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeAccuracy">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The accuracy of the latitude and longitude</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">coordinates accuracy</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/excerptEnd">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">An excerpt from the end of the text (before the colophon)</adm:userTooltip>
    <rdfs:label xml:lang="en">excerpt (end)</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/explicit">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A transcription of the explicit of the Instance (a part of the colophon).</adm:userTooltip>
    <rdfs:label xml:lang="en">explicit</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/extentStatement">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <adm:userTooltip xml:lang="en">A statement of the extent (mostly for instances)</adm:userTooltip>
    <rdfs:label xml:lang="en">extent</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemVolumes">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
    <adm:userTooltip xml:lang="en">The number of volumes in the item</adm:userTooltip>
    <rdfs:label xml:lang="en">nb. volumes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumeName">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">In some cases volumes of a :Work are given names. For example, in Tibetan a three volume work might have volumes named O, a, huM or a 10 volume work might have volumes named: ka, kha, ga, nga, ca, cha, ja, nya, ta, a.</adm:userTooltip>
    <rdfs:label xml:lang="en">volume name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumeNumber">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">The number of the volume in the Item. There is no implied order in RDF and there may be missing volumes so it is necessary to explicitly indicate the volume number.</adm:userTooltip>
    <rdfs:label xml:lang="en">volume number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/imagesMissing">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ImageGroup"/>
    <adm:userTooltip xml:lang="en">A comma separated list of image indexes that are missing.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">A comma separated list of image indexes that are missing. For example:

    :imagesMissing "43,77-78,192'

This is a rare situation but needs to be handled.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">images missing</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/restoredAlt">
    <rdfs:seeAlso>
      <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/restored"/>
    </rdfs:seeAlso>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PersonNameOrBiblioTitle"/>
    <adm:userTooltip xml:lang="en">Indicates an alternative restoration of the original PersonName or WorkTitle</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">The :restoredAlt property is used to add an alternative restoration of the original :PersonName or WorkTitle in the event that the name in the rdfs:label is a transliteration from another language (often Sanskrit).

For example in:

    cbc:person_18 a :Person ;
    :personName [
        rdfs:label "阿地瞿多"@sa-Hant ;
        :restored "Atikūṭa"@sa-x-iast ;
        :restoredAtl "Atigupta"@sa-x-iast
     ] .

the rdfs:label is tagged as a Sanskrit transliteration in Tranditional Chinese, and the :restoredAlt is a reconstruction of the original Sanskrit encoded as IAST. 

Such reconstructions are typically approximations to the original and there may be alternatives to the preferred form of the name or title in which case :restoredAlt literals may be recorded.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">restored alternative</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/hasFascicles">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">A list of fascicles contained in the physical instance of a Work</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">fascicles</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextIsVolume">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">The Etext is the entire volume</adm:userTooltip>
    <rdfs:label xml:lang="en">is volume</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/chunkContents">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EtextChunk"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">contents</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemMissingVolumes">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
    <adm:userTooltip xml:lang="en">A comma separated list of numbers and ranges of missing volumes</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">A comma separated list of volume numbers and ranges of missing volumes for the Item. For example:

    :itemMissingVolumes "3-4,11,17,81-88,101"</adm:catalogingConvention>
    <rdfs:label xml:lang="en">missing volumes</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/conditionGrade">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">condition of the physical object (0 is nearly completely destroyed, 5 is perfect condition)</adm:userTooltip>
    <rdfs:label xml:lang="en">condition grade</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationVolumeName">
    <adm:userTooltip xml:lang="en">refers to the volume by name, e.g., ca, ta, nga</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationVolumeName</adm:technicalComment>
    <rdfs:label xml:lang="en">location volume name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextTitle">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">Title for the etext.</adm:userTooltip>
    <rdfs:label xml:lang="en">title</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndPhrase">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">A count of the ending phrase (in language specific units) of a Work location</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationEndPhrase</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">This should be a positive integer counting from the left side of the page tshegs and shads to the phrase (syllable) that is to be indicated by the location. This is optional and only makes sense if there is a :workLocationEndLine specified as well.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">end phrase</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRBatch">
    <rdfs:label xml:lang="en">OCR batch</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/sourceNote">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A note about the origin of the Instance (form of a Work) that was digitized.</adm:userTooltip>
    <rdfs:label xml:lang="en">source note</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/workSideBoxSequenceId">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">An identifer, typically a Tibetan letter, indicating the position of the text in a sequence of texts.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">An identifer, typically a Tibetan letter, indicating the position of the text in a sequence of texts. Conventionally appearing in a side box of the textbox. See bdr:W22080 for an example.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">side box sequence id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextInVolume">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">Indicates the volume in which the etext is found.</adm:userTooltip>
    <rdfs:label xml:lang="en">in volume</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/colophon">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A transcription of the colophon of the Instance.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">This was the description of type colophon which was used primarily (exclusively?) on &lt;outline:node/&gt;s. It is now part of the extended bibliographic model allowing to tag any sort of Work with a colophon</adm:technicalComment>
    <rdfs:label xml:lang="en">colophon</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/sliceStartChar">
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">slice start char</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationByFolio">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <adm:userTooltip xml:lang="en">If true then the location is specified in terms of folio # and side: verso/recto</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationByFolio</adm:technicalComment>
    <rdfs:label xml:lang="en">location by folio</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/instanceExtentStatement">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A statement of the extent of the instance</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workExtentStatement</adm:technicalComment>
    <rdfs:label xml:lang="en">extent</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentHeight">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">height of the content (printed area) in cm</adm:userTooltip>
    <rdfs:label xml:lang="en">content height</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeMARCCountryCode">
    <rdfs:seeAlso rdf:resource="http://www.loc.gov/marc/countries/"/>
    <rdfs:seeAlso rdf:resource="http://id.loc.gov/vocabulary/countries.html"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">two- or three-character lowercase alphabetic codes that designate countries and regions (such as states in the U.S.)</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">MARC Country Code</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eventWhen">
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:userTooltip xml:lang="en">Indicates the time of the event</adm:userTooltip>
    <rdfs:label xml:lang="en">when</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/imageCount">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ImageGroup"/>
    <adm:userTooltip xml:lang="en">A positive integer indicating the total number of images in the ImageGroup</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">image count</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemCopies">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <adm:userTooltip xml:lang="en">The number of copies of this holding</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">The number of copies of this holding. Must be greater than zero.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">number of copies</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumePhysicalDescription">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/VolumePhysicalAsset"/>
    <adm:userTooltip xml:lang="en">A description of the physical appearance of a Volume of the Item.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">A description of the physical appearance of a Volume of the Item. For example,

"No covers. Gilded leaves with vermilion band. Printed cotton wrapper with floral designs."@en</adm:catalogingConvention>
    <rdfs:label xml:lang="en">physical description</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/seriesNumber">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/SerialInstance"/>
    <adm:userTooltip xml:lang="en">This is the number or other id of this SerialInstance in a SerialWork.</adm:userTooltip>
    <rdfs:label xml:lang="en">issue</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/digitalLendingPossible">
    <rdfs:seeAlso rdf:resource="https://controlleddigitallending.org/"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/DigitalInstance"/>
    <adm:userTooltip xml:lang="en">Indicates if the digital instance can be in a Controlled Digital Lending program. In other words, indicates if a physical copy circulates.</adm:userTooltip>
    <rdfs:label xml:lang="en">digital lending possible</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationVolume">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">this should be a positive integer indicating the volume of the Work referenced in this Location</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationVolume</adm:technicalComment>
    <rdfs:label xml:lang="en">volume</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/dimHeight">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">height or thickness of the physical item of a :Work in cm</adm:userTooltip>
    <rdfs:label xml:lang="en">height</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextVolumeIndex">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">position of the eText in the volume that contains it</adm:userTooltip>
    <rdfs:label xml:lang="en">eText volume index</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/sponsoshipStatement">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Statement of sponsorship of the instance (typically the donor of a manuscript copy, not the work itself) indicated in the instance</adm:userTooltip>
    <rdfs:label xml:lang="en">sponsorship statement</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/readabilityGrade">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">readability of the physical object, can represent the quality of the handwriting, the quality of printing, etc. Goes from 0 (almost impossible to read) to 5 (perfectly readable).</adm:userTooltip>
    <rdfs:label xml:lang="en">readability grade</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeRegionPoly">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The object of this property is an xsd:string representing a geoJSON Polygon or Mulit-Polygon. See http://geojson.org/geojson-spec.html</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">region poly</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/ownershipStatement">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Statement of ownership indicated in the instance</adm:userTooltip>
    <rdfs:label xml:lang="en">authorship statement</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/notBefore">
    <adm:userTooltip xml:lang="en">Indicates that the event is known to have not occurred prior to the year/date given, unless otherwise specified the year/date is reckoned in the Common Era</adm:userTooltip>
    <rdfs:label xml:lang="en">not before</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/eventWhen"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/illustrations">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Provides a string describing the presence of illustrations, portraits, color plates and so on.</adm:userTooltip>
    <rdfs:label xml:lang="en">illustrations</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/excerptBeginning">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">An excerpt from the beginning of the text (skipping the incipit, hommage, etc.)</adm:userTooltip>
    <rdfs:label xml:lang="en">excerpt (beginning)</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/isRoot">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <adm:userTooltip xml:lang="en">This Resource is a root Resource of a graph.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">A </adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">True if this resource is a root resource - Entity or AdminData. If not present on a Work, which may be a sub-part, it is assumed false</adm:catalogingConvention>
    <rdfs:label xml:lang="en">is root resource</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/authorshipStatement">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">Authorship statement for the Instance.</adm:userTooltip>
    <rdfs:label xml:lang="en">authorship statement</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndSide">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">Indicates the ending side of the folio in a folio-based location.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationEndSide</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">If :contentLocationByFolio true then end side should be either "recto" or "verso" but will likely need to be normalized since there has not been validation in the editor of this field. Most locations are specified in terms of pages.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">end side</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/scanInfo">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ImageInstance"/>
    <adm:userTooltip xml:lang="en">Where and by whom the Work was scanned (or requested to be scanned)</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workScanInfo</adm:technicalComment>
    <rdfs:label xml:lang="en">scan info</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRTimeStamp">
    <rdfs:label xml:lang="en">OCR date</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/microfilmCanister">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemMicrofilmAsset"/>
    <adm:userTooltip xml:lang="en">indicates the id of the canister that the microfilm was stored in</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">microfilm canister</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/workFEMCManuscriptCode">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <adm:userTooltip xml:lang="en">FEMC Manuscript Code</adm:userTooltip>
    <rdfs:label xml:lang="en">FEMC Manuscript code</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workRefs"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumePagesIntro">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">May be used to indicate the number of introductory pages in a volume</adm:userTooltip>
    <rdfs:label xml:lang="en">nb. pages of intro</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumePagesTbrcIntro">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">The number of digitized metadata pages added by TBRC (now BDRC). Originally this was 2 pages and more recently condensed to a single non-blank page however a second blank page 2 was included to simplify processing of volumes for display and so on. The intention being to capture some relevant metadata in along with the digitized images so that the volume is essentially standalone. Note that for historical reasons this can be greater than the total number of images if we don't have any image for the image group.</adm:userTooltip>
    <rdfs:label xml:lang="en">nb. pages of TBRC intro</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRWordMeanConfidenceIndex">
    <rdfs:label xml:lang="en">Mean OCR confidence index</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/placeWBArea">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The area in square km of the Place from the World Bank 2010</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/eTextSourcePath">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Etext"/>
    <adm:userTooltip xml:lang="en">The source path, for an InputEtext.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">source path</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/hasInstanceNum">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">the number of this work within a containing work</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">has instance number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/custodialHistory">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A note on the custodial history of the physical object</adm:userTooltip>
    <rdfs:label xml:lang="en">custodial history</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/notAfter">
    <adm:userTooltip xml:lang="en">Indicates that the event is known to have not occurred after to the year/date given, unless otherwise specified the year/date is reckoned in the Common Era</adm:userTooltip>
    <rdfs:label xml:lang="en">not after</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/eventWhen"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemException">
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <adm:userTooltip xml:lang="en">Exception notes such a missing volume, damage to pages and so on</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">exception</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/seqNum">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <adm:userTooltip xml:lang="en">A :seqNum may be a page number, line number or other id as appropriate to the use of the :EtextSlice or other contexts such as the sequence of eTexts in a Volume and so on.</adm:userTooltip>
    <rdfs:label xml:lang="en">sequence number</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationPhrase">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">A count of the starting phrase (in language specific units) of a Work location.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">was :workLocationPhrase</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">This should be a positive integer counting from the left side of the page tshegs and shads to the phrase (syllable) that is to be indicated by the location. This is optional and only makes sense if there is a :workLocationLine specified as well.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">phrase</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/dimWidth">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">width of the physical item, of this :Work, that is held or scanned in cm</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workDimWidth</adm:technicalComment>
    <rdfs:label xml:lang="en">width</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/incipit">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">The opening words of the Work</adm:userTooltip>
    <rdfs:label xml:lang="en">incipit</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/restored">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PersonNameOrBiblioTitle"/>
    <adm:userTooltip xml:lang="en">Indicates a restoration of the original PersonName or WorkTitle</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:technicalComment xml:lang="en">The :restored property is used to add a restoration of the original :PersonName or WorkTitle in the event that the name in the rdfs:label is a transliteration from another language (often Sanskrit) and the original language name or title is not manifest in the material being cataloged so that the cataloger prepares a restoration.

For example in:

    cbc:person_18 a :Person ;
    :personName [
        rdfs:label "阿地瞿多"@sa-Hant ;
        :restored "Atikūṭa"@sa-x-iast
     ] .

the rdfs:label is tagged as a Sanskrit transliteration in Tranditional Chinese, and the :restored is a reconstruction of the original Sanskrit encoded as IAST. 

Such reconstructions are typically approximations to the original and there will often be a primary or preferred form of the name or title in which case the :restored property should be used.</adm:technicalComment>
    <rdfs:label xml:lang="en">restored</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/creationEventType">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/AgentAsCreator"/>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">use on an authorship attribution (agent as creator), for cases that are not self-evident (like second revision, second translation, etc.)</adm:catalogingConvention>
    <rdfs:label xml:lang="en">event type</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/dimLength">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">length of the physical item, of this :Work, that is held or scanned in cm</adm:userTooltip>
    <rdfs:label xml:lang="en">length</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/isDamaged">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">true if the instance or item is damaged</adm:userTooltip>
    <rdfs:label xml:lang="en">damaged</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/microfilmStrip">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemMicrofilmAsset"/>
    <adm:userTooltip xml:lang="en">indicates the id of the film strip that contains the digitized content</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">microfilm strip id</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/partIndex">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">The part index is used to provide a simple way to order the parts of a parent Work.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">The part index is used to provide a simple way to order the parts of a parent :Work. The direct children parts of a :Work are indexed from 1 to n. The direct children of each of these is similarly indexed from 1 to n.

Schematically:

W1
   :workHasPart W1_0001, W1_0005 ;

W1_0001
    :workHasPart W1_0002, W1_0003, W1_0004 ;
    :workPartOf W1 ;
    :workPartIndex 1 ;

W1_0002
    :workPartOf W1_0001 ;
    :workPartIndex 1 ;

W1_0003
    :workPartOf W1_0001 ;
    :workPartIndex 2 ;

W1_0004
    :workPartOf W1_0001 ;
    :workPartIndex 3 ;

W1_0005
    :workHasPart W1_0006, W1_0007 ;
    :workPartOf W1 ;
    :workPartIndex 2 ;

W1_0006
    :workPartOf W1_0005 ;
    :workPartIndex 1 ;

W1_0007
    :workPartOf W1_0005 ;
    :workPartIndex 2 ;</adm:catalogingConvention>
    <rdfs:label xml:lang="en">part index</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRSoftware">
    <rdfs:label xml:lang="en">OCR software</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/preservationGrade">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <adm:userTooltip xml:lang="en">The quality of the physical preservation, using a grade from 0 (almost destroyed) to 5 (perfect).</adm:userTooltip>
    <rdfs:label xml:lang="en">quality of preservation</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemShelf">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:seeAlso rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ItemPhysicalAsset"/>
    <adm:userTooltip xml:lang="en">Identifies where the holding is shelved. The shelf code is based on a library specific taxonomy</adm:userTooltip>
    <rdfs:label xml:lang="en">shelf</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/onYear">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Event"/>
    <adm:userTooltip xml:lang="en">The event is known to have occurred during the year given, unless otherwise specified the year is reckoned in the Common Era</adm:userTooltip>
    <rdfs:label xml:lang="en">in year</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/eventWhen"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/dimensionsStatement">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/PhysicalInstance"/>
    <adm:userTooltip xml:lang="en">The physical dimensions of the instance</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workDimensions =&gt; instanceDimensions</adm:technicalComment>
    <rdfs:label xml:lang="en">dimensions</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/OPFOCRWordMedianConfidenceIndex">
    <rdfs:label xml:lang="en">Median OCR confidence index</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationEndVolume">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/IntegerOrString"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/ContentLocation"/>
    <adm:userTooltip xml:lang="en">Indicates the ending volume number of a Content location.</adm:userTooltip>
    <adm:technicalComment xml:lang="en">was :workLocationEndVolume</adm:technicalComment>
    <adm:catalogingConvention xml:lang="en">this should be a positive integer indicating the ending volume (if different from the starting volume) of the Work referenced in this Location</adm:catalogingConvention>
    <rdfs:label xml:lang="en">end volume</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/volumePagesTotal">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Volume"/>
    <adm:userTooltip xml:lang="en">Total number of pages in the volume</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">nb. pages total</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/dateApproximate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Date"/>
    <adm:userTooltip xml:lang="en">set to true to indicate that the date information in an :Event or :Period is approximate or uncertain</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">date is approximate</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/itemBDRCHoldingStatement">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</owl:deprecated>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Item"/>
    <adm:userTooltip xml:lang="en">A free-text statement of the holdings by BDRC of this Item (and its relatives).</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">BDRC holdings statement</rdfs:label>
  </owl:DatatypeProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasParallelsIn">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">This work has some parallels in another work, meaning it displays intertextuality patterns.</adm:userTooltip>
    <rdfs:label xml:lang="en">parallels in</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasDerivative"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSpouse">
    <skos:definition xml:lang="en">Indicates a spouse of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a spouse of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has spouse</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasUnknownKinship">
    <skos:definition xml:lang="en">Indicates a Person with an unknown kinship relation to the Person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a Person with an unknown kinship relation to the Person</adm:userTooltip>
    <rdfs:label xml:lang="en">has unknown kinship with</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasCousin">
    <skos:editorialNote xml:lang="en">Assuming this encompasses more than first cousins, a property chain axiom (hasParent hasNibling) is invalid.</skos:editorialNote>
    <skos:definition xml:lang="en">Indicates a cousin of the person</skos:definition>
    <adm:userTooltip xml:lang="en">Indicates a cousin of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has cousin</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/hasSibling">
    <skos:definition xml:lang="en">Indicates a sibling of the person</skos:definition>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasParent"/>
      <owl:ObjectProperty rdf:about="http://purl.bdrc.io/ontology/core/hasChild"/>
    </owl:propertyChainAxiom>
    <adm:userTooltip xml:lang="en">Indicates a sibling of the person</adm:userTooltip>
    <rdfs:label xml:lang="en">has sibling</rdfs:label>
    <rdfs:subPropertyOf>
      <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith"/>
    </rdfs:subPropertyOf>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/workHasParallelPartsIn">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">This work has some parallels parts in another work, meaning some parts display intertextuality patterns but not the whole text.</adm:userTooltip>
    <rdfs:label xml:lang="en">parallels parts in</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasDerivative"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/kinWith">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Person"/>
    <bdo:inferSubTree rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
    >true</bdo:inferSubTree>
    <adm:userTooltip xml:lang="en">Root property that expresses some kinship relation between the subject and object Persons.</adm:userTooltip>
    <rdfs:label xml:lang="en">kin with</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:SymmetricProperty rdf:about="http://purl.bdrc.io/ontology/core/workExtractOf">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Work"/>
    <adm:userTooltip xml:lang="en">This work is an extract of another work</adm:userTooltip>
    <rdfs:label xml:lang="en">extract of</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/workHasDerivative"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:SymmetricProperty>
  <owl:FunctionalProperty rdf:about="http://purl.bdrc.io/ontology/core/placeWB2000">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The World Bank 2000 population for the Place</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="http://purl.bdrc.io/ontology/core/placeLong">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The longitude of the place, using GPS coordinates (WGS84), formatted as decimal degrees</adm:userTooltip>
    <rdfs:label xml:lang="en">longitude</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="http://purl.bdrc.io/ontology/core/placeWB2010">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The World Bank 2010 population for the Place</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">WB 2010 population</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:FunctionalProperty rdf:about="http://purl.bdrc.io/ontology/core/placeLat">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Place"/>
    <adm:userTooltip xml:lang="en">The latitude of the place, using GPS coordinates (WGS84), formatted as decimal degrees</adm:userTooltip>
    <rdfs:label xml:lang="en">latitude</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </owl:FunctionalProperty>
  <owl:InverseFunctionalProperty rdf:about="http://purl.bdrc.io/ontology/core/virtualLinkTo">
    <owl:inverseOf rdf:resource="http://purl.bdrc.io/ontology/core/workLinkedAt"/>
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/VirtualInstance"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/VirtualInstance"/>
    <adm:userTooltip xml:lang="en">Indicates a member Instance of a VirtualInstance</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">work link to</rdfs:label>
  </owl:InverseFunctionalProperty>
  <bdo:ChineseDate rdf:about="http://purl.bdrc.io/resource/ChineseDateNotSpecified">
    <adm:userTooltip xml:lang="en">An unspecified Chinese date.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">Unspecified Chinese date</rdfs:label>
  </bdo:ChineseDate>
  <bdo:Type rdf:about="http://purl.bdrc.io/resource/LanguageTaxonomy"/>
  <owl:AnnotationProperty rdf:about="http://purl.bdrc.io/ontology/core/note">
    <rdfs:range rdf:resource="http://purl.bdrc.io/ontology/core/Note"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/EntitiesOrFacets"/>
    <adm:userTooltip xml:lang="en">Associates a Note containing: a comment, Work, and location in the Work.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">the :note annotation adds language tagged string and optionally a reference to a Work and a simple text description of a location in a Work, e.g., "pp. 231-3".

In the XML db the notes are restricted to a limited set of items such as top-level resources and Outline Nodes, Place Events and so on. In this model there are no limitations on where notes can be attached. They can be attached directly to any owl:NamedIndividual or property. In particular one could add a note to the per:name property on an individual that provides evidence for the particular per:name assertion.</adm:catalogingConvention>
    <rdfs:label xml:lang="en">note</rdfs:label>
  </owl:AnnotationProperty>
  <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Taxonomy">
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Language">
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Type"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://purl.bdrc.io/ontology/core/uiAbbrFormat">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <adm:userTooltip xml:lang="en">used as labels for items such as canon catalog sigLas and date eras. The value is a string such as "T %s"or "%s C.E."</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <rdfs:label xml:lang="en">ui abbr</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
  </owl:AnnotationProperty>
  <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/ChineseMonastic">
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Role"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/Creator">
    <rdfs:subClassOf rdf:resource="http://purl.bdrc.io/ontology/core/Role"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://purl.bdrc.io/ontology/core/contentLocationStatementCBETA">
    <adm:userTooltip xml:lang="en">Indicates a location in the Chinese Buddhist Canon.</adm:userTooltip>
    <adm:catalogingConvention xml:lang="en">Use this to indicate a location in the Chinese Buddhist Canon using the usual reference system. For instance:

T52n2103_p0264c18

means:

Taisho, Volume 52, Text 2103, page 264, register c, line 18

(line counting start at 1 and goes from right to left)</adm:catalogingConvention>
    <rdfs:label xml:lang="en">location statement (in the Chinese Buddhist Canon)</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.bdrc.io/ontology/core/contentLocationStatement"/>
  </owl:AnnotationProperty>
  <rdf:Description rdf:about="http://purl.bdrc.io/ontology/core/WorkType">
