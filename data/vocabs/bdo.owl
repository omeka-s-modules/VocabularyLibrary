  <owl:DatatypeProperty rdf:about="http://purl.bdrc.io/ontology/core/partTreeIndex">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://purl.bdrc.io/ontology/core/Instance"/>
    <adm:userTooltip xml:lang="en">A dotted list of indexes of the part among its siblings under each parent up to the root.</adm:userTooltip>
    <adm:translationPriority rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >2</adm:translationPriority>
    <adm:catalogingConvention xml:lang="en">the :wpartTreeIndex is a dotted list of indexes of the part among its siblings under each parent up to the root. For example, suppose a part is the second part under the third part under the first part under the fifth part under the root work then the index will be:

    5.1.3.2

so go to the fifth child of the root then to the first of its children, then to the third child of that and finally to that child's second child</adm:catalogingConvention>
    <rdfs:label xml:lang="en">work part tree index</rdfs:label>
  </owl:DatatypeProperty>
