    <rdfs:comment xml:lang="en"></rdfs:comment>
    <rdfs:comment xml:lang="fr">Date de réception d'une lettre</rdfs:comment>
  </owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="http://data.persee.fr/ontology/persee-ontology/receiptPlace">
