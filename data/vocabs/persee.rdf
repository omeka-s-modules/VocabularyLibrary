<!DOCTYPE rdf:RDF [
    <!ENTITY dcterms "http://purl.org/dc/terms/" >
    <!ENTITY foaf "http://xmlns.com/foaf/0.1/" >
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY bibo "http://purl.org/ontology/bibo/" >
    <!ENTITY skos "http://www.w3.org/2004/02/skos/core#" >
    <!ENTITY txn "http://lod.taxonconcept.org/ontology/txn.owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY status "http://purl.org/ontology/bibo/status/" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY schema "http://schemas.talis.com/2005/address/schema#" >
    <!ENTITY ns "http://www.w3.org/2003/06/sw-vocab-status/ns#" >
    <!ENTITY dbo "http://dbpedia.org/ontology/" >
    <!ENTITY rdam "http://rdaregistry.info/Elements/m/" >
]>

<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dc="http://purl.org/dc/terms/"
	xmlns:dcterms="http://purl.org/dc/terms/" 
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
    xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#">
 
<rdf:Description rdf:about="http://data.persee.fr/ontology/persee-ontology/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Ontology for Persee stuff.</rdfs:label>
    <dc:description xml:lang="en">Ontology Persee stuff.</dc:description>
    <vs:term_status>stable</vs:term_status>
    <dc:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-12-12</dc:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-10-16</dcterms:modified>
    <owl:versionInfo>http://data.persee.fr/ontology/persee-ontology/1.4/</owl:versionInfo>
    <dc:creator>Viviane Boulétreau (Viviane.Bouletreau@persee.fr)</dc:creator>
    <rdfs:comment xml:lang="en">2015-12-12 - draft version</rdfs:comment>
    <rdfs:comment xml:lang="en">2016-02-09 - addition document typology</rdfs:comment>
    <rdfs:comment xml:lang="en">2016-03-12 - Release 1.0 (data.persee.fr first run)</rdfs:comment>
    <rdfs:comment xml:lang="en">2016-05-06 - Release 1.1 - addition illustration typology</rdfs:comment>
    <rdfs:comment xml:lang="en">2016-09-22 - Release 1.1.1 - minor changes (correspondences, collected document management)</rdfs:comment>
    <rdfs:comment xml:lang="en">2017-03-17 - Release 1.1.2 - typos</rdfs:comment>
    <rdfs:comment xml:lang="en">2017-03-17 - Release 1.1.3 - dropped draft evolutions</rdfs:comment>
    <rdfs:comment xml:lang="en">2017-09-25 - Release 1.1.4 - bibo:Image subcategories management</rdfs:comment>
    <rdfs:comment xml:lang="en">2018-01-20 - Release 1.1.5 - management of entities from bio (ranks from taxonConcept)</rdfs:comment>
    <rdfs:comment xml:lang="en">2018-05-18 - Release 1.2 - management of correspondences (typology and properties)</rdfs:comment>
    <rdfs:comment xml:lang="en">2020-08-26 - Release 1.3 - management of typologies and properties devoted to the National Assembly works and Education History projects</rdfs:comment>
    <rdfs:comment xml:lang="en">2024-09-26 - Release 1.4 - addition of typologies and properties</rdfs:comment>
</rdf:Description>

    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->



<!-- Typologie des documents Persée -->

    <!-- http://data.persee.fr/ontology/persee-ontology/Article -->
    
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Article">
        <rdfs:label xml:lang="en">Article</rdfs:label>
        <rdfs:label xml:lang="fr">Article</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <owl:equivalentClass rdf:resource="&bibo;Article"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">A scientific written composition, forming an independent part of a publication, as a journal, proceedings...</rdfs:comment>
        <rdfs:comment xml:lang="fr">Unité formant un élément distinct et faisant partie d’une publication plus large (numéro, actes, antologie, etc). Sont qualifiés d’article les unités documentaires suivantes : article scientifique, échanges de réflexions d’un numéro à l’autre ou au sein d’un même numéro, droit de réponses, interview, portrait, biographie ou hommage... </rdfs:comment>
    </owl:Class>


    <!-- http://data.persee.fr/ontology/persee-ontology/Review -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Review">
        <rdfs:label xml:lang="en">Review</rdfs:label>
        <rdfs:label xml:lang="fr">Compte-rendu</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Review of a book, publication, exhibition</rdfs:comment>
        <rdfs:comment xml:lang="fr">Compte rendus d'ouvrage, de publication, d’exposition... </rdfs:comment>
    </owl:Class>


    <!-- http://data.persee.fr/ontology/persee-ontology/Editorial -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Editorial">
        <rdfs:label xml:lang="en">Editorial</rdfs:label>
        <rdfs:label xml:lang="fr">Éditorial</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Document originating from the board of the journal and defining a general approach</rdfs:comment>
        <rdfs:comment xml:lang="fr">Document émanant de la rédaction de la revue et définissant une orientation générale</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Liminary -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Liminary">
        <rdfs:label xml:lang="en">Liminary</rdfs:label>
        <rdfs:label xml:lang="fr">Liminaire</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Introductory document of an issue or book</rdfs:comment>
        <rdfs:comment xml:lang="fr">Document liminaire d’un numéro, d’un dossier ou d’un ouvrage</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/SourceData -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/SourceData">
        <rdfs:label xml:lang="en">Sources and primary data</rdfs:label>
        <rdfs:label xml:lang="fr">Sources et données primaires</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Elements used as a basis for research (statistical data, archives, survey results, etc.), tools, methods</rdfs:comment>
        <rdfs:comment xml:lang="fr">Eléments servant de base à la recherche (données statistiques, archives, résultats d’enquêtes...), outils, méthodes</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/CriticalNote -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/CriticalNote">
        <rdfs:label xml:lang="en">Critical note</rdfs:label>
        <rdfs:label xml:lang="fr">Note critique</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Extensive analysis of sources, logical value, content of one or more publications</rdfs:comment>
        <rdfs:comment xml:lang="fr">Analyse poussée des sources, de la valeur logique, du contenu d’une ou de plusieurs publications</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Abstracts -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Abstracts">
        <rdfs:label xml:lang="en">Abstracts</rdfs:label>
        <rdfs:label xml:lang="fr">Résumés</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Section summarizing the articles published in the issue / book. They can be in several languages</rdfs:comment>
        <rdfs:comment xml:lang="fr">Section regroupant les résumés des articles publiés dans le numéro/l'ouvrage. Ils peuvent être en plusieurs langues</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/TableDoc -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/TableDoc">
        <rdfs:label xml:lang="en">Table and index</rdfs:label>
        <rdfs:label xml:lang="fr">Tables et index</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Documents such as tables of contents, of illustrations, index and alphabetical table of authors, subjects treated ...</rdfs:comment>
        <rdfs:comment xml:lang="fr">Documents tels que tables des matières, des illustrations, index et table alphabétique d’auteurs, de sujets traités... </rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/IllustrationDoc -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/IllustrationDoc">
        <rdfs:label xml:lang="en">Illustration document</rdfs:label>
        <rdfs:label xml:lang="fr">Illustration document</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Document or group of document of a graphic nature. Maps, reproduction of paintings, sculptures, photographs, buildings ...</rdfs:comment>
        <rdfs:comment xml:lang="fr">Document ou groupe de document de nature graphique. Cartes, reproduction de peintures, de sculptures, de photographies, de bâtiments...</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/BibliographicalNote -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/BibliographicalNote">
        <rdfs:label xml:lang="en">Bibliographical note(s)</rdfs:label>
        <rdfs:label xml:lang="fr">Note(s) bibliographique(s)</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Information or group of information of a bibliographical nature. Short publications reviews</rdfs:comment>
        <rdfs:comment xml:lang="fr">Information ou groupe d'informations de nature bibliographiques. Recensions courtes de publications</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/BiographicalNote -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/BiographicalNote">
        <rdfs:label xml:lang="en">Biographical note</rdfs:label>
        <rdfs:label xml:lang="fr">Note biographique</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Biographical note, portrait, obituary, ...</rdfs:comment>
        <rdfs:comment xml:lang="fr">Note biographique, portrait, nécrologie,...</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/ReceivedBooks -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/ReceivedBooks">
        <rdfs:label xml:lang="en">Received books</rdfs:label>
        <rdfs:label xml:lang="fr">Ouvrages reçus</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">List of books received by the editorial staff</rdfs:comment>
        <rdfs:comment xml:lang="fr">Liste d'ouvrages reçus par la rédaction de la revue</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Appendix -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Appendix">
        <rdfs:label xml:lang="en">Appendix</rdfs:label>
        <rdfs:label xml:lang="fr">Annexe</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Supplementary/Accompanying document of an issue or book</rdfs:comment>
        <rdfs:comment xml:lang="fr">Document annexe d’un numéro, d’un dossier ou d’un ouvrage</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Erratum -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Erratum">
        <rdfs:label xml:lang="en">Erratum</rdfs:label>
        <rdfs:label xml:lang="fr">Erratum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Correction of a published text</rdfs:comment>
        <rdfs:comment xml:lang="fr">Faute signalée dans un ouvrage imprimé</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Addendum -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Addendum">
        <rdfs:label xml:lang="en">Addendum</rdfs:label>
        <rdfs:label xml:lang="fr">Addendum</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Addition made to a document by its author subsequent to its printing or publication</rdfs:comment>
        <rdfs:comment xml:lang="fr">Ajout fait à un document après son impression ou sa publication</rdfs:comment>
    </owl:Class>


    <!-- http://data.persee.fr/ontology/persee-ontology/Chronicle -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Chronicle">
        <rdfs:label xml:lang="en">Chronicle</rdfs:label>
        <rdfs:label xml:lang="fr">Chronique</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">A written account of events and when they happened, ordered by time</rdfs:comment>
        <rdfs:comment xml:lang="fr">Récit des faits et événements classés par ordre chronologique</rdfs:comment>
    </owl:Class>


    <!-- http://data.persee.fr/ontology/persee-ontology/OtherDocument -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/OtherDocument">
        <rdfs:label xml:lang="en">Other type of document</rdfs:label>
        <rdfs:label xml:lang="fr">Autre type de document</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Used to qualify any documentary unit not qualified in the Persee typology</rdfs:comment>
        <rdfs:comment xml:lang="fr">Utilisé pour qualifier toute unité documentaire non qualifiable dans la typologie Persée</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Correspondence -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Correspondence">
        <rdfs:label xml:lang="en">Correspondence</rdfs:label>
        <rdfs:label xml:lang="fr">Correspondance</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
		<owl:equivalentClass rdf:resource="&bibo;Letter"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Letter, piece of correspondence</rdfs:comment>
        <rdfs:comment xml:lang="fr">Lettre, extrait de correspondance</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/Grievance -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/Grievance">
        <rdfs:label xml:lang="en">Grievance(s)</rdfs:label>
        <rdfs:label xml:lang="fr">Doléance(s)</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Grievance or grievance book</rdfs:comment>
        <rdfs:comment xml:lang="fr">Doléance ou cahier de doléances. Typlogie documentaire propre à la collection des archives parlementaires.</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/AssemblyWork -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/AssemblyWork">
        <rdfs:label xml:lang="en">Work of the assembly</rdfs:label>
        <rdfs:label xml:lang="fr">Travaux de l'assemblée</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Questions, discussions, votes, etc. of an assembly. Typology used for the parliamentary archives</rdfs:comment>
        <rdfs:comment xml:lang="fr">Déroulement de séances, questions, discussions, votes, etc. Typlogie documentaire propre à la collection des archives parlementaires.</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/LawText -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/LawText">
        <rdfs:label xml:lang="en">Law text</rdfs:label>
        <rdfs:label xml:lang="fr">Texte législatif</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Decrees, laws and orders. Published or draft releases</rdfs:comment>
        <rdfs:comment xml:lang="fr">Décrets, lois et arrêtés, projets de lois et décrets, etc.</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/NominativeDecision -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/NominativeDecision">
        <rdfs:label xml:lang="en">Nominative decision</rdfs:label>
        <rdfs:label xml:lang="fr">Mesure nominative</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="fr">Mesure nominative : nomination, promotion, révocation...</rdfs:comment>
        <rdfs:comment xml:lang="en">Nominative decision : nomination, promotion, radiation,...</rdfs:comment>
    </owl:Class>

    <!-- http://data.persee.fr/ontology/persee-ontology/AcademicProgram -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/AcademicProgram">
        <rdfs:label xml:lang="en">Academic program</rdfs:label>
        <rdfs:label xml:lang="fr">Programme académique</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bibo;Document"/>
        <rdfs:isDefinedBy rdf:datatype="&xsd;anyURI"
            >http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
        <ns:term_status>stable</ns:term_status>
        <rdfs:comment xml:lang="en">Any piece of document defining the academic program</rdfs:comment>
        <rdfs:comment xml:lang="fr">Tout document définissant le programme académique</rdfs:comment>
    </owl:Class>



    <!-- http://data.persee.fr/ontology/persee-ontology/DictionaryEntry -->
    <owl:Class rdf:about="http://data.persee.fr/ontology/persee-ontology/DictionaryEntry">
