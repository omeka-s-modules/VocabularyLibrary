 <owl:DatatypeProperty rdf:about="http://data.persee.fr/ontology/persee-ontology/dateOfPrintPublication">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://rdaregistry.info/Elements/c/Manifestation"/>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
    <rdfs:label xml:lang="en">has date of print publication</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&dcterms;date"/>
    <rdfs:isDefinedBy>http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
    <ns:term_status>stable</ns:term_status>
    <rdfs:comment xml:lang="en"></rdfs:comment>
    <rdfs:comment xml:lang="fr">Année de parution de la version imprimé du document dont est issu le document électonique</rdfs:comment>
  </owl:DatatypeProperty>


<owl:DatatypeProperty rdf:about="http://data.persee.fr/ontology/persee-ontology/dateOfSession">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://rdaregistry.info/Elements/c/Manifestation"/>
    <rdfs:range rdf:resource="&xsd;dateTime"/>
    <rdfs:label xml:lang="en">has date of session</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="&dcterms;date"/>
    <rdfs:isDefinedBy>http://data.persee.fr/ontology/persee-ontology/</rdfs:isDefinedBy>
    <ns:term_status>stable</ns:term_status>
    <rdfs:comment xml:lang="en">Date of the session when the content was presented</rdfs:comment>
    <rdfs:comment xml:lang="fr">Date de la séance au cours de laquel le discours/débat/etc a eu lieu (Archives parlementaires de la Révolution Française)</rdfs:comment>
  </owl:DatatypeProperty>


