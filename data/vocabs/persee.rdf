  </owl:DatatypeProperty>

 <owl:DatatypeProperty rdf:about="http://data.persee.fr/ontology/persee-ontology/answers">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:domain rdf:resource="http://data.persee.fr/ontology/persee-ontology/Correspondence"/>
