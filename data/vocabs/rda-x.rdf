  <reg:hasUnconstrained rdf:resource="rdau:P60906" />
  <reg:hasSubproperty rdf:resource="http://rdaregistry.info/Elements/x/P00020" />
  <reg:hasSubproperty rdf:resource="http://rdaregistry.info/Elements/x/P00022" />
  <rdakit:hasElementType xml:lang="">3</rdakit:hasElementType>
</rdf:Description>

