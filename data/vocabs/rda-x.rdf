  <reg:lexicalAlias rdf:resource="http://rdaregistry.info/Elements/x/accessPointForEntity.en" />
  <skos:definition xml:lang="en">Relates an entity to an appellation of entity in natural language that is taken from a vocabulary encoding scheme or is constructed using a string encoding scheme.</skos:definition>
