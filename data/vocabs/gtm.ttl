@prefix : <https://www.goudatijdmachine.nl/def#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://www.goudatijdmachine.nl/def#> .

<https://www.goudatijdmachine.nl/def> rdf:type owl:Ontology ;
                                       owl:versionIRI <https://www.goudatijdmachine.nl/def/0.14> ;
                                       <http://purl.org/dc/terms/abstract> "De Gouda Tijdmachine beschrijft en linkt geo-temporele objecten die betrekking hebben op plaats (en personen in) Gouda.<br>Deze ontologie beschrijft de generieke klasse GeoTemporeelObject, de subklassen structuur, constructie, adressering, registratie en gebeurtenis, en de eigenschappen die in de data van de Gouda Tijdmachine gebruikt worden. De ontologie is opgezet in het Nederlands."@nl ,
                                                                           "The Gouda Time Machine describes and links geo-temporal objects related to the city (and people) of Gouda.<br>This ontology describes the generic GeoTemporalObject class, its subclasses structure, construction, addressing, registration and event, and the properties used in the data of the Gouda Time Machine. The ontology is set up in Dutch."@en ;
                                       <http://purl.org/dc/terms/bibliographicCitation> "Gouda Tijdmachine Ontologie, versie 0.14, https://www.goudatijdmachine.nl/def/"@nl ,
                                                                                        "Gouda Time Machine Ontology, version 0.14, https://www.goudatijdmachine.nl/def/"@en ;
                                       <http://purl.org/dc/terms/contributor> <https://www.diegoude.nl/> ,
                                                                              <https://www.samh.nl/> ;
                                       <http://purl.org/dc/terms/created> "2021-11-25"^^xsd:date ;
                                       <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-7328-1312> ;
                                       <http://purl.org/dc/terms/hasVersion> "0.14" ;
                                       <http://purl.org/dc/terms/issued> "2026-09-17"^^xsd:date ;
                                       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                       <http://purl.org/dc/terms/modified> "2026-09-17"^^xsd:date ;
                                       <http://purl.org/dc/terms/publisher> <https://n2t.net/ark:/60537/by6gvD> ;
                                       <http://purl.org/dc/terms/title> "Gouda Tijdmachine Ontologie"@nl ,
                                                                        "Gouda Time Machine Ontology"@en ;
                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "gtm" ;
                                       <http://purl.org/vocab/vann/preferredNamespaceUri> : ;
                                       rdfs:comment "De Gouda Tijdmachine Ontologie beschrijft de geo-temporele klasses en eigenschappen die gebruikt worden binnen de Gouda Tijdmachine. De voorkeursprefix voor deze ontologie is <strong>gtm</strong>.<br>Het diagram hieronder wordt uit de ontologie gegenereerd: blauwe blokken zijn klasses, blauwe pijlen subklasse-relaties, rode pijlen en rode tekst zijn de eigenschappen van een klasse (een pijl naar een andere klasse, of een lijst in het blok). Vanaf versie 0.14 bevat de ontologie ook de registraties, gebeurtenissen en eigenschappen die in de data van de Gouda Tijdmachine voorkomen. <img alt=\"Klassendiagram van de Gouda Tijdmachine Ontologie\" title=\"Diagram van de Gouda Tijdmachine Ontologie\" src=\"diagram-nl.svg\" />"@nl ,
                                                    "The Gouda Time Machine Ontology describes the geo-temporal classes and properties used within the Gouda Time Machine. The preferred prefix for this ontology is <strong>gtm</strong>.<br>The diagram below is generated from the ontology: blue blocks are classes, blue arrows subclass relations, red arrows and red text are the properties of a class (an arrow to another class, or a list inside the block). From version 0.14 onwards the ontology also contains the registrations, events and properties that occur in the data of the Gouda Time Machine. <img alt=\"Class diagram of the Gouda Time Machine Ontology\" title=\"Diagram of the Gouda Time Machine Ontology\" src=\"diagram-en.svg\" />"@en ;
                                       owl:priorVersion <https://www.goudatijdmachine.nl/def/0.13> ;
                                       owl:versionInfo "0.14" ;
                                       <http://xmlns.com/foaf/0.1/logo> <https://www.goudatijdmachine.nl/wp-content/uploads/sites/7/2021/08/wapen.png> ;
                                       <https://schema.org/creativeWorkStatus> "Gepubliceerd"@nl ,
                                                                               "Published"@en .

