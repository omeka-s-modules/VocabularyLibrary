<http://ldf.fi/schema/mmm/data_provider>
        a               rdfs:Property ;
        rdfs:range      <http://ldf.fi/schema/mmm/Database> ;
        skos:prefLabel  "The data provider database" .

<http://ldf.fi/schema/mmm/Lines>
