<http://ldf.fi/schema/mmm/catalog_or_lot_number>
        a               rdfs:Property ;
        skos:prefLabel  "Catalog or lot number" .

<http://ldf.fi/schema/mmm/recon_date>
        a               rdfs:Property ;
