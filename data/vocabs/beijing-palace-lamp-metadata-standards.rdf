  <reg:lexicalAlias rdf:resource="http://metadataregistry.org/uri/schema/Hz/time.en" />
  <skos:definition xml:lang="en">A point in time or time period related to an event in the resource's lifecycle
</skos:definition>
</rdf:Description>


