<!-- Element Set: Beijing Palace lamp metadata standards -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/Hz">
  <dc:title xml:lang="en">Beijing Palace lamp metadata standards</dc:title>
  <skos:note  xml:lang="en">We are constructing the Beijing Palace Lamp Metadata Standard to try to protect the cultural heritage resources of Beijing Palace Lamp</skos:note>
</rdf:Description>

<!-- Classes -->

<!-- Class: time -->
