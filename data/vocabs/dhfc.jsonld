    "@language" : "en",
    "@value" : "has beginning"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalMarker"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#hasEnd",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a temporal marker to the temporal marker that marks its end. This property is meant to be used as a super-property for the one used in the domain ontology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalMarker"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has end"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalMarker"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#hasIdentityProperty",
