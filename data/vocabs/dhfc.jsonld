    "@value" : "Points to the supports the confidence marker is used for."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "confidence of argument"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#topObjectProperty"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#confidenceOfAssertion",
