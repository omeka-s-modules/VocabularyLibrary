  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The DHFC ontology aims to capture the process of building historical knowledge. Its aim is to help to build reusable data in the context of historical digital humanities by providing insight as to how data was produced."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Digital History Facts and Criticism"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/DHFC/1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "en",
    "@value" : "1.0"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#4DFluentsVersion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A statement that takes the form of a version or time-slice, as described in the 4DFluents model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "4DFluents Version"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalStatement"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#AssertableProposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An assertable proposition is an informational entity that can be asserted by an assertion bearer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assertable proposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://dcu.gr/ontologies/scholarlyontology/ConceptualObject"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/DHFC#Assertion"
    }, {
      "@id" : "https://w3id.org/DHFC#KnowledgeBuildingProcess"
    }, {
      "@id" : "https://w3id.org/DHFC#Statement"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Assertion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An assertion is a process trough which an assertion bearer expresses over a statement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assertion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#AssertableProposition"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#AssertionBearer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An meta-entity that can either produce or bear assertions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "assertion bearer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#MetaEntity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#AtomicStatement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An atomic statement is a statement that can not be split into sub-statements. It does not mean that it is composed of only one triple (ex: N-ary properties)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "atomic statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Statement"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Certain",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/DHFC#ConfidenceRating"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#ConfidenceRating",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A meta-entity which is an estimation of an assertion bearer's confidence in an assertion or support."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "confidence rating"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#MetaEntity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#ContentProducer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An assertion bearer that does not inherently bear assertions but rather produces them."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "content producer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://dcu.gr/ontologies/scholarlyontology/Actor"
  }, {
    "@id" : "https://w3id.org/DHFC#AssertionBearer"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Document",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A trace that bears an informational content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "document"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Trace"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#DomainGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An domain graph is a named graph that contains an ontology that will be reused by other knowledge graphs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "domain graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#NamedGraph"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Entity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An entity is anything that exists in the domain of interest of the historian. It is separate from meta-entities, which are the entities directly manipulated by said historian. This class is meant to be used as a super-class for the classes of domain ontology that are used to represent real-world entities."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "entity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#ExistingEntityIdentification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An exisiting entity identification is an identification that links an entity to an existing entity in another statement set."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "existing entity identification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Identification"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#FormalLogicPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A reasoning pattern that relies on an underlying crisp logical or mathematical theory, and can thus be proved within said theory."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "formal logic pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Historian",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A content producer who is an historian."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "historian"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#ContentProducer"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Identification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An identification is a knowledge building process in which an historian identifies an entity appearing in a statement set with one existing in another."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "identification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#KnowledgeBuildingProcess"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/DHFC#ExistingEntityIdentification"
    }, {
      "@id" : "https://w3id.org/DHFC#NewEntityIdentification"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#IdentificationPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A pattern that is used when identifying an entity from a statement with one in another."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "identification pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#InferenceGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An inference graph is a named graph that contains only triples that are inferred from those that are listed in an interpretation universe."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "inference graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#NamedGraph"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#InformationalContent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An assertion bearer that inherently bears assertions. It corresponds to the knowledge contained within a trace, most commonly in a document."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "informational content"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://dcu.gr/ontologies/scholarlyontology/InformationResource"
  }, {
    "@id" : "https://w3id.org/DHFC#AssertionBearer"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#InterpretationUniverse",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An interpretation universe is a coherent universe in which assertions are made about an informational content. It is built by aggregating compatible assertions regarding what a document asserts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "interpretation universe"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#KnowledgeBuildingProcess",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A knowledge building process is an assertable proposition whose content is related to the way an historian builds historical knowledge."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "knowledge building process"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#AssertableProposition"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/DHFC#Identification"
    }, {
      "@id" : "https://w3id.org/DHFC#Support"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Likely",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/DHFC#ConfidenceRating"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#MetaEntity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A meta-entity is an entity that is directly manipulated by the historian across his research process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "meta-entity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#NamedGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A statement set expressed as a named graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "named graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#StatementSet"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#NewEntityIdentification",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A new entity identification is an identification that leads to considering a new entity in the target statement set."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "new entitiy identification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Identification"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#NonFormalPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A reasoning pattern that does not prove irrevocably its result, either because it relies on some intuition or on a probabilistic approach."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "non-formal pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Possible",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/DHFC#ConfidenceRating"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#PropertySimilarity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An identification pattern that relies on the similarity of a property's value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "property similarity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#IdentificationPattern"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#PropertyTransfer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A support that merely consists in considering that what was asserted by another stands."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "property transfer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Support"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#ReasoningPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A way a content producer uses to support an assertion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "reasoning pattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://dcu.gr/ontologies/scholarlyontology/Method"
  }, {
    "@id" : "https://w3id.org/DHFC#MetaEntity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#ReifiedDataTemporalProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all data properties that should be held true only over a temporal region and that follow a standard reification pattern for temporalisation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "reified data temporal property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalDataProperty"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#SingletonTemporalDataProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all data properties that should be held true only over a temporal region and that follow a singleton property pattern for temporalisation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Singleton temporal data property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalDataProperty"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#SingletonTemporalProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all properties that should be held true only over a temporal region and that follow a singleton property pattern for temporalisation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "singleton temporal property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/DHFC#temporallyRelatedTo"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#SourceGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A named graph whose content is a direct RDF representation of how an historian understands a given document's informational content."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "source graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#NamedGraph"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Statement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A statement is any fact that can be asserted. This class is notably meant to be used as a super-class for the classes of domain ontologies that represent any n-ary pattern."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#AssertableProposition"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/DHFC#AtomicStatement"
    }, {
      "@id" : "https://w3id.org/DHFC#StatementSet"
    } ]
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#StatementSet",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A  statement set is a statement that can not be split into sub-statements."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "statement set"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#Statement"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Support",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A support is a knowledge building process in which an historian uses assertions to support another assertion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "support"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#KnowledgeBuildingProcess"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#SynthesisGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A synthesis graph is a named graph whose triples are supported by other statements which use different IRIs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "synthesis graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#NamedGraph"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TemporalDataProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all data properties that should be held true only over a temporal region."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "temporal data property"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TemporalMarker",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any entity that represent a temporal primitive, whether it be point or interval, fuzzy or crisp."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "temporal marker"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TemporalNAryProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A temporal statement that takes the form of an N-Ary property with a value and a temporal component."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Temporal N-Ary property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalStatement"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TemporalStatement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An atomic statement that is time-anchored, meaning its time-validity is specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "temporal statement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/DHFC#AtomicStatement"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TimeRelativeDataValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all properties that relate a temporal statement to a data value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalStatement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Time relative data value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalDataProperty"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#TimeRelativeValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Superproperty for all properties that relate a temporal statement to an entity that is not a temporal statement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/DHFC#TemporalStatement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "time relative value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/DHFC#temporallyRelatedTo"
  } ],
  "http://www.w3.org/2002/07/owl#propertyDisjointWith" : [ {
    "@id" : "https://w3id.org/DHFC#relationToVersion"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#Trace",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A trace is any entity that exists in the present and was produced in the past. Traces are used by historians to gain knowledge over their scope of interest."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "trace"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://dcu.gr/ontologies/scholarlyontology/InformationCarrier"
  }, {
    "@id" : "https://w3id.org/DHFC#MetaEntity"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#a",
  "@type" : [ "http://www.w3.org/2003/11/swrl#Variable" ]
}, {
  "@id" : "https://w3id.org/DHFC#arguedWithConfidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Specifies the confidence that is placed in a support."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/DHFC#Support"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "argued with confidence"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/DHFC#ConfidenceRating"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/DHFC#confidenceOfArgument"
  } ]
}, {
  "@id" : "https://w3id.org/DHFC#arguesFor",
