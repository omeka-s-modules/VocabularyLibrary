    "@language" : "en",
    "@value" : "Links a support to its components."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has argument"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/DHFC#isArgumentFor"
  } ]
