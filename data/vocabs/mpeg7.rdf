	<owl:Class rdf:ID="ProbabilityDistributionType">
		<rdfs:subClassOf rdf:resource="&mpeg7;ProbabilityModelType"/>
		<rdfs:subClassOf>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Mean"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Variance"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Min"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Max"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Mode"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Median"/>
						<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Moment"/>
						<owl:allValuesFrom>
							<owl:Class>
								<rdfs:subClassOf>
									<owl:Class>
										<owl:intersectionOf rdf:parseType="Collection">
											<owl:Restriction>
												<owl:onProperty rdf:resource="#Value"/>
												<owl:allValuesFrom>
													<owl:Class>
														<rdfs:subClassOf>
															<owl:Restriction>
																<owl:onProperty rdf:resource="#order"/>
																<owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
															</owl:Restriction>
														</rdfs:subClassOf>
														<rdfs:subClassOf>
															<owl:Restriction>
																<owl:onProperty rdf:resource="#order"/>
																<owl:minCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minCardinality>
															</owl:Restriction>
														</rdfs:subClassOf>
													</owl:Class>
												</owl:allValuesFrom>
											</owl:Restriction>
											<owl:Restriction>
												<owl:onProperty rdf:resource="#Center"/>
												<owl:allValuesFrom rdf:resource="&mpeg7;DoubleMatrixType"/>
											</owl:Restriction>
										</owl:intersectionOf>
									</owl:Class>
								</rdfs:subClassOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="#Cumulant"/>
						<owl:allValuesFrom>
							<owl:Class>
								<rdfs:subClassOf>
									<owl:Class>
										<owl:intersectionOf rdf:parseType="Collection">
											<owl:Restriction>
												<owl:onProperty rdf:resource="#Value"/>
