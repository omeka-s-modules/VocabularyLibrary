        <rdfs:label xml:lang="en">TaxonRank</rdfs:label>
        <rdfs:comment xml:lang="en">A rank of a taxon</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://en.wikipedia.org/wiki/Taxonomic_rank"/>
        <vs:term_status>testing</vs:term_status>
       <rdfs:isDefinedBy rdf:resource="http://lod.taxonconcept.org/ontology/taxnomen/index.owl#index.owl"/>
