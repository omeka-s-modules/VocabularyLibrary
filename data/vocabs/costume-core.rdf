    <rdfs:label xml:lang="en">pattern</rdfs:label>
    <rdfs:comment xml:lang="en">Each ornamental design, either on a flat surface or in relief, composed of repeated or combined motifs.</rdfs:comment>
    <rdfs:range rdf:nodeID="Na38669a732634fcd95ef806d483c9002"/>
    <dcterms:identifier>pattern</dcterms:identifier>
  </rdf:Description>
