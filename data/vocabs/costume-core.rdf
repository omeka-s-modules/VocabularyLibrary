  </rdf:Description>
  <rdf:Description rdf:nodeID="N9a707ab1fe384383ad4effc9381b1df2">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">Creating a textured effect similar to suede or felt by blowing fibers of cotton, silk, nylon, or other material onto a tacky surface, usually paper.</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N40b86f3150e74fe79d5d1e7262efa46c">
    <rdf:first rdf:resource="https://w3id.org/costumeCore/ontology/CC00025"/>
    <rdf:rest rdf:nodeID="N8f87bbe221f54d169becff8f6304bf24"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N894b62c3cf38497aa5bde4ad64bc7772">
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">Crisp textile, typically in plain weave, sometimes with a fine crosswise rib and a smooth lustrous surface on both sides, originally of silk, now of various fibers.</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb2b832dd932b463692b13e55822b9709">
