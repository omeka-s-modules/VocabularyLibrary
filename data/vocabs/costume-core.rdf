  </rdf:Description>
  <rdf:Description rdf:nodeID="N6d17e58e7a1c46558bb3bbf669e60fc3">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">Patterns having a watered or rippled look. Where this produces an illusion of movement, use moirÃ© effect. (AAT)</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
