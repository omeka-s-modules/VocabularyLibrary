  <rdf:Description rdf:nodeID="Ne0af8fcaae374182a0abe33c0f61466a">
    <rdfs:label xml:lang="en">Small, medium, or large-sized soft or rigid receptacles, intended for carrying personal articles and usually used as ladies' costume accessories. A bag is closed in on all sides except at the top, where also it generally can be closed, and usually having handles or straps for carrying on the shoulder or in the hand.</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
