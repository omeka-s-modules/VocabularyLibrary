  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00596">
    <dcterms:description xml:lang="en">A lozenge twill with a small weave unit which has an interlacing forming a spot in the center of each lozenge.</dcterms:description>
    <rdfs:label xml:lang="en">bird's-eye twill</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
