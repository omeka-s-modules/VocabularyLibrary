    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">triangular or A-shaped silhouette in clothing, generally standing away from the body</dcterms:description>
    <dcterms:identifier>CC00521</dcterms:identifier>
  </rdf:Description>
