  <rdf:Description rdf:nodeID="N29b41f6016a947a4b0e2195965c5db79">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Ecclesiastical vestments worn by bishops and priests consisting of a long narrow cloth band worn around the neck and falling from the shoulders. In the Western church, the sides of the stole are crossed over the chest.</rdfs:label>
  </rdf:Description>
