    <dcterms:description rdf:nodeID="Nf9bf968895c948509ff14201997d3c10"/>
    <dcterms:description xml:lang="en">The skin or hide of an animal that has been tanned to render it resistant to putrefication and relatively soft and flexible when dry. For composite material made from scrap leather pieces, use maril. (AAT)</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300011845"/>
  </rdf:Description>
