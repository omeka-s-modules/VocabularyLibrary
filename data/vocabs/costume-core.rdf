    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014087"/>
    <dcterms:description xml:lang="en">Very fine plain weave white cotton made in a great variety of qualities; originally from India, it has been extensively produced and used in Europe and North America for costume, and sometimes as an artist's support.</dcterms:description>
  </rdf:Description>
