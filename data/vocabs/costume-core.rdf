  <rdf:Description rdf:nodeID="N847d4a700c2547f387d3686ded2ce7a9">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">Textile constructed usually of wool and fur fiber often mixed with natural or synthetic fiber by the interlocking of the loose fiber through the action of heat, moisture, chemicals, and pressure without spinning, weaving, or knitting.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N62421ce1441e490c841a3459712f20d9">
    <rdf:rest rdf:nodeID="N81197008878a485f925767d7a7e64b27"/>
    <rdf:first rdf:resource="https://w3id.org/costumeCore/ontology/CC00211"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nffa9749fa2b149bf82f17c352de6fab5">
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">Long bast fibers obtained from the leaves of the species Ananas comosus, native to tropical America. The fibers are fine, soft, lustrous, and light cream in color. They are resistant to salt water, strong, wear resistant, and easy to clean; used for fabric, rope, twine, and paper.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N40b0d7a2309d4dbcac43b80504e228ad">
    <rdf:rest rdf:nodeID="N80568ebcc15149658e01b069838a9733"/>
    <rdf:first rdf:resource="https://w3id.org/costumeCore/ontology/CC00362"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00170">
    <dcterms:description rdf:nodeID="N391662d6a55f40c1a6d8aca689140116"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">gathering</rdfs:label>
    <dcterms:description xml:lang="en">Bunching folds of textile together by pulling on a thread stitched through it for this purpose or on one or more of its constituent filaments, to create fullness.</dcterms:description>
    <dcterms:identifier>CC00170</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300231237"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00521">
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q277835"/>
    <rdfs:label xml:lang="en">a-line</rdfs:label>
