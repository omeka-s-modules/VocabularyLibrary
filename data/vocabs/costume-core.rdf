    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300053634"/>
    <rdfs:label xml:lang="en">knitting</rdfs:label>
    <dcterms:description xml:lang="en">The forming and interlacing of loops by means of needles according to a prescribed manner or pattern, either by machine or by hand; most often used for textiles or costume.</dcterms:description>
    <dcterms:description rdf:nodeID="Nea1ca5fff23e4b568fb4e6c589386a2f"/>
