  <rdf:Description rdf:nodeID="N868ff52b617245d6a663644ab26115e6">
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
    <rdfs:label xml:lang="en">A skirt shaped with much more fullness in the back than in the front, accomodating a bustle pad or petticoat for added fullness underneath</rdfs:label>
    <dcterms:source rdf:resource="https://www.wikidata.org/wiki/Wikidata:Data_access/en"/>
