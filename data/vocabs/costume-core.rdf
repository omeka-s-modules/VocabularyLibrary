    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300132879"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Dacron</rdfs:label>
    <dcterms:description xml:lang="en">Trademarked name for the textile fiber made of polyethylene terephthalate. Originally manufactured and developed by Du Pont.</dcterms:description>
    <dcterms:description rdf:nodeID="Nafa1d03eb7c04942af73ee16d6633a6a"/>
  </rdf:Description>
