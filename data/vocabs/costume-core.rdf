  <rdf:Description rdf:nodeID="Na26148f502eb48209ce82fb5915727c3">
    <dcterms:creator>Wikipedia</dcterms:creator>
    <dcterms:source rdf:resource="https://en.wikipedia.org/wiki/Collar_(clothing)"/>
    <rdfs:label xml:lang="en">A small standing collar with the points pressed to stick out horizontally, resembling "wings," worn with men's evening dress (white tie or black tie)</rdfs:label>
    <dcterms:rights rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
