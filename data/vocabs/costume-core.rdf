    <rdfs:label xml:lang="en">Objects or devices that are not essential in themselves but add to the beauty, convenience, or effectiveness of other things, as, for example, to costume or automobiles.</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc39e10657dd4445c95f25c7710734dd9">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Dresses of intermediate length. They are longer than mini dresses but shorter than maxi dresses, usually extending to mid-calf.</rdfs:label>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
