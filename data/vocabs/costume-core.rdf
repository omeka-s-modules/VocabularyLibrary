  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00150">
    <dcterms:description rdf:nodeID="N0c7685ff06bb4b8aa117c49e6004573a"/>
    <dcterms:identifier>CC00150</dcterms:identifier>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/http://www.wikidata.org/entity/Q29129637"/>
