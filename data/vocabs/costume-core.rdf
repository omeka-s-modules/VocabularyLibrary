  </rdf:Description>
  <rdf:Description rdf:nodeID="N7edf563d66be40ebb814c2f131065ae4">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Underwear usually made the length of the garment under which it is to be worn, thereby taking the place of a lining. Usually applied to full slips with a bodice and shoulder straps made in dress length. Prefer "half slips" for skirtlike underwear extending from the waist to near the hemline of the garment with which it is worn.</rdfs:label>
  </rdf:Description>
