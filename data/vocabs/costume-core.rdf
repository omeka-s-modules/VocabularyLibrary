    <dcterms:description xml:lang="en">Deep, capelike collars, often of lace or silk, worn about the shoulders by women.</dcterms:description>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q64780667"/>
    <dcterms:identifier>CC00030</dcterms:identifier>
