  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00059">
    <dcterms:description xml:lang="en">Hue name for the color representing that portion of the spectrum that is intermediate between blue and yellow, with wavelengths between 520 and 570 nanometers. The term may refer to any of this group of colors that vary in lightness and saturation. An example of green color in nature is that of growing grass. It is a secondary pigment color (made by combining yellow and blue) and one of the three additive primary colors.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300128438"/>
    <rdfs:label xml:lang="en">green</rdfs:label>
    <dcterms:identifier>CC00059</dcterms:identifier>
    <dcterms:description rdf:nodeID="Nc03ea13a5fc4448b82c6bc4c2d95441e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://vocab.getty.edu/aat/300037335">
