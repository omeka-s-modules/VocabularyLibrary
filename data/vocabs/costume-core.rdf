  <rdf:Description rdf:nodeID="N292bf5ce5e584e0cbcdfdcd699df0967">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">Complete costume, including garments and accessories, worn for a harmonious effect. Also, two or more garments or accessories designed to complement one another.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
