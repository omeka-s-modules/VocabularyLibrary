    <owl:sameAs rdf:resource="https://w3id.org/costumeCore/ontology/CC00266"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00399">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300224244"/>
    <dcterms:description rdf:nodeID="N4ca59a32dfec49229ae39cdd7ff59d07"/>
    <rdfs:label xml:lang="en">waistband</rdfs:label>
    <dcterms:description xml:lang="en">Bands encircling the waist, especially as a part of a skirt or pair of trousers.</dcterms:description>
    <dcterms:identifier>CC00399</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00206">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300183741"/>
    <dcterms:description rdf:nodeID="N529f7f0c28d6419191dd194f1b8af94c"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Lightweight textile made of various types of fiber, having a crinkled surface obtained by using hard twisted thread or yarn, by printing with caustic soda, by weaving with varied tensions, or by embossing. (AAT)</dcterms:description>
    <rdfs:label xml:lang="en">crepe</rdfs:label>
    <dcterms:identifier>CC00206</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00507">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="N351c8439a5d54603b0afc5ae554d5b1e"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300411755"/>
    <dcterms:description xml:lang="en">Womenswear designed to be worn during pregnancy.</dcterms:description>
    <rdfs:label xml:lang="en">maternity clothes</rdfs:label>
    <dcterms:identifier>CC00507</dcterms:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00016">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300209885"/>
    <dcterms:identifier>CC00016</dcterms:identifier>
    <rdfs:label xml:lang="en">halterneck</rdfs:label>
    <dcterms:description rdf:nodeID="Nf9753a81d934445886a5645b239933d8"/>
    <dcterms:description xml:lang="en">Garments having a strap encircling the neck and supporting the front of the bodice, leaving shoulders and most of the back bare.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N21c366e86d0140a187da16930680a2f4">
