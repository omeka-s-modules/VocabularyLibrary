    <dcterms:description rdf:nodeID="N1d95262763954026a09190a804580dcc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00069">
    <rdfs:label xml:lang="en">tan</rdfs:label>
    <dcterms:description rdf:nodeID="N3535614ba6494df68664d1c0def398c8"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300266248"/>
    <dcterms:identifier>CC00069</dcterms:identifier>
    <dcterms:description xml:lang="en">A light to moderate brownish tawny color. The term originally referred to the color of crushed oak bark or tannin that is employed to tan leather.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
