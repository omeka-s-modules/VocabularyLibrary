  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00449">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300210431"/>
    <dcterms:description rdf:nodeID="N7e0d1b3b30bb4d9295150ada6341c284"/>
    <rdfs:label xml:lang="en">dalmatics</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00449</dcterms:identifier>
    <dcterms:description xml:lang="en">Long, wide-sleeved tunics of the type worn as Christian liturgical vestments, or as secular dress in earlier periods, with or without a belt. In modern times it has been sometimes worn by kings or emperors. In the western church, the dalmatic is the outer liturgical vestment of the deacon, worn by bishops under the chasuble at solemn pontifical Masses, and by priests only with permission and on certain occasions; normally priests wear chasubles and subdeacons wear tunicles.</dcterms:description>
  </rdf:Description>
