  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00089">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00089</dcterms:identifier>
    <dcterms:description rdf:nodeID="Ndf4f29540b4d4111ad00105d275ee12a"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300379924"/>
    <rdfs:label xml:lang="en">mercerizing</rdfs:label>
    <dcterms:description xml:lang="en">Treatment of cotton yarn or fabric by immersion in a caustic solution of sodium hydroxide or other chemical base. Fibers so treated swell permanently, and the cotton is made stronger and more lustrous. Named after Alexander Mercer (1791-1866), who perfected the process.</dcterms:description>
  </rdf:Description>
