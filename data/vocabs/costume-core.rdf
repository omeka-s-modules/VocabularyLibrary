  <rdf:Description rdf:nodeID="N8c15f800a77c49ff96e4d20ae77d7e4e">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Hue name for one of the three primary additive colors; that portion of the spectrum lying at the lowest frequencies of light discernible by the human eye, with a wavelength range between 630 and 760 nanometers. The term may refer to any of this group of colors that vary in lightness and saturation. Examples of red color in nature are that of blood and ripe cherries.</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
