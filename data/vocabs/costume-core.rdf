    <rdfs:label xml:lang="en">a skirt with a slight flare, roughly in the shape of a capital letter A</rdfs:label>
    <dcterms:source rdf:resource="https://en.wikipedia.org/wiki/Skirt"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8090e631f0d24c63935dff5de53cb0a7">
    <dcterms:rights rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
    <rdfs:label xml:lang="en">A turnover collar, associated with Emperor Napoleon I Bonaparte's military uniforms; fairly rigid in construction and open at the front, rising high and shaped to frame the wearer's neck and lower head</rdfs:label>
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
    <dcterms:creator>Wikipedia</dcterms:creator>
    <dcterms:source rdf:resource="https://en.wikipedia.org/wiki/Collar_(clothing)"/>
  </rdf:Description>
