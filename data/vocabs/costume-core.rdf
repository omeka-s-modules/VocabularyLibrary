    <rdfs:label xml:lang="en">smocking</rdfs:label>
    <dcterms:description xml:lang="en">Refers to the process applied to a garment or other piece of fabric, comprising gathering tucks and working the tucks with a simple or decorative stitch.</dcterms:description>
    <dcterms:identifier>CC00100</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
