  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/conditionDescription">
    <rdfs:comment xml:lang="en">Narrative description of the overall physical condition, characteristics, and completeness of a work, describing where each issue is located on the garment.</rdfs:comment>
