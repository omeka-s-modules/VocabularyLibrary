    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="https://w3id.org/costumeCore/ontology/CC00465"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00318">
    <dcterms:description xml:lang="en">Generic term for materials derived from vinyl chloride, vinyl acetate, or vinylidene chloride. Commonly used with reference to all polymers and copolymers of which vinyl chloride is a constituent. Use more precise terminology for known materials such as "polyvinyl chloride" or "polyvinyl acetate."</dcterms:description>
    <rdfs:label xml:lang="en">vinyl</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014502"/>
    <dcterms:identifier>CC00318</dcterms:identifier>
    <dcterms:description rdf:nodeID="N0def389c9da64e01bb45f610b7cdccab"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00590">
    <dcterms:description xml:lang="en">Round dots of uniform size repeated at regular intervals so as to form a pattern, usually designated as a pattern for fabric, or otherwise applied to planographic surfaces.</dcterms:description>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q2429962"/>
    <dcterms:identifier>CC00590</dcterms:identifier>
    <rdfs:label xml:lang="en">polka dots</rdfs:label>
    <dcterms:description rdf:nodeID="Nbb04a5a3371b4cbdb2514f329e053d1b"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
