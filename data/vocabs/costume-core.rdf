  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00163">
    <dcterms:description xml:lang="en">Wide, sharply pressed pleats, arranged in a row, evenly spaced and all turned in the same direction. For narrow pleats of a similar nature, use "knife pleats."</dcterms:description>
