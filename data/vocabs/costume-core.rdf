  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00125">
    <dcterms:description xml:lang="en">Loose mantles of undyed woolen cloth worn by men and women of ancient Rome. Also, similar loose wraps made of various fabrics and worn in various historical periods.</dcterms:description>
