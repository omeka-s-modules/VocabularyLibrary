    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00091">
    <dcterms:identifier>CC00091</dcterms:identifier>
    <rdfs:label xml:lang="en">needlepoint</rdfs:label>
    <dcterms:description xml:lang="en">Refers to works created with a needle and thread on fabric or a mesh of canvas. The works are characterized by designs that are executed by using the grid of the fabric to count out the desired position of various stitches or colors in the design.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300264031"/>
    <dcterms:description rdf:nodeID="Nda3680e2efb94bec9c4c9bf2a2e13a08"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
