  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00133">
    <dcterms:identifier>CC00133</dcterms:identifier>
    <dcterms:description rdf:nodeID="Ne2b20233508a4e8c81f53f3108746e9f"/>
    <rdfs:label xml:lang="en">kimono</rdfs:label>
    <dcterms:description xml:lang="en">Loose, wide-sleeved garments fastened around the waist with an obi or broad sash, traditionally worn by Japanese men and women.</dcterms:description>
