  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00165">
    <rdfs:label xml:lang="en">box-pleated</rdfs:label>
    <dcterms:description xml:lang="en">Wide double pleats, with the material folded under at each side. For wide double pleats having the flat fold turned in rather than out, use "inverted pleats."</dcterms:description>
