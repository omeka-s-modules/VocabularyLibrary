    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">In Copyright</dcterms:description>
    <dcterms:identifier>CC00615</dcterms:identifier>
    <dcterms:description rdf:nodeID="Ne4b070500f3f44b79de75b2fd207ee1f"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00198">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="N1d0a5cf980594450afd5377f89981eef"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300400693"/>
    <rdfs:label xml:lang="en">basket weave</rdfs:label>
    <dcterms:description xml:lang="en">Weaving technique with a simple criss-cross checkerboard pattern in which two or more filling yarns, or a single heavier yarn, pass over and under two or more warp yarns.</dcterms:description>
    <dcterms:identifier>CC00198</dcterms:identifier>
  </rdf:Description>
