  <rdf:Description rdf:nodeID="N3b63602a1bfd4d5c9b9a4ff0fa1b4360">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">Sleeveless outer vestments in the form of a wide cloak or mantle that slips over the wearer's head and remains open at the sides. Chasubles are worn over the alb and stole by the celebrant at Mass.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00613">
    <dcterms:description rdf:nodeID="N7422386111c94d2ba122ab2416df4664"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300227830"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q1353860"/>
    <dcterms:description rdf:nodeID="N730c424e93b34e2aaba1172dbdd96a3a"/>
    <rdfs:label xml:lang="en">fringe</rdfs:label>
    <dcterms:description xml:lang="en">Trimming consisting of long or short lengths of straight or twisted thread, cord, or tassel; often grouped or knotted in various designs.</dcterms:description>
    <dcterms:identifier>CC00613</dcterms:identifier>
    <dcterms:description xml:lang="en">Copyright Not Evaluated</dcterms:description>
    <rdfs:label xml:lang="en">CNE</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
