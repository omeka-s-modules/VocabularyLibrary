  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00503">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">redingote</rdfs:label>
