  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00197">
    <dcterms:description xml:lang="en">The long, fine hair from any breed of Angora rabbit. The white French rabbit is favored for its high-quality, soft hair. Angora dyes readily, but is difficult to spin because of its fine texture and it does not felt like common rabbit hair. It is usually mixed with sheep wool or other fibers for weaving.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00197</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300386672"/>
    <dcterms:description rdf:nodeID="N2d431f605470409cadc51eedac6ff50d"/>
    <rdfs:label xml:lang="en">angora</rdfs:label>
  </rdf:Description>
