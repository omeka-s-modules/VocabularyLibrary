  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00272">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Long, slender, flexible, roughly cylindrical construction of fibrous material, usually made of several strands twisted together. Cord is typically made from a type of bast fiber such as cotton, jute, flax, ramie, hemp, sisal, olona, gravata, agel, widuri, caraguata, or others.</dcterms:description>
    <dcterms:identifier>CC00272</dcterms:identifier>
