  <rdf:Description rdf:nodeID="N36e38a30c75d4b6abea16cd526fd8ab6">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Strips of leather, cloth, or other material that pass over the shoulder and from which an article is suspended or a garment is held up. For strips used for fastening, use "straps."</rdfs:label>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
