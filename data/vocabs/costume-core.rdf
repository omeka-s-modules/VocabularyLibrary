  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00493">
    <dcterms:description xml:lang="en">Stiff panels, usually triangular in shape and often heavily decorated, inserted in an open bodice to cover the corset.</dcterms:description>
