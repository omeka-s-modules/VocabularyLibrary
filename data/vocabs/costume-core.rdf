  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00518">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300209265"/>
    <dcterms:description xml:lang="en">Garments worn over other garments as the outer layer, especially those worn for protection from the natural elements. For garments worn for protection from dirt or danger, use descriptors listed under "&lt;protective wear&gt;."</dcterms:description>
    <dcterms:identifier>CC00518</dcterms:identifier>
    <dcterms:description rdf:nodeID="Nf0e08a4ef0ce44b7bf400ee939122ab6"/>
