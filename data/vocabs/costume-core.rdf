    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014247"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neb961fa1c1c34c11b14ac4b74d5c0538">
    <rdfs:label xml:lang="en">Ankle-length garments of various types, but usually having long, narrow sleeves; worn especially members of the clergy and others participating in church services.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
