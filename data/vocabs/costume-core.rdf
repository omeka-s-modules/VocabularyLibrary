  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00123">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300210564"/>
    <dcterms:description xml:lang="en">Underwear usually made the length of the garment under which it is to be worn, thereby taking the place of a lining. Usually applied to full slips with a bodice and shoulder straps made in dress length. Prefer "half slips" for skirtlike underwear extending from the waist to near the hemline of the garment with which it is worn.</dcterms:description>
    <rdfs:label xml:lang="en">slip dress</rdfs:label>
    <dcterms:description rdf:nodeID="N7edf563d66be40ebb814c2f131065ae4"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00123</dcterms:identifier>
  </rdf:Description>
