  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00212">
    <dcterms:identifier>CC00212</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014107"/>
    <dcterms:description xml:lang="en">Textile constructed usually of wool and fur fiber often mixed with natural or synthetic fiber by the interlocking of the loose fiber through the action of heat, moisture, chemicals, and pressure without spinning, weaving, or knitting.</dcterms:description>
    <dcterms:description rdf:nodeID="N847d4a700c2547f387d3686ded2ce7a9"/>
    <rdfs:label xml:lang="en">felt</rdfs:label>
  </rdf:Description>
