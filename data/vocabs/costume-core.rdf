  <rdf:Description rdf:nodeID="N845eea340a9d4379b5e4a3e783d57163">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">Lightweight silk of plain weave.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N36a4928c270e4b6ebfc2be4369bc73de">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">A colorless artificial gem of paste or glass, often with facets that sparkle in imitation of a diamond. Also refers to foil-backed or silvered cut glass used to imitate diamonds. Rhinestones were originally quartz pebbles found in the Rhine River, thus the name.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N36354fe3a0324f82a137ea47a0920f04">
    <rdf:first rdf:resource="https://w3id.org/costumeCore/ontology/CC00451"/>
    <rdf:rest rdf:nodeID="N6608caf533b645109a4cfd5a2e2d4063"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc0b0ca11f52b4e64b7b2511f4048cd6b">
    <rdfs:label xml:lang="en">Sheer, lightweight plain-woven textile of fine, tightly-twisted yarn, originally of silk now also of various synthetic fibers, used, for example, for scarves, dresses, blouses, underwear, and veils. (AAT)</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
  </rdf:Description>
