  <rdf:Description rdf:nodeID="N9e94ac831bdc40b18f05caa09a77593e">
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">A semi-transparent artificial fiber or natural silk fabric woven in plain weave with undeterred chain and weft threads, alternately two right and two left twisted.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne3f63a72e1db400ca5d34ffbc744e3e7">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <rdfs:label xml:lang="en">The characteristic pattern known from plaid textiles, consisting of bars or stripes of various colors crossing each other at right angles over a contrasting background color, whether or not the pattern exists on a textile or another material. Plaid patterns were known from ancient times in many cultures.</rdfs:label>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
