  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00101">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300053642"/>
    <dcterms:identifier>CC00101</dcterms:identifier>
    <dcterms:description xml:lang="en">Generally, the process of interlacing strands or strips of various materials, such as cane, textile, or twigs, to make materials or objects such as wicker, cloth, baskets, or wreaths. Specifically used for the process of making textile on a loom or other weaving device by interlacing warp and weft in a particular order.</dcterms:description>
    <dcterms:description rdf:nodeID="N28ab51ef1360460dbb3c30d5e2326e1b"/>
    <rdfs:label xml:lang="en">weaving</rdfs:label>
  </rdf:Description>
