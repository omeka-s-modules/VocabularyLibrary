  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00214">
    <dcterms:description rdf:nodeID="N9e94ac831bdc40b18f05caa09a77593e"/>
    <dcterms:identifier>CC00214</dcterms:identifier>
    <dcterms:description xml:lang="en">A semi-transparent artificial fiber or natural silk fabric woven in plain weave with undeterred chain and weft threads, alternately two right and two left twisted.</dcterms:description>
    <rdfs:label xml:lang="en">georgette</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300417883"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00057">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00057</dcterms:identifier>
    <dcterms:description xml:lang="en">A range of yellowish colors, typically with undertones of red or brown, resembling the color of the lustrous metal, gold. (AAT)</dcterms:description>
