  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf8436b2a0e004fbcb3bff785cfaeac9c">
    <rdfs:label xml:lang="en">Fine, soft, thick, hairy coat of a mammal, usually consisting of a double coat of hair that includes a layer of comparatively short, soft, curly barbed hair next to the skin, protected by longer, smoother, stiffer hair growing up through it.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
