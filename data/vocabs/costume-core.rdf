  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00522">
    <rdfs:label xml:lang="en">shift</rdfs:label>
    <dcterms:description rdf:nodeID="N8d2bb4a5d47f4118acffd311d5a2723f"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Dresses which hang straight from the shoulders, sometimes tapering slightly at hips.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300214100"/>
    <dcterms:identifier>CC00522</dcterms:identifier>
