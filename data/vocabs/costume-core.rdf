    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300210423"/>
    <rdfs:label xml:lang="en">cassocks (liturgical costume)</rdfs:label>
    <dcterms:description xml:lang="en">Ankle-length garments of various types, but usually having long, narrow sleeves; worn especially members of the clergy and others participating in church services.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
