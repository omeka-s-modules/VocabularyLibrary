  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00570">
    <dcterms:description xml:lang="en">decade</dcterms:description>
    <dcterms:identifier>CC00570</dcterms:identifier>
    <dcterms:description rdf:nodeID="Na702ba941866462b95b38049ff9f7df8"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q35702"/>
    <rdfs:label xml:lang="en">1930s</rdfs:label>
