  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00232">
    <dcterms:description xml:lang="en">A general term for any of a large and varied class of natural or synthetic organic materials that can be molded, extruded, or cast when soft or liquid, and then set into a rigid or slightly elastic form. Natural plastics include tree resins, beeswax, gutta-percha, horn, and clay. Synthetic plastics were first made in the 19th century. Plastics are used widely in manufacturing.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014570"/>
    <rdfs:label xml:lang="en">plastic</rdfs:label>
    <dcterms:description rdf:nodeID="Na43e766f1a1549d5bf41bccdaaf75b2d"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00232</dcterms:identifier>
  </rdf:Description>
