  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00292">
    <rdfs:label xml:lang="en">mother of pearl</rdfs:label>
    <dcterms:description rdf:nodeID="N5c586fefa7a849f08d5cf84c81a0ccba"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Hard, pearly, iridescent internal layer of various kinds of mollusk shell, extensively used for making small articles and inlays.</dcterms:description>
    <dcterms:identifier>CC00292</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300011835"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00055">
    <rdfs:label xml:lang="en">cream</rdfs:label>
    <dcterms:identifier>CC00055</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300266242"/>
    <dcterms:description rdf:nodeID="Nc58fe8c4ec6f49de957d85fed628e579"/>
    <dcterms:description xml:lang="en">Refers to a warm off-white color of various shades, reminiscent of the color of cream, which is the whitish-yellowish fatty thick material in milk that floats to the top.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00293">
    <dcterms:description rdf:nodeID="N4434866b971e4c108c329cdecbc5b573"/>
    <dcterms:identifier>CC00293</dcterms:identifier>
