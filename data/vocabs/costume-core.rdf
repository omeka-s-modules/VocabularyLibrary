    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300045514"/>
    <rdfs:label xml:lang="en">jet</rdfs:label>
    <dcterms:description xml:lang="en">A dense, black, semiprecious form of lignite that takes a brilliant polish and is used ornamentally, particularly in Victorian mourning jewelry.</dcterms:description>
    <dcterms:identifier>CC00284</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="Ndfbce97a458242d9a9318b837a334c45"/>
  </rdf:Description>
