  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00286">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Outgrowths, usually green and flattened, that extend from the stem of a vascular plant. Botanically, leaves are an integral part of the stem system, and they are initiated in the apical bud along with the tissues of the stem itself. Leaves manufacture food for plants, which in turn ultimately nourish and sustain all land animals, directly or indirectly.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300400479"/>
    <rdfs:label xml:lang="en">leaves</rdfs:label>
    <dcterms:identifier>CC00286</dcterms:identifier>
    <dcterms:description rdf:nodeID="N88221e9958714feb8471538c5a15135e"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb2c6a6756eb944a8a304c520325ba945">
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <rdfs:label xml:lang="en">Sewing by hand, as distinct from sewing by machine.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
  </rdf:Description>
