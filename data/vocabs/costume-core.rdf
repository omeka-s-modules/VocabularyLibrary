    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">fit and flare</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N81197008878a485f925767d7a7e64b27">
    <rdf:rest rdf:nodeID="Nfe15c47dffb24ce0911b82eea734796c"/>
