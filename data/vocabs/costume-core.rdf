  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00509">
    <dcterms:description xml:lang="en">Clothing designed or worn for a wedding.</dcterms:description>
    <rdfs:label xml:lang="en">wedding clothes</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="Na53a658c2d034b2b9e3c3820b50f03e7"/>
