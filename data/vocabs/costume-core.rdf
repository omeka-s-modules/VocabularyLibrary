  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00260">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300183634"/>
    <rdfs:label xml:lang="en">batiste</rdfs:label>
    <dcterms:description xml:lang="en">Fine, soft, sheer cloth of plain weave made of any of the principal types of fiber, such as cotton, linen, rayon, silk, or wool.</dcterms:description>
