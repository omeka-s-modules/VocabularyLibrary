  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00274">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00274</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300417880"/>
    <dcterms:description xml:lang="en">Irregular, rough silk reeled from double cocoons or cocoons spun side-by-side that have interlocked. The surface can be recognized by the irregular relief caused by the uneven width of the yarns, and this quality makes it difficult to distinguish from wild silk.</dcterms:description>
