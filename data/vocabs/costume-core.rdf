  <rdf:Description rdf:nodeID="N1e151817c4574399b2721cb69033af6e">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">Technique of forming a design by applying cut out pieces of a material to a ground material; generally associated with needleworking, but also used in ceramics, leatherworking, woodworking, and metalworking.</rdfs:label>
