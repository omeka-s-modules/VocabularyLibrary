    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Any woven figured textile produced on a Jacquard loom.</dcterms:description>
    <rdfs:label xml:lang="en">jacquard</rdfs:label>
  </rdf:Description>
