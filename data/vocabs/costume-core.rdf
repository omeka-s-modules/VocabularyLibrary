    <rdfs:label xml:lang="en">gray</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd1a577b7bf7c4334860e48e5bbadcfff">
    <dcterms:license rdf:resource="https://creativecommons.org/publicdomain/mark/1.0/"/>
    <rdfs:label xml:lang="en">in sewing, a pointed fold used to take up ease or shape a garment</rdfs:label>
