  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00459">
    <dcterms:description xml:lang="en">Garments worn for protection against dirt or danger. For garments worn for protection from weather, use "outerwear" or its narrower terms.</dcterms:description>
