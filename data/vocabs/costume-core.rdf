  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00208">
    <dcterms:description xml:lang="en">Woven figured textile with one warp and one weft in which the pattern is formed by a contrast of binding systems, and appears on the face and the back in reverse positions.</dcterms:description>
