  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00376">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Uniforms for school children, which are often made mandatory. School uniform designs vary, but may consist of a jacket and a skirt or a pair of pants, a collared shirt and a type of neckwear. Originally these may have been inspired by formal wear, military, or marine uniforms.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300417888"/>
