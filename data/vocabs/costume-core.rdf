  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00244">
    <rdfs:label xml:lang="en">synthetic fiber</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Fiber made from chemical substances, used for textile production.</dcterms:description>
    <dcterms:description rdf:nodeID="Ndb9e8e9f06854d2888636867c91178f7"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300014058"/>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q5856"/>
