  <rdf:Description rdf:nodeID="N1cf216d5117f4698a95b188691f70c0f">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <rdfs:label xml:lang="en">Mode of dress for a fashionable women in the 19th and 20th centuries; dinner dress is less formal than evening wear, ensembles often include sleeves, or open decolletage.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na53a658c2d034b2b9e3c3820b50f03e7">
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
