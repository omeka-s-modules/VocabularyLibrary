    <dcterms:identifier>CC00038</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">A turnover collar, associated with Emperor Napoleon I Bonaparte's military uniforms; fairly rigid in construction and open at the front, rising high and shaped to frame the wearer's neck and lower head</dcterms:description>
    <rdfs:label xml:lang="en">Napoleon collar</rdfs:label>
  </rdf:Description>
