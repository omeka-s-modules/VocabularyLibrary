  <rdf:Description rdf:nodeID="Nd72bf513cbcc40c298d24e9a2e5d38d7">
    <rdfs:label xml:lang="en">Hue name for the range of colors intermediate between red and white, often a pale red, sometimes with a slight purple or yellow tinge. (AAT)</rdfs:label>
