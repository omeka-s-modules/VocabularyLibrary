  <rdf:Description rdf:nodeID="N9e506bb369d64edeb4ed3b7a17ffdc79">
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">A substance, in the form of a liquid, paste, powder, or dry film; used for sticking or adhering one surface to another. A substance capable of holding materials together by a surface attachment.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N70b1142dec3c431c8e8c58501d24f289">
    <rdf:first rdf:resource="https://w3id.org/costumeCore/ontology/CC00073"/>
