  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00237">
    <dcterms:description xml:lang="en">Woven fabrics with ribbed or corded effects in either the warp or filling direction. Warp faced rib weave has a fine warp covering a thicker weft. In weft faced rib weave, a thin weft completely covers a thicker warp.</dcterms:description>
    <rdfs:label xml:lang="en">rib weave</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:identifier>CC00237</dcterms:identifier>
