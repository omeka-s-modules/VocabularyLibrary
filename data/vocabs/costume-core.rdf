  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00051">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Hue name for one of the three primary additive colors; that portion of the spectrum lying between green and violet, with a wavelength of about 420 to 490 nanometers, which is the shortest wavelength range of the three primary colors. The term may refer to any of this group of colors that vary in lightness and saturation. An example of blue color in nature is that of a clear sky during the day. (AAT)</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300129361"/>
    <rdfs:label xml:lang="en">blue</rdfs:label>
    <dcterms:description rdf:nodeID="Na76840c04b13423a910d6371885c95d4"/>
    <dcterms:identifier>CC00051</dcterms:identifier>
  </rdf:Description>
