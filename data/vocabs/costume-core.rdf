  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00386">
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300189599"/>
    <dcterms:description xml:lang="en">Stage of adult life between young adulthood and old age; in humans, commonly defined as extending from 45 to 65.</dcterms:description>
