  <rdf:Description rdf:nodeID="N1713c082b4394fcfb9fc4d442ce5f1fa">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <rdfs:label xml:lang="en">Pendant trimming. Before the 20th century, usually a wooden mold covered with strands of silk or worsted; now often merely a bunch of threads, cords, or other strands gathered together at the top.</rdfs:label>
