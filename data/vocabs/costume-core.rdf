    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <rdfs:label xml:lang="en">Plain-woven textile, originally of silk, now made also of wool, cotton, and synthetic fibers, characterized by slight, flat ribs in the weft; used, for example, for women's suits and dresses, hats, trimmings, and interior furnishings.</rdfs:label>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
