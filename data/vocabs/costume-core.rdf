  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00304">
    <rdfs:label xml:lang="en">rhinestones</rdfs:label>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300010806"/>
    <dcterms:description rdf:nodeID="N36a4928c270e4b6ebfc2be4369bc73de"/>
    <dcterms:description xml:lang="en">A colorless artificial gem of paste or glass, often with facets that sparkle in imitation of a diamond. Also refers to foil-backed or silvered cut glass used to imitate diamonds. Rhinestones were originally quartz pebbles found in the Rhine River, thus the name.</dcterms:description>
    <dcterms:identifier>CC00304</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
