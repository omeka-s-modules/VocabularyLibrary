  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00299">
    <dcterms:identifier>CC00299</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300375581"/>
    <rdfs:label xml:lang="en">pineapple fiber</rdfs:label>
    <dcterms:description rdf:nodeID="Nffa9749fa2b149bf82f17c352de6fab5"/>
    <dcterms:description xml:lang="en">Long bast fibers obtained from the leaves of the species Ananas comosus, native to tropical America. The fibers are fine, soft, lustrous, and light cream in color. They are resistant to salt water, strong, wear resistant, and easy to clean; used for fabric, rope, twine, and paper.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00161">
