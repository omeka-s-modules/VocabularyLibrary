  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00312">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="N1713c082b4394fcfb9fc4d442ce5f1fa"/>
    <dcterms:identifier>CC00312</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300232185"/>
    <dcterms:description xml:lang="en">Pendant trimming. Before the 20th century, usually a wooden mold covered with strands of silk or worsted; now often merely a bunch of threads, cords, or other strands gathered together at the top.</dcterms:description>
    <rdfs:label xml:lang="en">tassel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00095">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description xml:lang="en">Double folding a definite, even width of fabric and fixing it in place by sewing or pressing or both.</dcterms:description>
    <dcterms:description rdf:nodeID="Nb5e3204c2b2c4a0a867a7e9e7153a380"/>
    <dcterms:identifier>CC00095</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300227874"/>
    <rdfs:label xml:lang="en">pleating</rdfs:label>
  </rdf:Description>
