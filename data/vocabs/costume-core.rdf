  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00242">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">silk</rdfs:label>
    <dcterms:description xml:lang="en">Textile made from silk fiber, which is a fiber derived from the cocoon of the silkworm moth.</dcterms:description>
    <dcterms:identifier>CC00242</dcterms:identifier>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300243428"/>
    <dcterms:description rdf:nodeID="N6afb744b1257405e8a030ea043648cee"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7e0d1b3b30bb4d9295150ada6341c284">
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
    <rdfs:label xml:lang="en">Long, wide-sleeved tunics of the type worn as Christian liturgical vestments, or as secular dress in earlier periods, with or without a belt. In modern times it has been sometimes worn by kings or emperors. In the western church, the dalmatic is the outer liturgical vestment of the deacon, worn by bishops under the chasuble at solemn pontifical Masses, and by priests only with permission and on certain occasions; normally priests wear chasubles and subdeacons wear tunicles.</rdfs:label>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00245">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dcterms:description rdf:nodeID="N894b62c3cf38497aa5bde4ad64bc7772"/>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300249434"/>
    <dcterms:identifier>CC00245</dcterms:identifier>
    <dcterms:description xml:lang="en">Crisp textile, typically in plain weave, sometimes with a fine crosswise rib and a smooth lustrous surface on both sides, originally of silk, now of various fibers.</dcterms:description>
    <rdfs:label xml:lang="en">taffeta</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb70eae85ba3f453b9df00b3a3dd1cc91">
    <dcterms:source rdf:resource="http://www.getty.edu/research/tools/vocabularies/aat/"/>
    <dcterms:license rdf:resource="https://opendatacommons.org/licenses/by/1-0/"/>
    <rdfs:label xml:lang="en">decorative slit cut in any part of a garment, especially sleeves and legs, to reveal an inner garment or lining</rdfs:label>
    <dcterms:creator>The J. Paul Getty Trust</dcterms:creator>
    <dcterms:rights rdf:resource="http://rightsstatements.org/vocab/InC/1.0/"/>
  </rdf:Description>
