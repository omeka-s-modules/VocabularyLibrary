    <rdfs:label xml:lang="en">scroll</rdfs:label>
    <dcterms:description xml:lang="en">General term for motifs consisting of a spirally wound band. For simple motifs of coiled lines, use "spirals"; for scroll-shaped architectural elements use other terms, such as "consoles" and "volutes"; for a series of scrolls, in running or allover patterns, use "scrollwork."</dcterms:description>
    <dcterms:identifier>CC00585</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
