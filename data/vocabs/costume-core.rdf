  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00311">
    <rdfs:label xml:lang="en">straw</rdfs:label>
    <dcterms:description xml:lang="en">Dried stalks of cereals or other grasses, used for many purposes, including weaving, plaiting, and braiding.</dcterms:description>
    <owl:sameAs rdf:resource="http://vocab.getty.edu/aat/300011908"/>
