    <dcterms:identifier>CC00436</dcterms:identifier>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">sweat pants</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/costumeCore/ontology/CC00506">
    <rdfs:label xml:lang="en">court dress</rdfs:label>
    <owl:sameAs rdf:resource="http://www.wikidata.org/entity/Q29405103"/>
