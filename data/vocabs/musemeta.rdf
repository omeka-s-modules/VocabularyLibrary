    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:reg="http://metadataregistry.org/uri/profile/regap/"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#">

<!-- Element Set: MuseMeta -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta">
  <dc:title xml:lang="en">MuseMeta</dc:title>
  <foaf:homepage rdf:resource="https://depts.washington.edu/musmeta/Welcome.html"/>
  <skos:note  xml:lang="en">An attribute set developed for museum metadata applications by the MuseMeta project at the University of Washington iSchool</skos:note>
</rdf:Description>

<!-- Properties -->

<!-- Property: Accessioned by  -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/accessionedBy">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">accessionedBy</reg:name>
  <rdfs:label xml:lang="en">Accessioned by </rdfs:label>
  <skos:definition xml:lang="en">Museum staff responsible for accessioning  object</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="dcam:VocabularyEncodingScheme" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/contributor" />
</rdf:Description>

<!-- Property: Accession Method -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/accessionMethod">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">accessionMethod</reg:name>
  <rdfs:label xml:lang="en">Accession Method</rdfs:label>
  <skos:definition xml:lang="en">How the museum legally acquired the object or objects</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PROC" />
  <rdfs:range rdf:resource="dcam:VocabularyEncodingScheme" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/accrualMethod" />
</rdf:Description>

<!-- Property: Accession number -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/accessionNumber">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">accessionNumber</reg:name>
  <rdfs:label xml:lang="en">Accession number</rdfs:label>
  <skos:definition xml:lang="en">Identification number assigned to a particular donation or acquisition</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/IDE" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/identifier" />
</rdf:Description>

<!-- Property: Acquisition price -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/acquisitionPrice">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">acquisitionPrice</reg:name>
  <rdfs:label xml:lang="en">Acquisition price</rdfs:label>
  <skos:definition xml:lang="en">Purchase price of object</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/FIN" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/accrualMethod" />
</rdf:Description>

<!-- Property: Acquisition value -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/acquisitionValue">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">acquisitionValue</reg:name>
  <rdfs:label xml:lang="en">Acquisition value</rdfs:label>
  <skos:definition xml:lang="en">Appraisal value at time of acquisition</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/FIN" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/accrualMethod" />
</rdf:Description>

<!-- Property: Additional Remarks -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/additionalRemarks">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">additionalRemarks</reg:name>
  <rdfs:label xml:lang="en">Additional Remarks</rdfs:label>
  <skos:definition xml:lang="en">Catch-all miscellaneous</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/NOT" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/description" />
</rdf:Description>

<!-- Property: Alternate title -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/alternateTitle">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">alternateTitle</reg:name>
  <rdfs:label xml:lang="en">Alternate title</rdfs:label>
  <skos:definition xml:lang="en">Another title for the object</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/TIT" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/title" />
  <skos:altLabel xml:lang="en">Descriptive line, Alternate Name , descriptive title</skos:altLabel>
</rdf:Description>

<!-- Property: Approved by -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/approvedBy">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">approvedBy</reg:name>
  <rdfs:label xml:lang="en">Approved by</rdfs:label>
  <skos:definition xml:lang="en">Museum staff responsible for the approval of the acquisition of the object</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="dcam:VocabularyEncodingScheme" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/contributor" />
</rdf:Description>

<!-- Property: Artist Dates -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/artistDates">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">artistDates</reg:name>
  <rdfs:label xml:lang="en">Artist Dates</rdfs:label>
  <skos:definition xml:lang="en">The lifespan of the artist, including date of birth and death</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/DAT" />
  <rdfs:range rdf:resource="http://purl.org/dc/terms/W3CDTF" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/temporal" />
</rdf:Description>

<!-- Property: Artist/maker attributor -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/artistMakerAttributor">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">artistMakerAttributor</reg:name>
  <rdfs:label xml:lang="en">Artist/maker attributor</rdfs:label>
  <skos:definition xml:lang="en">Person who ascribes attribution the artist or maker of the work</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/contributor" />
</rdf:Description>

<!-- Property: Artist Signature -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/artistSignature">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">artistSignature</reg:name>
  <rdfs:label xml:lang="en">Artist Signature</rdfs:label>
  <skos:definition xml:lang="en">The mark of the artist on a piece of work</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/MAR" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/identifier" />
</rdf:Description>

<!-- Property: Attribution date -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/attributionDate">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">attributionDate</reg:name>
  <rdfs:label xml:lang="en">Attribution date</rdfs:label>
  <skos:definition xml:lang="en">Date that the art work was linked the artist or marker</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/DAT" />
  <rdfs:range rdf:resource="http://purl.org/dc/terms/W3CDTF" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/temporal" />
</rdf:Description>

<!-- Property: Authorization date -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/authorizationDate">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">authorizationDate</reg:name>
  <rdfs:label xml:lang="en">Authorization date</rdfs:label>
  <skos:definition xml:lang="en">Date object was authorized for repatriation under NAGPRA</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/DAT" />
  <rdfs:range rdf:resource="http://purl.org/dc/terms/W3CDTF" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/temporal" />
</rdf:Description>

<!-- Property: Authorized by -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/authorizedBy">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">authorizedBy</reg:name>
  <rdfs:label xml:lang="en">Authorized by</rdfs:label>
  <skos:definition xml:lang="en">Person responsible for repatriation according to  NAGPRA standards</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/contributor" />
</rdf:Description>

<!-- Property: Borrower -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/borrower">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">borrower</reg:name>
  <rdfs:label xml:lang="en">Borrower</rdfs:label>
  <skos:definition xml:lang="en">Entity receiving the loan</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/mediator" />
</rdf:Description>

<!-- Property: Catalog date -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/catalogDate">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">catalogDate</reg:name>
  <rdfs:label xml:lang="en">Catalog date</rdfs:label>
  <skos:definition xml:lang="en">Date that catalog record is created</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/DAT" />
  <rdfs:range rdf:resource="http://purl.org/dc/terms/W3CDTF" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/temporal" />
</rdf:Description>

<!-- Property: Catalog number -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/catalogNumber">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">catalogNumber</reg:name>
  <rdfs:label xml:lang="en">Catalog number</rdfs:label>
  <skos:definition xml:lang="en">Unique identification number assigned to each object at time of accession </skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/IDE" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/identifier" />
  <skos:altLabel xml:lang="en">Object Number, Number, Museum number</skos:altLabel>
</rdf:Description>

<!-- Property: Categories -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/categories">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">categories</reg:name>
  <rdfs:label xml:lang="en">Categories</rdfs:label>
  <skos:definition xml:lang="en">Descriptive information that puts the object into relationships with other objects or processes.  Determined through controlled vocabulary (e.g., AAT, Nomenclature, TGN)</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/CAT" />
  <rdfs:range rdf:resource="dcam:VocabularyEncodingScheme" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/type" />
  <skos:altLabel xml:lang="en">Class</skos:altLabel>
</rdf:Description>

<!-- Property: Circumference -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/circumference">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">circumference</reg:name>
  <rdfs:label xml:lang="en">Circumference</rdfs:label>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PHY" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/extent" />
</rdf:Description>

<!-- Property: Claimant(s) -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/claimants">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">claimants</reg:name>
  <rdfs:label xml:lang="en">Claimant(s)</rdfs:label>
  <skos:definition xml:lang="en">Interest party(ies) asserting cultural affiliation to an object according to NAGPRA standards</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/PER" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/rightsholder" />
</rdf:Description>

<!-- Property: Class (of animal) -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/class">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">class</reg:name>
  <rdfs:label xml:lang="en">Class (of animal)</rdfs:label>
  <skos:definition xml:lang="en">A level in biological taxonomy</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/CAT" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/NET/biol/ns/class" />
</rdf:Description>

<!-- Property: Collection -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/collection">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">collection</reg:name>
  <rdfs:label xml:lang="en">Collection</rdfs:label>
  <skos:definition xml:lang="en">The name of the collection to which the object belongs</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/TIT" />
  <rdfs:range rdf:resource="dcam:VocabularyEncodingScheme" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/hasPart" />
</rdf:Description>

<!-- Property: Collection code -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/collectionCode">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">collectionCode</reg:name>
  <rdfs:label xml:lang="en">Collection code</rdfs:label>
  <skos:definition xml:lang="en">Alphanumeric identification of a collection</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="http://metadataregistry.org/uri/MuseMetaCategories/IDE" />
  <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
  <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/identifier" />
</rdf:Description>

<!-- Property: Collection type -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/musemeta/collectionType">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/musemeta" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1002" />
  <reg:name xml:lang="en">collectionType</reg:name>
  <rdfs:label xml:lang="en">Collection type</rdfs:label>
  <skos:definition xml:lang="en">The type of collection catgorized by material type, cultural affiliation, or Donor (eg. Ceramic Collection, Hopi Collection, Smith Collection</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
