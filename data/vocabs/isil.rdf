  <dc:title xml:lang="en">ISIL</dc:title>
  <foaf:homepage rdf:resource="http://biblstandard.dk/isil/"/>
</rdf:Description>

<!-- Properties -->

<!-- Property: has ill status -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/isil/hasIllStatus">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/isil" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001" />
  <reg:name xml:lang="en">hasIllStatus</reg:name>
  <rdfs:label xml:lang="en">has ill status</rdfs:label>
  <skos:definition xml:lang="en">Relates an Agent to its inter library loan status</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:comment xml:lang="en">Relates an Agent to its inter library loan status</rdfs:comment>
  <rdfs:domain rdf:resource="foaf:Agent" />
  <rdfs:range rdf:resource="xsd:anyURI" />
</rdf:Description>

<!-- Property: has isil -->
<rdf:Description rdf:about="http://metadataregistry.org/uri/schema/isil/isil">
  <rdfs:isDefinedBy rdf:resource="http://metadataregistry.org/uri/schema/isil" />
  <reg:status rdf:resource="http://metadataregistry.org/uri/RegStatus/1001" />
  <reg:name xml:lang="en">isil</reg:name>
  <rdfs:label xml:lang="en">has isil</rdfs:label>
  <skos:definition xml:lang="en">Relates an Agent to its ISIL.</skos:definition>
  <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property" />
  <rdfs:domain rdf:resource="foaf:Agent" />
  <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/identifier" />
</rdf:Description>


<!-- Status properties used in this document  -->
    <skos:Concept rdf:about="http://metadataregistry.org/uri/RegStatus/1001">
