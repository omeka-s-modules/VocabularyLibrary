nomLang:  rdf:type     skos:ConceptScheme;
        dcterms:title  "Nomenclature - Langues"@fr , "Nomenclature - Languages"@en .

foaf:nick  rdf:type       owl:DatatypeProperty , rdf:Property;
        rdfs:comment      "A short informal nickname characterising an agent (includes login identifiers, IRC and other chat nicknames).";
        rdfs:isDefinedBy  foaf:;
        rdfs:label        "nickname";
        vs:term_status    "testing" .

foaf:name  rdf:type         owl:DatatypeProperty , rdf:Property;
        rdfs:comment        "A name for some thing.";
        rdfs:domain         owl:Thing;
        rdfs:isDefinedBy    foaf:;
        rdfs:label          "name";
        rdfs:range          rdfs:Literal;
        rdfs:subPropertyOf  rdfs:label;
        vs:term_status      "testing" .

lingvoj:tag  rdf:type       owl:DatatypeProperty;
        rdfs:comment        "A tag para ser usada, por exemplo como valor de xml:lang. Ver https://tools.ietf.org/html/bcp47"@pt , "例えばxml:langの値として、言語に用いるタグ。https://tools.ietf.org/html/bcp47を参照"@ja , "La etiqueta a utilizar para el lenguaje, por ejemplo como valor de xml:lang. Ver https://tools.ietf.org/html/bcp47"@es , "Le tag à utiliser pour la langue, par exemple comme valeur de xml:lang. Voir https://tools.ietf.org/html/bcp47"@fr , "The tag to use for the language, for example as value of xml:lang. See https://tools.ietf.org/html/bcp47"@en;
        rdfs:domain         lingvoj:Lingvo;
        rdfs:label          "tag de idioma"@pt , "taal tag"@nl , "言語タグ"@ja , "etiqueta"@es , "tag de langue"@fr , "language tag"@en;
        rdfs:subPropertyOf  dcterms:identifier .

schema1:thumbnail  rdf:type     rdf:Property;
        rdfs:comment            "Thumbnail image for an image or video.";
        rdfs:label              "thumbnail";
        schema1:domainIncludes  schema1:VideoObject , schema1:ImageObject;
        schema1:rangeIncludes   schema1:ImageObject .

schema1:sameAs  rdf:type        rdf:Property;
        rdfs:comment            "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website.";
        rdfs:label              "sameAs";
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:URL .

schema1:DefinedTermSet
        rdf:type          rdfs:Class;
        rdfs:comment      "A set of defined terms for example a set of categories or a classification scheme, a glossary, dictionary or enumeration.";
        rdfs:label        "DefinedTermSet";
        rdfs:subClassOf   schema1:CreativeWork;
        schema1:isPartOf  <https://pending.schema.org>;
        schema1:source    <https://github.com/schemaorg/schemaorg/issues/894> .

foaf:Agent  rdf:type         owl:Class , rdfs:Class;
        rdfs:comment         "An agent (eg. person, group, software or physical artifact).";
        rdfs:label           "Agent";
        owl:equivalentClass  dcterms:Agent;
        vs:term_status       "stable" .

nomAgent:2  rdf:type    foaf:Agent;
        schema1:sameAs  wd:Q3456610;
        foaf:name       "Réseau canadien d’information sur le patrimoine (RCIP)"@fr , "Canadian Heritage Information Network (CHIN)"@en;
        foaf:nick       "RCIP" , "CHIN" .

nomo:   rdf:type                       owl:Ontology;
        rdfs:comment                   "L'ontologie de NOM définit les valeurs utilisées dans Nomenclature pour le catalogage des objets de musée. Elle utilise les ontologies SKOS, SKOS-XL, DC, DCT, FOAF, Schema, Lexinfo, Changeset."@fr , "NOM Ontology defines the values used in Nomenclature for Museum Cataloging. It uses the SKOS, SKOS-XL, DC, DCT, FOAF, Schema, Lexinfo, Changeset ontologies."@en;
        rdfs:label                     "Ontologie de Nomenclature pour le catalogage des objets de musée"@fr , "Nomenclature for Museum Cataloging Ontology"@en;
        rdfs:seeAlso                   <https://nomenclature.info/.well-known/void> , wd:Q64351785 , wd:P7749 , <https://nomenclature.info/>;
        dc:description                 "NOM Ontology defines the values used in Nomenclature for Museum Cataloging. It uses the SKOS, SKOS-XL, DC, DCT, FOAF, Schema, Lexinfo, Changeset ontologies."@en , "L'ontologie de NOM définit les valeurs utilisées dans Nomenclature pour le catalogage des objets de musée. Elle utilise les ontologies SKOS, SKOS-XL, DC, DCT, FOAF, Schema, Lexinfo, Changeset."@fr;
        dc:format                      "meta/rdf-schema";
        dc:title                       "Nomenclature for Museum Cataloging Ontology"@en , "Ontologie de Nomenclature pour le catalogage des objets de musée"@fr;
        dcterms:created                "2022-02-28"^^xsd:date;
        dcterms:creator                nomAgent:2;
        dcterms:license                <http://creativecommons.org/licenses/by/4.0/>;
        dcterms:modified               "2022-04-22"^^xsd:date;
        vann:preferredNamespacePrefix  "nomo";
        vann:preferredNamespaceUri     "https://nomenclature.info/nom/ontology/";
        owl:versionInfo                "1.0" .

schema1:Organization  rdf:type  rdfs:Class;
        rdfs:comment     "An organization such as a school, NGO, corporation, club, etc.";
        rdfs:label       "Organization";
        rdfs:subClassOf  schema1:Thing .

foaf:primaryTopic  rdf:type  owl:FunctionalProperty , owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The primary topic of some page or document.";
        rdfs:domain       foaf:Document;
        rdfs:isDefinedBy  foaf:;
        rdfs:label        "primary topic";
        rdfs:range        owl:Thing;
        owl:inverseOf     foaf:isPrimaryTopicOf;
        vs:term_status    "stable" .

schema1:contentSize  rdf:type   rdf:Property;
        rdfs:comment            "File size in (mega/kilo) bytes.";
        rdfs:label              "contentSize";
        schema1:domainIncludes  schema1:MediaObject;
        schema1:rangeIncludes   schema1:Text .

schema1:encodingFormat
        rdf:type                rdf:Property;
        rdfs:comment            "Media type typically expressed using a MIME format (see [IANA site](http://www.iana.org/assignments/media-types/media-types.xhtml) and [MDN reference](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types)) e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.).\r\n\r\nIn cases where a [[CreativeWork]] has several media type representations, [[encoding]] can be used to indicate each [[MediaObject]] alongside particular [[encodingFormat]] information.\r\n\r\nUnregistered or niche encoding and file formats can be indicated instead via the most appropriate URL, e.g. defining Web page or a Wikipedia/Wikidata entry.";
        rdfs:label              "encodingFormat";
        schema1:domainIncludes  schema1:MediaObject , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Text , schema1:URL .

schema1:DataDownload  rdf:type  rdfs:Class;
        rdfs:comment         "A dataset in downloadable form.";
        rdfs:label           "DataDownload";
        rdfs:subClassOf      schema1:MediaObject;
        schema1:source       <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_DatasetClass>;
        owl:equivalentClass  dcat:Distribution .

schema1:dateCreated  rdf:type   rdf:Property;
        rdfs:comment            "The date on which the CreativeWork was created or the item was added to a DataFeed.";
        rdfs:label              "dateCreated";
        schema1:domainIncludes  schema1:DataFeedItem , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:DateTime , schema1:Date .

schema1:distribution  rdf:type  rdf:Property;
        rdfs:comment            "A downloadable form of this dataset, at a specific location, in a specific format.";
        rdfs:label              "distribution";
        schema1:domainIncludes  schema1:Dataset;
        schema1:rangeIncludes   schema1:DataDownload .

schema1:keywords  rdf:type      rdf:Property;
        rdfs:comment            "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property.";
        rdfs:label              "keywords";
        schema1:domainIncludes  schema1:Product , schema1:Place , schema1:Event , schema1:Organization , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:DefinedTerm , schema1:Text , schema1:URL .

schema1:about  rdf:type         rdf:Property;
        rdfs:comment            "The subject matter of the content.";
        rdfs:label              "about";
        schema1:domainIncludes  schema1:CommunicateAction , schema1:Event , schema1:CreativeWork;
        schema1:inverseOf       schema1:subjectOf;
        schema1:rangeIncludes   schema1:Thing;
        schema1:source          <https://github.com/schemaorg/schemaorg/issues/1670> .

schema1:publisher  rdf:type     rdf:Property;
        rdfs:comment            "The publisher of the creative work.";
        rdfs:label              "publisher";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Person , schema1:Organization .

schema1:license  rdf:type       rdf:Property;
        rdfs:comment            "A license document that applies to this content, typically indicated by URL.";
        rdfs:label              "license";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:rangeIncludes   schema1:URL , schema1:CreativeWork .

schema1:inLanguage  rdf:type    rdf:Property;
        rdfs:comment            "The language of the content or performance or used in an action. Please use one of the language codes from the [IETF BCP 47 standard](http://tools.ietf.org/html/bcp47). See also [[availableLanguage]].";
        rdfs:label              "inLanguage";
        schema1:domainIncludes  schema1:WriteAction , schema1:PronounceableText , schema1:LinkRole , schema1:BroadcastService , schema1:CommunicateAction , schema1:Event , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Text , schema1:Language;
        schema1:source          <https://github.com/schemaorg/schemaorg/issues/2382> .

schema1:description  rdf:type   rdf:Property;
        rdfs:comment            "A description of the item.";
        rdfs:label              "description";
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:Text;
        owl:equivalentProperty  dcterms:description .

schema1:creator  rdf:type       rdf:Property;
        rdfs:comment            "The creator/author of this CreativeWork. This is the same as the Author property for CreativeWork.";
        rdfs:label              "creator";
        schema1:domainIncludes  schema1:UserComments , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Person , schema1:Organization .

schema1:contributor  rdf:type   rdf:Property;
        rdfs:comment            "A secondary contributor to the CreativeWork or Event.";
        rdfs:label              "contributor";
        schema1:domainIncludes  schema1:Event , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Person , schema1:Organization .

schema1:url  rdf:type           rdf:Property;
        rdfs:comment            "URL of the item.";
        rdfs:label              "url";
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:URL .

schema1:Dataset  rdf:type    rdfs:Class;
        rdfs:comment         "A body of structured information describing some topic(s) of interest.";
        rdfs:label           "Dataset";
        rdfs:subClassOf      schema1:CreativeWork;
        schema1:source       <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_DatasetClass>;
        owl:equivalentClass  dcat:Dataset , dctype:Dataset , void:Dataset .

nomo:invertedFormOf  rdf:type  owl:ObjectProperty;
        rdfs:comment        "Utilisée seulement pour les termes anglais à mots multiples"@fr , "Used only for multi-word English labels"@en;
        rdfs:domain         skosxl:Label;
        rdfs:isDefinedBy    nomo:;
        rdfs:label          "forme inversée de"@fr , "inverted form of"@en;
        rdfs:range          skosxl:Label;
        rdfs:seeAlso        <https://www.w3.org/TR/skos-reference/#xl-label-relations>;
        rdfs:subPropertyOf  skosxl:labelRelation;
        skos:example        "\"Box, Drink\" est la forme inversée de \"Drink Box\""@fr , "\"Box, Drink\" is the inverted form of \"Drink Box\""@en .

dsn:MoveEvent  rdf:type  owl:Class;
        rdfs:comment     "An event class describing that a particular resource was 'moved' in a dataset or between datasets. This means that all triples having the associated older resource as subject/object were replaced by triples having the target resource as subject/object in the corresponding RDF models. "@en-US;
        rdfs:label       "Move event"@en-US;
        rdfs:subClassOf  dsn:ResourceChangeEvent .

dsn:CreateEvent  rdf:type  owl:Class;
        rdfs:comment     "An event class describing that a particular resource was 'created' in a dataset. This means that one or more triples having the associated resource as subject or object were created in the corresponding RDF model."@en-US;
        rdfs:label       "create event"@en-US;
        rdfs:subClassOf  dsn:ResourceChangeEvent .

dsn:sourceResource  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "The identifier (URI) of a resource that was published under a new URI (i.e., when a MoveEvent occurred)."@en-US;
        rdfs:domain   dsn:MoveEvent;
        rdfs:label    "source resource"@en-US;
        rdfs:range    xsd:anyURI .

dsn:targetResource  rdf:type  owl:DatatypeProperty;
        rdfs:comment  "The identifier (URI) of a resource that was affected by the corresponding event."@en-US;
        rdfs:domain   dsn:ResourceChangeEvent;
        rdfs:label    "target resource"@en-US;
        rdfs:range    xsd:anyURI .

dsn:RemoveEvent  rdf:type  owl:Class;
        rdfs:comment     "An event class describing that a particular resource was 'removed' from a dataset. This means that all triples having the associated resource as subject or object were removed from the corresponding RDF model."@en-US;
        rdfs:label       "Remove event"@en-US;
        rdfs:subClassOf  dsn:ResourceChangeEvent .

cs:addition  rdf:type       owl:ObjectProperty;
        rdfs:comment        "\n      By convention the subject of the triple being added should be the same as the subjectOfChange\n    "@en;
        rdfs:domain         cs:ChangeSet;
        rdfs:isDefinedBy    <http://purl.org/vocab/changeset/schema>;
        rdfs:label          "addition"@en;
        rdfs:range          rdf:Statement;
        rdfs:subPropertyOf  cs:statement;
        dcterms:issued      "2005-12-14";
        skos:changeNote     [ rdf:value        "Added definitition and documentation";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ];
        skos:definition     "a triple to be added to the resource description"@en;
        skos:historyNote    [ rdf:value        "Made owl:ObjectProperty";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ];
        skos:historyNote    [ rdf:value        "Made a sub-property of statement";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ] .

cs:removal  rdf:type        owl:ObjectProperty;
        rdfs:comment        "\n      By convention the subject of the triple being removed should be the same as the subjectOfChange\n    "@en;
        rdfs:domain         cs:ChangeSet;
        rdfs:isDefinedBy    <http://purl.org/vocab/changeset/schema>;
        rdfs:label          "removal"@en;
        rdfs:range          rdf:Statement;
        rdfs:subPropertyOf  cs:statement;
        dcterms:issued      "2005-12-14";
        skos:changeNote     [ rdf:value        "Added definitition and documentation";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ];
        skos:definition     "a triple to be removed from the resource description"@en;
        skos:historyNote    [ rdf:value        "Made a sub-property of statement";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ];
        skos:historyNote    [ rdf:value        "Made owl:ObjectProperty";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ] .

cs:subjectOfChange  rdf:type  owl:ObjectProperty;
        rdfs:domain       cs:ChangeSet;
        rdfs:isDefinedBy  <http://purl.org/vocab/changeset/schema>;
        rdfs:label        "subjectOfChange"@en;
        rdfs:range        rdfs:Resource;
        dcterms:issued    "2005-12-14";
        skos:changeNote   [ rdf:value        "Added definitition and documentation";
                            dcterms:creator  "Ian Davis";
                            dcterms:date     "2006-03-21"
                          ];
        skos:definition   "the resource to which this set of changes applies"@en;
        skos:historyNote  [ rdf:value        "Made owl:ObjectProperty";
                            dcterms:creator  "Ian Davis";
                            dcterms:date     "2006-03-21"
                          ] .

cs:createdDate  rdf:type    owl:DatatypeProperty;
        rdfs:comment        "\n      The date should be in W3CDTF format\n    "@en;
        rdfs:domain         cs:ChangeSet;
        rdfs:isDefinedBy    <http://purl.org/vocab/changeset/schema>;
        rdfs:label          "createdDate"@en;
        rdfs:subPropertyOf  dc:date;
        dcterms:issued      "2005-12-14";
        skos:definition     "the date that the changeset was created"@en;
        skos:historyNote    [ rdf:value        "Made owl:DatatypeProperty";
                              dcterms:creator  "Ian Davis";
                              dcterms:date     "2006-03-21"
                            ] .

dsn:UpdateEvent  rdf:type  owl:Class;
        rdfs:comment     "An event class describing that a particular resource was 'updated' in a dataset. This means that some triples having the associated resource as subject or object were modified/created/removed in the corresponding RDF model."@en-US;
        rdfs:label       "Update event"@en-US;
        rdfs:subClassOf  dsn:ResourceChangeEvent .

cs:ChangeSet  rdf:type    owl:Class;
        rdfs:isDefinedBy  <http://purl.org/vocab/changeset/schema>;
        rdfs:label        "ChangeSet"@en;
        rdfs:subClassOf   [ rdf:type            owl:Class;
                            owl:intersectionOf  ( [ rdf:type            owl:Restriction;
                                                    owl:minCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:statement
                                                  ]
                                                  [ rdf:type            owl:Restriction;
                                                    owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:previousChangeSet
                                                  ]
                                                  [ rdf:type            owl:Restriction;
                                                    owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:subjectOfChange
                                                  ]
                                                  [ rdf:type            owl:Restriction;
                                                    owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:createdDate
                                                  ]
                                                  [ rdf:type            owl:Restriction;
                                                    owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:creatorName
                                                  ]
                                                  [ rdf:type            owl:Restriction;
                                                    owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                                                    owl:onProperty      cs:changeReason
                                                  ]
                                                )
                          ];
        dcterms:issued    "2005-12-14";
        skos:changeNote   [ rdf:value        "Improved documentation";
                            dcterms:creator  "Ian Davis";
                            dcterms:date     "2006-03-21"
                          ];
        skos:definition   "The encapsulation of a delta between two versions of a resource description"@en;
        skos:historyNote  [ rdf:value        "Added property cardinality restrictions";
                            dcterms:creator  "Ian Davis";
                            dcterms:date     "2006-03-21"
                          ] .

nomLang:iu  rdf:type     lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "iu";
        skos:exactMatch  aat:300443664 , <http://id.loc.gov/vocabulary/iso639-1/iu> , wd:Q29921 , <http://lexvo.org/id/iso639-3/iku>;
        skos:inScheme    nomLang:;
        skos:notation    "iu";
        skos:prefLabel   "inuktitut"@fr , "Inuktitut"@en .

nomLang:en-ca  rdf:type  lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "en-ca";
        skos:exactMatch  wd:Q44676;
        skos:inScheme    nomLang:;
        skos:notation    "en-ca";
        skos:prefLabel   "anglais canadien"@fr , "Canadian English"@en .

nomLang:es  rdf:type     lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "es";
        skos:exactMatch  <http://id.loc.gov/vocabulary/iso639-1/es> , <http://lexvo.org/id/iso639-3/spa> , wd:Q1321 , aat:300389311;
        skos:inScheme    nomLang:;
        skos:notation    "es";
        skos:prefLabel   "espagnol"@fr , "Spanish"@en .

nomLang:cr  rdf:type     lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "cr";
        skos:exactMatch  aat:300388182 , <http://id.loc.gov/vocabulary/iso639-1/cr> , wd:Q33390 , <http://lexvo.org/id/iso639-3/cre>;
        skos:inScheme    nomLang:;
        skos:notation    "cr";
        skos:prefLabel   "cri"@fr , "Cree"@en .

nomLang:fr-ca  rdf:type  lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "fr-ca";
        skos:exactMatch  aat:300419445 , wd:Q1450506;
        skos:inScheme    nomLang:;
        skos:notation    "fr-ca";
        skos:prefLabel   "français canadien"@fr , "Canadian French"@en .

nomLevel:1  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  1;
        skos:definition   "Premier niveau de la hiérarchie, contenant le niveau le plus générique du regroupement d’objets par contexte fonctionnel."@fr , "Top level of the Nomenclature hierarchy, containing the broadest level of object grouping by functional context."@en;
        skos:prefLabel    "Catégorie"@fr , "Category"@en .

nomLevel:2  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  2;
        skos:definition   "Deuxième niveau de la hiérarchie de Nomenclature."@fr , "Second level of the Nomenclature hierarchy."@en;
        skos:prefLabel    "Classe"@fr , "Class"@en .

nomLevel:3  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  3;
        skos:definition   "Troisième niveau de la hiérarchie de Nomenclature."@fr , "Third level of the Nomenclature Hierarchy."@en;
        skos:prefLabel    "Subclass"@en , "Sous-classe"@fr .

nomLevel:4  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  4;
        skos:definition   "Quatrième niveau de la hiérarchie de Nomenclature, contenant le nom d’objet le plus générique."@fr , "Fourth level of the Nomenclature Hierarchy, containing the most general object names."@en;
        skos:prefLabel    "Terme primaire"@fr , "Primary Term"@en .

lexinfo:masculine  rdf:type  lexinfo:Gender;
        rdfs:comment  "De, relatif à, ou constituant le genre qui inclut habituellement la plupart des mots ou formes grammaticales se référant aux hommes."@fr , "Of, relating to, or constituting the gender that ordinarily includes most words or grammatical forms referring to males."@en;
        rdfs:label    "masculin"@fr , "masculine"@en .

nomLevel:6  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  6;
        skos:definition   "Sixième niveau de la hiérarchie de Nomenclature."@fr , "Sixth level of the Nomenclature Hierarchy."@en;
        skos:prefLabel    "Terme tertiaire"@fr , "Tertiary Term"@en .

schema1:creditText  rdf:type    rdf:Property;
        rdfs:comment            "Text that can be used to credit person(s) and/or organization(s) associated with a published Creative Work.";
        rdfs:label              "creditText";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:isPartOf        <https://pending.schema.org>;
        schema1:rangeIncludes   schema1:Text;
        schema1:source          <https://github.com/schemaorg/schemaorg/issues/2659> .

schema1:thumbnailUrl  rdf:type  rdf:Property;
        rdfs:comment            "A thumbnail image relevant to the Thing.";
        rdfs:label              "thumbnailUrl";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:rangeIncludes   schema1:URL .

schema1:contentUrl  rdf:type    rdf:Property;
        rdfs:comment            "Actual bytes of the media object, for example the image file or video file.";
        rdfs:label              "contentUrl";
        schema1:domainIncludes  schema1:MediaObject;
        schema1:rangeIncludes   schema1:URL .

schema1:ImageObject  rdf:type  rdfs:Class;
        rdfs:comment         "An image file.";
        rdfs:label           "ImageObject";
        rdfs:subClassOf      schema1:MediaObject;
        owl:equivalentClass  dctype:Image .

schema1:image  rdf:type         rdf:Property;
        rdfs:comment            "An image of the item. This can be a [[URL]] or a fully described [[ImageObject]].";
        rdfs:label              "image";
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:URL , schema1:ImageObject .

schema1:alternateName
        rdf:type                rdf:Property;
        rdfs:comment            "An alias for the item.";
        rdfs:label              "alternateName";
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:Text .

lexinfo:Gender  rdf:type  owl:Class;
        rdfs:label        "gender"@en;
        owl:priorVersion  <http://www.lexinfo.net/ontology/2.0/lexinfo#Gender> .

lexinfo:feminine  rdf:type  lexinfo:Gender;
        rdfs:comment  "De, relatif à, ou constituant le genre qui inclut habituellement la plupart des mots ou formes grammaticales se référant aux femmes."@fr , "Of, relating to, or constituting the gender that ordinarily includes most words or grammatical forms referring to females."@en;
        rdfs:label    "féminin"@fr , "feminine"@en .

schema1:citation  rdf:type      rdf:Property;
        rdfs:comment            "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc.";
        rdfs:label              "citation";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Text , schema1:CreativeWork .

schema1:name  rdf:type          rdf:Property;
        rdfs:comment            "The name of the item.";
        rdfs:label              "name";
        rdfs:subPropertyOf      rdfs:label;
        schema1:domainIncludes  schema1:Thing;
        schema1:rangeIncludes   schema1:Text;
        owl:equivalentProperty  dcterms:title .

nomLang:fr  rdf:type     lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "fr";
        skos:exactMatch  <http://id.loc.gov/vocabulary/iso639-1/fr> , wd:Q150 , <http://lexvo.org/id/iso639-3/fra> , aat:300388306;
        skos:inScheme    nomLang:;
        skos:notation    "fr";
        skos:prefLabel   "français"@fr , "French"@en .

aat:300404672  rdf:type  skos:Concept;
        skos:definition  "Termes à mots multiples qui sont organisés selon la forme utilisée lors de l'indexation à la fin des livres en anglais ou lors de situations similaires. Des exemples sont « Chair, Rocking » et « Dress, Wedding ». Se distingue des termes en ordre naturel."@fr , "Multiple-word terms that are arranged in the form used in back-of-book indexing or other similar situations. Examples are \"Chair, Rocking\" and \"Dress, Wedding\". Distinguished from natural order terms."@en;
        skos:example     "Chair, Barber's"@en;
        skos:prefLabel   "Termes inversés"@fr , "inverted terms"@en;
        skos:scopeNote   "Utilisé seulement pour les termes à mots multiples en anglais."@fr , "Used only for English multi-word terms."@en .

aat:300404671  rdf:type  skos:Concept;
        skos:definition  "Termes à mots multiples qui sont organisés selon la forme utilisée à l'expression orale ou à l'écrit en anglais. Des exemples sont « Rocking Chair » et « Wedding Dress ». Se distingue des termes inversés."@fr , "Multiple-word terms or names that are arranged in the form used in speech or written text. Examples are \"Rocking Chair\" and \"Wedding Dress\". Distinguished from inverted terms."@en;
        skos:example     "Barber's Chair"@en;
        skos:prefLabel   "Termes en ordre naturel"@fr , "natural order terms"@en;
        skos:scopeNote   "Utilisé seulement pour les termes en anglais (pour les unitermes et ceux à mots multiples)."@fr , "Used only for English terms (both single-word and multi-word)"@en .

lingvoj:Lingvo  rdf:type      owl:Class;
        rdfs:comment          "Um idioma utilizado na comunicação oral ou escrita entre pessoas, ou na que se escreve ou grava um recurso. Recomenda-se a utilização das instâncias definidas segundo os códigos ISO 639, como os que aparecem nos excemplos"@pt , "会話または記述による人間のコミュニケーションで使用される言語、または資源が記述または記録される言語。例にあるような、ISO 639コードに基づいて定義されたインスタンスを使用することが推奨される"@ja , "Een taal gebruikt in geschreven of gesproken communicatie tussen mensen of in welke een bron is geschreven of opgenomen. Het is aan te raden instanties te gebruiken gedefinieerd op basis van de ISO 630 codes, zoals in deze voorbeelden"@nl , "Une langue utilisée dans la communication orale ou écrite entre humains, ou dans laquelle une ressource est écrite ou enregistrée. Il est recommandé d'utiliser des instances définies sur la base d'un code ISO 639, comme dans les exemples"@fr , "Una lengua utilizada en la comunicación oral o escrita entre personas, o en la que se escribe o graba un recurso. Se recomienda el uso de las instancias definidas según los códigos ISO 639, como los que aparecen en los ejemplos"@es , "A language used in spoken or written human communication, or in which a resource is written or recorded. It is recommended to use instances defined on the basis of ISO 639 codes, such as those in examples"@en;
        rdfs:label            "语言"@zh , "Sprache"@de , "Language"@en , "Lingvo"@eo , "Lenguaje"@es , "Kieli"@fi , "Langue"@fr , "Linguaggio"@it , "言語"@ja , "Taal"@nl , "Språk"@no , "Jezyk"@pl , "Idioma"@pt , "Язык"@ru , "Språk"@sv , "Dil"@tr;
        rdfs:subClassOf       <http://www.loc.gov/mads/rdf/v1#Language> , dcterms:LinguisticSystem;
        lvont:somewhatSameAs  lvont:Language;
        vann:example          <http://id.loc.gov/vocabulary/iso639-1/ja> , <http://lexvo.org/id/iso639-3/fra>;
        owl:equivalentClass   <http://www.ontotext.com/proton/protontop#Language> , <http://purl.org/linguistics/gold/Language> , <http://d-nb.info/standards/elementset/gnd#Language> , schema1:Language .

nomLang:en  rdf:type     lingvoj:Lingvo , skos:Concept;
        lingvoj:tag      "en";
        skos:exactMatch  <http://id.loc.gov/vocabulary/iso639-1/en> , wd:Q1860 , <http://lexvo.org/id/iso639-3/eng> , aat:300388277;
        skos:inScheme    nomLang:;
        skos:notation    "en";
        skos:prefLabel   "anglais"@fr , "English"@en .

schema1:value  rdf:type         rdf:Property;
        rdfs:comment            "The value of the quantitative value or property value node.\\n\\n* For [[QuantitativeValue]] and [[MonetaryAmount]], the recommended type for values is 'Number'.\\n* For [[PropertyValue]], it can be 'Text;', 'Number', 'Boolean', or 'StructuredValue'.\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.";
        rdfs:label              "value";
        schema1:domainIncludes  schema1:QuantitativeValue , schema1:PropertyValue , schema1:MonetaryAmount;
        schema1:rangeIncludes   schema1:Number , schema1:Boolean , schema1:Text , schema1:StructuredValue;
        schema1:source          <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms> .

schema1:StructuredValue
        rdf:type         rdfs:Class;
        rdfs:comment     "Structured values are used when the value of a property has a more complex structure than simply being a textual value or a reference to another thing.";
        rdfs:label       "StructuredValue";
        rdfs:subClassOf  schema1:Intangible .

schema1:position  rdf:type      rdf:Property;
        rdfs:comment            "The position of an item in a series or sequence of items.";
        rdfs:label              "position";
        schema1:domainIncludes  schema1:ListItem , schema1:CreativeWork;
        schema1:rangeIncludes   schema1:Integer , schema1:Text .

schema1:Collection  rdf:type  rdfs:Class;
        rdfs:comment      "A collection of items e.g. creative works or products.";
        rdfs:label        "Collection";
        rdfs:subClassOf   schema1:CreativeWork;
        schema1:isPartOf  <https://bib.schema.org> .

nomLevel:5  rdf:type      schema1:Collection , skos:Collection;
        rdfs:isDefinedBy  nomo:;
        schema1:position  5;
        skos:definition   "Cinquième niveau de la hiérarchie de Nomenclature."@fr , "Fifth level of the Nomenclature Hierarchy."@en;
        skos:prefLabel    "Terme secondaire"@fr , "Secondary Term"@en .

schema1:isPartOf  rdf:type      rdf:Property;
        rdfs:comment            "Indicates an item or CreativeWork that this item, or CreativeWork (in some sense), is part of.";
        rdfs:label              "isPartOf";
        schema1:domainIncludes  schema1:CreativeWork;
        schema1:inverseOf       schema1:hasPart;
        schema1:rangeIncludes   schema1:URL , schema1:CreativeWork .

schema1:CreativeWork  rdf:type  rdfs:Class;
        rdfs:comment     "The most generic kind of creative work, including books, movies, photographs, software programs, etc.";
        rdfs:label       "CreativeWork";
        rdfs:subClassOf  schema1:Thing;
        schema1:source   <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_rNews> .
