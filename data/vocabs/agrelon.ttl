:hasStepParent
    a rdf:Property, owl:ObjectProperty ;
    rdfs:comment "A person's (subject) biological parent is married with or cohabits with a person (object)."@en ;
    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#> ;
