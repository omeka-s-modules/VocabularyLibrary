    rdfs:subPropertyOf :hasAssociate ;
    vs:term_status "stable" ;
    :correspondsToInverse :HasIsChief .

:isFounderOf
    a rdf:Property, owl:ObjectProperty ;
    rdfs:comment "A person (subject) ist founder of a group (object)."@en ;
    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#> ;
    rdfs:label "es fundador(a) de"@es, "is founder of"@en, "ist Gründer von"@de, "è fondatore o fondatrice di"@it ;
    rdfs:subPropertyOf :hasAssociate ;
    vs:term_status "stable" ;
    :correspondsToInverse :HasIsFounder .

:isMemberOf
