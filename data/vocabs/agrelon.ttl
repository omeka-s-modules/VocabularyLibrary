    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#> ;
    rdfs:label "ha genitore adottivo"@it, "has adoptive parent"@en, "hat Adoptivelternteil"@de, "tiene padre o madre adoptivo(a)"@es ;
    rdfs:subPropertyOf :hasParent ;
    owl:inverseOf :hasAdoptiveChild ;
    vs:term_status "stable" ;
    :correspondsToInverse :HasAdoptiveChildParent .

