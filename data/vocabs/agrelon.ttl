    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#> ;
    rdfs:label "ha fratello adottato o sorella adottata"@it, "has adoptive sibling"@en, "hat Adoptivgeschwister"@de, "tiene hermano(a) adoptivo(a)"@es ;
    rdfs:subPropertyOf :hasSibling ;
